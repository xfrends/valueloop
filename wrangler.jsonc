{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "valueloop",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"vars": {
		"PUBLIC_APP_URL": "https://valueloop.frendi1207.workers.dev",
		"PUBLIC_TURNSTILE_SITE_KEY": "",
		"TURNSTILE_HOSTNAMES": "valueloop.frendi1207.workers.dev",
		"GOOGLE_CLIENT_ID": "",
		"AUTH_EMAIL_FROM": "ValueLoop <no-reply@valueloop.local>",
		"SMTP_HOST": "",
		"SMTP_PORT": "587",
		"SMTP_USERNAME": "",
		"SMTP_FROM": "ValueLoop <no-reply@valueloop.local>",
		"SMTP_SECURE": "starttls",
		"OPENAI_TEXT_MODEL": "gpt-5.2",
		"OPENAI_IMAGE_MODEL": "gpt-image-1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "valueloop",
			"database_id": "157dc095-1c3c-4287-bcc8-8157c30524c0",
			"preview_database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "a6a9c62650ee4e169b964814c2369598",
			"preview_id": "00000000000000000000000000000000"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "valueloop-assets"
		}
	],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ORGANIZATION_REALTIME", "class_name": "OrganizationRealtime" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["OrganizationRealtime"] }
	]
}
