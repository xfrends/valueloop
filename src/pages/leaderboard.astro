---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { getLeaderboardRows } from '../lib/services/analytics';
import { listTeams } from '../lib/services/members';
import DataTable from '../components/DataTable.astro';
import TableToolbar from '../components/TableToolbar.astro';
import TableFilterDialog from '../components/TableFilterDialog.astro';

const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);

const teamId = Astro.url.searchParams.get('teamId') || '';
const fromDate = Astro.url.searchParams.get('fromDate') || '';
const toDate = Astro.url.searchParams.get('toDate') || '';
const query = Astro.url.searchParams.get('query') || '';

const teams = organization && runtime?.env?.DB ? await listTeams(runtime.env.DB, organization.id) : [];
const leaderboardData = organization && runtime?.env?.DB 
  ? await getLeaderboardRows(runtime.env.DB, organization.id, { 
      includeInactive: true, 
      teamId: teamId || undefined, 
      fromDate: fromDate || undefined, 
      toDate: toDate || undefined 
    }) 
  : [];
---

<AppLayout title="Leaderboard - ValueLoop" currentPath="/leaderboard">
  
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Leaderboard</h1>
        <p class="text-slate-500 mt-1 text-sm leading-relaxed">Ranking based on scored challenge sessions.</p>
      </div>
      
      <div class="flex items-center gap-3">
        <TableToolbar action="/leaderboard" searchValue={query} searchPlaceholder="Search member..." submitLabel={null} compact>
          <Fragment slot="filters"><input type="hidden" name="teamId" value={teamId} /><input type="hidden" name="fromDate" value={fromDate} /><input type="hidden" name="toDate" value={toDate} /></Fragment>
        </TableToolbar>
        <button onclick="document.getElementById('leaderboardFilterModal').showModal()" class="btn-interactive flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
          Filters
        </button>
      </div>
    </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <DataTable class="rounded-none border-0 shadow-none" tableClass="">
      <table class="w-full text-left">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm">
          <tr>
            <th class="px-6 py-4 font-medium w-24">Rank</th>
            <th class="px-6 py-4 font-medium">Member</th>
            <th class="px-6 py-4 font-medium text-center">Total Points</th>
            <th class="px-6 py-4 font-medium text-center">Avg Score</th>
            <th class="px-6 py-4 font-medium text-center">Total Answered</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          {leaderboardData.length === 0 ? (
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-sm text-slate-500">
                Belum ada data skor yang ditemukan. Pastikan ada sesi challenge yang telah dinilai atau coba ubah filter yang dipilih.
              </td>
            </tr>
          ) : leaderboardData.map((row, index) => (
            <tr data-leaderboard-row data-search={`${row.full_name} ${row.role}`.toLowerCase()} class="hover:bg-slate-50/70 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <span class={`inline-flex items-center justify-center w-8 h-8 rounded-full font-bold shadow-sm ${
                    index === 0 ? 'bg-[#FFFBEB] text-[#B45309] border border-[#FEF3C7] shadow-sm' : 
                    index === 1 ? 'bg-[#F8FAFC] text-[#475569] border border-[#E2E8F0] shadow-sm' : 
                    index === 2 ? 'bg-[#FFF7ED] text-[#C2410C] border border-[#FFEDD5] shadow-sm' : 
                    'bg-white text-slate-500 border border-slate-200'
                  }`}>
                    {index + 1}
                  </span>
                </div>
              </td>
              <td class="px-6 py-4">
                <div class="font-bold text-slate-900 group-hover:text-indigo-800 transition-colors">{row.full_name}</div>
                <div class="text-slate-500 text-xs mt-0.5">{row.role}</div>
              </td>
              <td class="px-6 py-4">
                <div class="flex justify-center">
                  <span class="inline-flex px-3 py-1 bg-slate-100 text-slate-800 rounded-md font-bold text-base">
                    {row.total_points}
                  </span>
                </div>
              </td>
              <td class="px-6 py-4 text-center font-medium text-slate-700">{row.average_score ?? '-'}</td>
              <td class="px-6 py-4 text-center text-slate-500">{row.total_answered}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </DataTable>
    </div>
    
    <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
      <p class="text-sm text-slate-500">Showing top {leaderboardData.length} members</p>
      <div class="flex gap-2">
        <button class="px-3 py-1 rounded bg-white border border-slate-300 text-slate-500 text-sm font-medium shadow-sm hover:bg-slate-50 disabled:opacity-50" disabled>Prev</button>
        <button class="px-3 py-1 rounded bg-white border border-slate-300 text-slate-700 text-sm font-medium shadow-sm hover:bg-slate-50 disabled:opacity-50" disabled>Next</button>
      </div>
    </div>
  </div>

  <TableFilterDialog id="leaderboardFilterModal" bare>
    <form method="get" class="bg-white p-6">
      <input type="hidden" name="query" value={query} />
      <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
        <h2 class="font-bold text-slate-900 text-lg">Filter Leaderboard</h2>
        <div class="flex items-center gap-2">
          <a href="/leaderboard" title="Reset Filters" class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">Reset</a>
          <button type="submit" title="Terapkan Filter" class="btn-interactive px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm">Filter</button>
          <button type="button" onclick="document.getElementById('leaderboardFilterModal').close()" title="Tutup" class="p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 rounded-lg transition-colors ml-1">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      </div>
      
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700">Dari Tanggal</label>
            <input type="date" name="fromDate" value={fromDate} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700">Sampai Tanggal</label>
            <input type="date" name="toDate" value={toDate} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700">Team</label>
          <select name="teamId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
            <option value="">Semua Team</option>
            {teams.map((t) => (
              <option value={t.id} selected={t.id === teamId}>{t.name}</option>
            ))}
          </select>
        </div>
      </div>
    </form>
  </TableFilterDialog>

  </div>
</AppLayout>

<script is:inline>
  const leaderboardSearch = document.querySelector('[data-leaderboard-row]')?.closest('main')?.querySelector('input[name="query"]');
  leaderboardSearch?.addEventListener('input', () => { const q = leaderboardSearch.value.toLowerCase(); document.querySelectorAll('[data-leaderboard-row]').forEach((row) => row.classList.toggle('hidden', q && !row.dataset.search.includes(q))); });
</script>
