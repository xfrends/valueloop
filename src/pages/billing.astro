---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { canManageBilling } from '../lib/permissions';
import { getActiveMemberCount, getOrganizationPlanSummary, listPlanCatalog } from '../lib/services/shared';

const organization = Astro.locals.organization;
const membership = Astro.locals.membership;
const runtime = getCloudflareRuntime(Astro);
const allowed = canManageBilling(membership?.role);
const plan = organization && runtime?.env?.DB ? await getOrganizationPlanSummary(runtime.env.DB, organization.id) : null;
const activeMembers = organization && runtime?.env?.DB ? await getActiveMemberCount(runtime.env.DB, organization.id) : 0;
const maxMembers = Number(plan?.limits.maxMembers ?? 0);
const planCatalog = allowed && runtime?.env?.DB ? await listPlanCatalog(runtime.env.DB) : [];
---

<AppLayout title="Billing - ValueLoop" currentPath="/billing">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">Plan</h1>
    <p class="text-slate-500 mt-1">Free adalah satu-satunya plan yang tersedia saat ini. Plan lainnya sedang dipersiapkan.</p>
  </div>

  {!allowed ? (
    <div class="rounded-2xl border border-red-100 bg-red-50 p-6 text-red-700">Anda tidak memiliki izin untuk melihat plan organisasi.</div>
  ) : (
    <div class="space-y-8">
      <div class="flex flex-col gap-6">
        <div class="w-full bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-medium text-slate-500">Current Plan</p>
            <h2 class="mt-1 text-3xl font-bold text-slate-900">{plan?.plan_name ?? 'Free'}</h2>
            <p class="mt-2 text-slate-500">Status: Active</p>
          </div>
          <span class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-800">Active</span>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-slate-200 p-4">
            <p class="text-sm text-slate-500">Members</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">{activeMembers}{maxMembers ? ` / ${maxMembers}` : ''}</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-4">
            <p class="text-sm text-slate-500">Active Values</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">{plan?.limits.maxActiveValues ?? '-'}</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-4">
            <p class="text-sm text-slate-500">Monthly Challenges</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">{plan?.limits.maxChallengesPerMonth ?? '-'}</p>
          </div>
        </div>
        </div>
      </div>

      <section>
        <div class="mb-4">
          <h2 class="text-lg font-bold text-slate-900">Semua Plan</h2>
          <p class="mt-1 text-sm text-slate-500">Plan Coming Soon tetap ditampilkan sebagai preview dan belum dapat dipilih.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {planCatalog.map((catalogPlan) => {
            const isCurrent = catalogPlan.code === plan?.plan_code;
            return (
              <article class={`relative overflow-hidden rounded-2xl border bg-white p-6 shadow-sm ${catalogPlan.available ? 'border-indigo-200' : 'border-slate-200'}`}>
                {!catalogPlan.available && <div class="absolute inset-0 bg-slate-50/35 pointer-events-none"></div>}
                <div class="relative flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-bold text-slate-900">{catalogPlan.name}</h3>
                    <p class="mt-1 text-sm text-slate-500">{catalogPlan.code}</p>
                  </div>
                  <span class={`rounded-full px-3 py-1 text-xs font-bold ${catalogPlan.available ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}`}>
                    {catalogPlan.available ? 'Available' : 'Coming Soon'}
                  </span>
                </div>
                <div class="relative mt-6 grid grid-cols-3 gap-2 text-center">
                  <div class="rounded-lg bg-slate-50 px-2 py-3"><p class="text-lg font-bold text-slate-900">{catalogPlan.limits.maxMembers ?? '-'}</p><p class="text-[11px] text-slate-500">Members</p></div>
                  <div class="rounded-lg bg-slate-50 px-2 py-3"><p class="text-lg font-bold text-slate-900">{catalogPlan.limits.maxActiveValues ?? '-'}</p><p class="text-[11px] text-slate-500">Values</p></div>
                  <div class="rounded-lg bg-slate-50 px-2 py-3"><p class="text-lg font-bold text-slate-900">{catalogPlan.limits.maxChallengesPerMonth ?? '-'}</p><p class="text-[11px] text-slate-500">Challenges</p></div>
                </div>
                <button type="button" disabled class={`relative mt-6 w-full cursor-not-allowed rounded-lg px-4 py-2.5 text-sm font-semibold ${isCurrent ? 'bg-indigo-50 text-indigo-800' : 'bg-slate-100 text-slate-500'}`}>
                  {isCurrent ? 'Plan Saat Ini' : catalogPlan.available ? 'Tersedia Gratis' : 'Coming Soon'}
                </button>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  )}
</AppLayout>
