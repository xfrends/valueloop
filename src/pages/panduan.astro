---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<BaseLayout
  title="Panduan Budaya Kerja - ValueLoop"
  description="Pelajari panduan lengkap langkah demi langkah untuk membangun dan mempertahankan budaya kerja yang positif di perusahaan Anda."
>
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  
    <PublicHeader />
  
  <main class="relative z-10 overflow-hidden">
    <!-- Hero -->
    <section class="py-24 md:py-32">
      <div class="mx-auto w-full max-w-4xl px-6 flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50/50 px-4 py-1.5 text-sm font-medium text-indigo-900 mb-8 shadow-sm backdrop-blur-sm hero-animate">
          Buku Panduan
        </div>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1] mb-6 hero-animate-delay-1">
          Cara Membangun <span class="text-indigo-600">Budaya Kerja yang Hidup</span>
        </h1>
        <p class="text-xl leading-relaxed text-slate-600 hero-animate-delay-2">
          Budaya kerja bukan sekadar slogan yang dipajang di dinding kantor. Ia adalah sekumpulan kebiasaan, perilaku, dan cara tim Anda mengambil keputusan setiap hari.
        </p>
      </div>
    </section>

    <!-- Langkah-Langkah -->
    <section class="py-20 bg-white border-y border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">4 Langkah Mewujudkan Core Value</h2>
          <p class="text-slate-600">Dari konsep hingga praktik nyata di lapangan.</p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Card 1 -->
          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal stagger-1">
            <div class="text-4xl font-black text-indigo-100 mb-6 group-hover:text-indigo-500 transition-colors">01</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Definisikan Nilai</h3>
            <p class="text-slate-600 leading-relaxed">Pilih 3-5 core value yang benar-benar mendeskripsikan cara kerja ideal tim Anda. Hindari kata-kata generik.</p>
          </div>
          <!-- Card 2 -->
          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal stagger-2">
            <div class="text-4xl font-black text-indigo-100 mb-6 group-hover:text-indigo-500 transition-colors">02</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Terjemahkan ke Perilaku</h3>
            <p class="text-slate-600 leading-relaxed">Berikan contoh spesifik mengenai perilaku yang diharapkan (Do's) dan perilaku yang harus dihindari (Don'ts).</p>
          </div>
          <!-- Card 3 -->
          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal stagger-3">
            <div class="text-4xl font-black text-indigo-100 mb-6 group-hover:text-indigo-500 transition-colors">03</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Jadikan Rutinitas</h3>
            <p class="text-slate-600 leading-relaxed">Bahas value tersebut secara berkala. Gunakan tantangan atau pertanyaan harian agar anggota tim dapat merenungkannya.</p>
          </div>
          <!-- Card 4 -->
          <div class="bg-slate-50 p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal stagger-4">
            <div class="text-4xl font-black text-indigo-100 mb-6 group-hover:text-indigo-500 transition-colors">04</div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">Apresiasi & Evaluasi</h3>
            <p class="text-slate-600 leading-relaxed">Berikan skor, pengakuan, dan feedback yang jelas saat ada staf yang mendemonstrasikan core value tersebut dengan baik.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Kesalahan Umum -->
    <section class="py-24 bg-slate-50/80">
      <div class="mx-auto w-full max-w-5xl px-6">
        <h2 class="text-3xl font-bold text-slate-900 mb-12 text-center reveal">Kesalahan Umum dalam Implementasi</h2>
        <div class="space-y-6">
          <div class="flex flex-col md:flex-row gap-6 items-start bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm reveal stagger-1">
            <div class="w-12 h-12 shrink-0 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Terlalu Banyak Aturan</h3>
              <p class="text-slate-600">Punya lebih dari 7 core value seringkali membuat karyawan sulit mengingatnya, apalagi mempraktikkannya. Fokus pada yang paling kritikal.</p>
            </div>
          </div>
          <div class="flex flex-col md:flex-row gap-6 items-start bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm reveal stagger-2">
            <div class="w-12 h-12 shrink-0 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Hanya Evaluasi Tahunan</h3>
              <p class="text-slate-600">Menjadikan culture fit hanya sebagai komponen penilaian tahunan tanpa adanya teguran atau apresiasi di keseharian membuat proses terasa formalitas.</p>
            </div>
          </div>
          <div class="flex flex-col md:flex-row gap-6 items-start bg-white p-6 md:p-8 rounded-[2rem] border border-slate-200 shadow-sm reveal stagger-3">
            <div class="w-12 h-12 shrink-0 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Kurangnya Teladan dari Pemimpin</h3>
              <p class="text-slate-600">Budaya mengalir dari atas ke bawah. Jika pemimpin tidak mencerminkan value tersebut, tim akan menyadari ketidakselarasan ini dengan cepat.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ValueLoop Solusi -->
    <section class="py-24 mt-12">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="bg-slate-900 text-white rounded-2xl py-20 px-6 md:px-16 overflow-hidden relative shadow-2xl">
          <div class="absolute inset-0 opacity-20 bg-transparent"></div>
          <div class="mx-auto w-full max-w-4xl text-center relative z-10 reveal">
            <h2 class="text-3xl md:text-5xl font-bold mb-8">Solusi Otomatisasi dengan ValueLoop</h2>
            <p class="text-xl text-slate-300 mb-12">
              Kami mendesain ValueLoop agar Anda tidak perlu lagi melakukan review secara manual dan repot mengingatkan staf satu per satu. Dengan challenge acak, AI yang relevan, dan leaderboard yang seru, budaya kerja Anda akan terbangun secara organik.
            </p>
            <a class="inline-block btn-shimmer rounded-full bg-white px-10 py-5 text-lg font-semibold text-slate-900 shadow-2xl hover:bg-indigo-50 hover:-translate-y-1 transition-all active:translate-y-0" href="/signup">
              Mulai Percobaan Gratis
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <PublicFooter />

  <script>
    function initRevealAnimations() {
      const revealSelectors = '.reveal, .reveal-scale, .reveal-left, .reveal-right';
      const elements = document.querySelectorAll(revealSelectors);
      if (!elements.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elements.forEach(el => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
      elements.forEach((el) => observer.observe(el));
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRevealAnimations);
    } else {
      initRevealAnimations();
    }
    document.addEventListener('astro:after-swap', initRevealAnimations);
  </script>
</BaseLayout>
