---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { getDashboardSummary } from '../lib/services/analytics';
import { formatOrgDateTime } from '../lib/utils/date';
import DataTable from '../components/DataTable.astro';

const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const dashboard = organization && runtime?.env?.DB ? await getDashboardSummary(runtime.env.DB, organization.id) : null;
const todayChallenge = dashboard?.todayChallenge as { sequence_no: number; member_name: string; created_at: string } | null;
const todayChallengeHeadline = todayChallenge ? `Challenge #${todayChallenge.sequence_no}` : 'Time for a culture check-in!';
const todayChallengeSubtitle = todayChallenge
  ? `Selected member: ${todayChallenge.member_name} • ${formatOrgDateTime(new Date(todayChallenge.created_at), organization?.timezone || 'Asia/Jakarta')}`
  : 'Gather your team, it\'s time to review our core values.';
const stats = dashboard
  ? [
      { label: 'Active Members', value: String(dashboard.stats?.active_members ?? 0), trend: 'Aktif bulan ini' },
      { label: 'Challenges Completed', value: String(dashboard.stats?.challenges_this_month ?? 0), trend: 'Bulan berjalan' },
      {
        label: 'Avg Organization Score',
        value: String(dashboard.stats?.average_score_this_month ?? 0),
        trend: 'Rata-rata bulan ini',
      },
    ]
  : [];

const topMembers = (dashboard?.leaderboard ?? []) as Array<{ full_name: string; role: string; total_points: number; average_score: number | null }>;
const valueDistribution = (dashboard?.valueDistribution ?? []) as Array<{ name: string; total: number | string }>;
---

<AppLayout title="Dashboard - ValueLoop" currentPath="/dashboard">
  {organization ? (
    <>
  
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
    <p class="text-slate-500 mt-1">Overview of your organization's culture metrics.</p>
  </div>

  <!-- Today's Challenge Banner -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 md:p-8 text-white shadow-xl mb-8 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
    <!-- Subtle overlay grid/pattern inside banner -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff0a_1px,transparent_1px),linear-gradient(to_bottom,#ffffff0a_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
    
    <div class="relative z-10">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10 border border-white/10 text-white text-xs font-medium mb-3 backdrop-blur-sm shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Today's Challenge is Ready
      </div>
      <h2 class="text-xl md:text-2xl font-bold mb-1">{todayChallengeHeadline}</h2>
      <p class="text-indigo-100/80">{todayChallengeSubtitle}</p>
    </div>
    <a href="/challenge" class="btn-interactive shrink-0 bg-white text-slate-900 px-6 py-3 rounded-xl font-bold shadow-sm hover:bg-slate-50 transition-colors">
      Start Challenge &rarr;
    </a>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    {stats.map((stat) => (
      <div class="interactive-card bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
        <p class="text-sm font-medium text-slate-500 mb-1">{stat.label}</p>
        <div class="flex items-end gap-3">
          <p class="text-3xl font-bold text-slate-900 tracking-tight">{stat.value}</p>
          <span class="text-xs font-medium text-emerald-700 bg-emerald-50 border border-emerald-100/50 px-2 py-0.5 rounded-md mb-1">
            {stat.trend}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Top Members Leaderboard -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-900">Top Members This Month</h3>
        <a href="/leaderboard" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 hover:underline underline-offset-4">View all &rarr;</a>
      </div>
      <div class="overflow-x-auto">
        <DataTable class="rounded-none border-0 shadow-none" tableClass="">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50/80 text-slate-500 border-b border-slate-100">
            <tr>
              <th class="px-6 py-3 font-semibold">Rank</th>
              <th class="px-6 py-3 font-semibold">Member</th>
              <th class="px-6 py-3 font-semibold">Total Points</th>
              <th class="px-6 py-3 font-semibold text-right">Avg Score</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {topMembers.map((member, index) => (
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold shadow-sm ${
                    index === 0 ? 'bg-[#FFFBEB] text-[#B45309] border border-[#FEF3C7]' : 
                    index === 1 ? 'bg-[#F8FAFC] text-[#475569] border border-[#E2E8F0]' : 
                    index === 2 ? 'bg-[#FFF7ED] text-[#C2410C] border border-[#FFEDD5]' : 
                    'bg-white text-slate-500 border border-slate-200'
                  }`}>
                    {index + 1}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <div class="font-bold text-slate-900">{member.full_name}</div>
                  <div class="text-slate-500 text-xs font-medium mt-0.5">{member.role}</div>
                </td>
                <td class="px-6 py-4 font-bold text-indigo-700">{member.total_points}</td>
                <td class="px-6 py-4 text-right font-bold text-slate-900">{member.average_score ?? '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </DataTable>
      </div>
    </div>

    <!-- Value Distribution Widget -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col">
      <h3 class="font-bold text-slate-900 mb-6">Value Focus (Last 30 Days)</h3>
      
      <div class="flex-1 flex flex-col justify-center gap-5">
        {valueDistribution.length ? valueDistribution.map((value) => (
          <div>
            <div class="flex justify-between text-sm mb-1.5">
              <span class="font-semibold text-slate-700">{value.name}</span>
              <span class="text-slate-500 font-medium">{value.total}</span>
            </div>
            <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-indigo-500 rounded-full" style={`width: ${Math.max(10, Number(value.total) * 10)}%`}></div>
            </div>
          </div>
        )) : (
          <p class="text-sm text-slate-500">Belum ada data challenge bulan ini.</p>
        )}
      </div>
    </div>
  </div>
    </>
  ) : (
    <section class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 shadow-sm">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-800">Dashboard</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Belum ada organisasi</h1>
        <p class="mt-3 text-slate-600">
          Dashboard tetap bisa dibuka. Buat organisasi pertama untuk mulai menambahkan core values, anggota, dan challenge.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/onboarding" class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
            Buat organisasi
          </a>
          <a href="/settings" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
            Lihat settings
          </a>
        </div>
      </div>
    </section>
  )}
</AppLayout>
