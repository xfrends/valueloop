---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<BaseLayout
  title="Studi Kasus - ValueLoop"
  description="Kisah sukses implementasi budaya kerja yang efektif dengan bantuan ValueLoop."
>
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  
    <PublicHeader />
  
  <main class="relative z-10 overflow-hidden">
    <!-- Hero -->
    <section class="py-24 md:py-32">
      <div class="mx-auto w-full max-w-7xl px-6 flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/50 px-4 py-1.5 text-sm font-medium text-blue-900 mb-8 shadow-sm backdrop-blur-sm hero-animate">
          Studi Kasus
        </div>
        <h1 class="max-w-5xl text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1] mb-6 hero-animate-delay-1">
          Kisah Sukses <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-teal-500">Membangun Budaya</span>
        </h1>
        <p class="max-w-2xl text-xl leading-relaxed text-slate-600 hero-animate-delay-2">
          Lihat bagaimana berbagai perusahaan memanfaatkan ValueLoop untuk menanamkan core value mereka dalam rutinitas keseharian tim.
        </p>
      </div>
    </section>

    <section class="py-24 bg-slate-50/80 border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6 space-y-16">
        
        <!-- Case 1 -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden reveal">
          <div class="grid md:grid-cols-2">
            <div class="bg-slate-900 p-10 md:p-12 flex flex-col justify-center relative overflow-hidden">
              <div class="absolute inset-0 opacity-20 bg-transparent"></div>
              <div class="relative z-10">
                <div class="bg-blue-500/20 text-blue-300 text-sm font-bold uppercase tracking-wider px-4 py-1.5 rounded-full inline-block mb-6 backdrop-blur-sm">Tech Startup</div>
                <h2 class="text-3xl font-bold text-white mb-4">Nusantara Tech</h2>
                <p class="text-slate-300 text-lg">Mengatasi keterputusan budaya di tim remote yang tersebar di 5 kota.</p>
              </div>
            </div>
            <div class="p-10 md:p-12">
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Tantangan</h3>
                <p class="text-slate-700">Dengan model kerja remote penuh, staf merasa terputus dari nilai-nilai perusahaan. Turnover meningkat dan koordinasi menurun.</p>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-blue-700 tracking-wider mb-2">Solusi ValueLoop</h3>
                <p class="text-slate-700">Mengimplementasikan "Value Check-in" 10 menit setiap pagi menggunakan pertanyaan yang di-generate AI ValueLoop mengenai core value "Ownership" dan "Collaboration".</p>
              </div>
              <div>
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Hasil</h3>
                <div class="flex items-end gap-3">
                  <span class="text-4xl font-extrabold text-blue-500">+45%</span>
                  <span class="text-slate-600 mb-1 font-medium">Keterlibatan Karyawan</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Case 2 -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden reveal">
          <div class="grid md:grid-cols-2">
            <div class="p-10 md:p-12 order-2 md:order-1">
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Tantangan</h3>
                <p class="text-slate-700">Proses evaluasi tahunan tidak memberikan feedback yang cukup cepat untuk industri kreatif yang sangat dinamis.</p>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-blue-700 tracking-wider mb-2">Solusi ValueLoop</h3>
                <p class="text-slate-700">Setiap proyek selesai, manajer proyek langsung memasukkan jawaban tim terkait core value "Innovation" dan memberikan skor secara live, menampilkannya di Leaderboard agensi.</p>
              </div>
              <div>
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Hasil</h3>
                <div class="flex items-end gap-3">
                  <span class="text-4xl font-extrabold text-blue-500">3x</span>
                  <span class="text-slate-600 mb-1 font-medium">Lebih Cepat Iterasi Feedback</span>
                </div>
              </div>
            </div>
            <div class="bg-slate-900 p-10 md:p-12 flex flex-col justify-center relative overflow-hidden order-1 md:order-2">
              <div class="absolute inset-0 opacity-20 bg-transparent"></div>
              <div class="relative z-10">
                <div class="bg-amber-500/20 text-amber-300 text-sm font-bold uppercase tracking-wider px-4 py-1.5 rounded-full inline-block mb-6 backdrop-blur-sm">Creative Agency</div>
                <h2 class="text-3xl font-bold text-white mb-4">Kreatif Studio</h2>
                <p class="text-slate-300 text-lg">Mengubah sistem evaluasi tahunan menjadi feedback instan berorientasi penghargaan.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Case 3 -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden reveal">
          <div class="grid md:grid-cols-2">
            <div class="bg-slate-900 p-10 md:p-12 flex flex-col justify-center relative overflow-hidden">
              <div class="absolute inset-0 opacity-20 bg-transparent"></div>
              <div class="relative z-10">
                <div class="bg-teal-500/20 text-teal-300 text-sm font-bold uppercase tracking-wider px-4 py-1.5 rounded-full inline-block mb-6 backdrop-blur-sm">Financial Services</div>
                <h2 class="text-3xl font-bold text-white mb-4">Bina Finance</h2>
                <p class="text-slate-300 text-lg">Meningkatkan kepatuhan budaya integritas di tengah tim penjualan.</p>
              </div>
            </div>
            <div class="p-10 md:p-12">
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Tantangan</h3>
                <p class="text-slate-700">Tingginya risiko pelanggaran integritas karena staf lapangan kekurangan panduan praktis dan tekanan target tinggi.</p>
              </div>
              <div class="mb-6">
                <h3 class="text-sm font-bold uppercase text-blue-700 tracking-wider mb-2">Solusi ValueLoop</h3>
                <p class="text-slate-700">Menggunakan kustomisasi nilai "Integritas & Kepercayaan" dengan pertanyaan skenario di ValueLoop. Setiap staf harus menceritakan contoh konkrit mereka menangani nasabah dengan benar setiap pekannya.</p>
              </div>
              <div>
                <h3 class="text-sm font-bold uppercase text-slate-400 tracking-wider mb-2">Hasil</h3>
                <div class="flex items-end gap-3">
                  <span class="text-4xl font-extrabold text-blue-500">98%</span>
                  <span class="text-slate-600 mb-1 font-medium">Skor Kesadaran Integritas</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="py-32 text-center bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="max-w-3xl mx-auto reveal">
        <h2 class="text-4xl font-bold text-slate-900 mb-6">Siap Menulis Kisah Sukses Perusahaan Anda?</h2>
        <p class="text-xl text-slate-600 mb-10">
          Bergabunglah dengan ratusan perusahaan yang telah mengubah cara mereka mempraktikkan budaya kerja.
        </p>
        <a class="btn-shimmer inline-block rounded-full bg-slate-900 px-10 py-4 font-semibold text-white shadow-xl hover:bg-blue-800 hover:-translate-y-1 transition-all" href="/signup">
          Coba ValueLoop Sekarang
        </a>
        </div>
      </div>
    </section>

  </main>

  <PublicFooter />

  <script>
    function initRevealAnimations() {
      const revealSelectors = '.reveal, .reveal-scale, .reveal-left, .reveal-right';
      const elements = document.querySelectorAll(revealSelectors);
      if (!elements.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elements.forEach(el => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
      elements.forEach((el) => observer.observe(el));
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRevealAnimations);
    } else {
      initRevealAnimations();
    }
    document.addEventListener('astro:after-swap', initRevealAnimations);
  </script>
</BaseLayout>
