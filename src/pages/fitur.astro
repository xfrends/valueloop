---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';

const features = [
  { id: 'values', number: '01', eyebrow: 'Fondasi', title: 'Core values yang benar-benar milik tim', text: 'Mulai dari bahasa yang sudah dipahami tim. Susun value, definisi, dan contoh perilaku yang ingin diperkuat dalam pekerjaan sehari-hari.', points: ['Buat value sesuai identitas organisasi', 'Tambahkan perilaku yang bisa diamati', 'Kelola value dan pertanyaan dalam satu tempat'], color: 'indigo', visual: 'Core values', visualText: 'Ownership', stat: '5 values aktif' },
  { id: 'challenge', number: '02', eyebrow: 'Ritual', title: 'Challenge harian yang kontekstual', text: 'Ubah value menjadi pertanyaan praktis yang mengundang refleksi dari pengalaman kerja nyata, bukan sekadar hafalan teori.', points: ['Pertanyaan berbasis skenario kerja', 'Rotasi peserta dan value lebih adil', 'Sesi ringan untuk meeting tim'], color: 'emerald', visual: 'Daily challenge', visualText: 'Apa satu hal yang kamu selesaikan sebelum diminta?', stat: '1 dari 3 pertanyaan' },
  { id: 'scoring', number: '03', eyebrow: 'Feedback', title: 'Scoring berbasis contoh nyata', text: 'Facilitator atau admin memberi skor 0–10 dengan konteks yang jelas. Skor menjadi titik awal percakapan, bukan penilaian yang berdiri sendiri.', points: ['Nilai kejelasan dan relevansi jawaban', 'Tambahkan feedback untuk perbaikan', 'Simpan hasil scoring di history'], color: 'amber', visual: 'Review jawaban', visualText: 'Rian · Support', stat: '9 / 10' },
  { id: 'leaderboard', number: '04', eyebrow: 'Momentum', title: 'Leaderboard yang membangun momentum', text: 'Buat kontribusi yang konsisten terlihat oleh tim. Gunakan leaderboard untuk apresiasi dan percakapan, bukan kompetisi kosong.', points: ['Pantau skor dan partisipasi anggota', 'Berikan apresiasi atas kebiasaan baik', 'Tampilkan perkembangan secara ringan'], color: 'rose', visual: 'Leaderboard · Maret', visualText: 'Sari · Product', stat: '#01  9,4' },
  { id: 'history', number: '05', eyebrow: 'Rekam jejak', title: 'History untuk melihat perkembangan', text: 'Semua sesi, jawaban, dan scoring tersimpan sebagai rekam jejak. Kembali ke contoh nyata ketika tim melakukan refleksi.', points: ['Telusuri sesi dan jawaban sebelumnya', 'Lihat riwayat skor per anggota', 'Gunakan data untuk refleksi rutin'], color: 'sky', visual: 'History sesi', visualText: 'Customer Obsession', stat: '18 sesi tersimpan' },
  { id: 'insights', number: '06', eyebrow: 'Kejelasan', title: 'Insights untuk keputusan yang lebih baik', text: 'Lihat pola partisipasi dan skor agar pemimpin tahu value mana yang sudah hidup dan mana yang perlu mendapat ruang percakapan.', points: ['Bandingkan tren antarperiode', 'Temukan value dengan partisipasi rendah', 'Bawa temuan ke diskusi berikutnya'], color: 'violet', visual: 'Team insights', visualText: 'Ownership', stat: '+12% bulan ini' },
];

const colorClasses = {
  indigo: { soft: 'bg-indigo-50', text: 'text-indigo-700', line: 'bg-indigo-600', border: 'border-indigo-100' },
  emerald: { soft: 'bg-emerald-50', text: 'text-emerald-700', line: 'bg-emerald-500', border: 'border-emerald-100' },
  amber: { soft: 'bg-amber-50', text: 'text-amber-700', line: 'bg-amber-500', border: 'border-amber-100' },
  rose: { soft: 'bg-rose-50', text: 'text-rose-700', line: 'bg-rose-500', border: 'border-rose-100' },
  sky: { soft: 'bg-sky-50', text: 'text-sky-700', line: 'bg-sky-500', border: 'border-sky-100' },
  violet: { soft: 'bg-violet-50', text: 'text-violet-700', line: 'bg-violet-600', border: 'border-violet-100' },
};
---

<BaseLayout title="Fitur ValueLoop - Hidupkan Value dalam Rutinitas Tim" description="Jelajahi enam fitur ValueLoop untuk menjalankan challenge, scoring, leaderboard, history, dan insight budaya kerja.">
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none"><div class="absolute inset-0 bg-[linear-gradient(to_right,#94a3b80d_1px,transparent_1px),linear-gradient(to_bottom,#94a3b80d_1px,transparent_1px)] bg-[size:32px_32px]"></div><div class="absolute right-0 top-0 h-[520px] w-[520px] rounded-full bg-indigo-100/40 blur-3xl"></div></div>
  <PublicHeader />
  <main class="public-main relative z-10 overflow-hidden">
    <section class="public-hero px-6 pb-20 pt-20 md:pb-28 md:pt-28"><div class="mx-auto grid max-w-7xl items-end gap-12 lg:grid-cols-[1fr_0.8fr]"><div class="hero-animate"><div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-4 py-1.5 text-sm font-semibold text-indigo-800 shadow-sm"><span class="h-2 w-2 rounded-full bg-indigo-600"></span>Fitur ValueLoop</div><h1 class="public-title hero-animate-delay-1 mt-7 max-w-3xl text-5xl font-extrabold leading-[1.04] sm:text-7xl">Satu alur untuk membuat value <span class="text-indigo-600">terasa nyata.</span></h1><p class="public-lead hero-animate-delay-2 mt-7 max-w-2xl text-lg leading-relaxed">Dari fondasi organisasi sampai insight tim. ValueLoop membantu kebiasaan baik muncul, dibicarakan, dan berkembang.</p><div class="hero-animate-delay-3 mt-9 flex flex-wrap gap-4"><a href="/signup" class="public-primary btn-shimmer btn-interactive px-7 py-3.5 font-semibold text-white">Mulai dengan ValueLoop <span aria-hidden="true">→</span></a><a href="/preview" class="public-secondary btn-interactive border px-7 py-3.5 font-semibold text-slate-700">Lihat preview</a></div></div><div class="hero-animate-delay-4 rounded-[2rem] border border-slate-200 bg-white p-4 shadow-xl shadow-slate-900/5 sm:p-5"><div class="rounded-[1.5rem] bg-slate-950 p-5 text-white sm:p-7"><div class="flex items-center justify-between text-xs text-slate-400"><span>VALUELOOP / WORKSPACE</span><span class="rounded-full bg-emerald-400/10 px-2.5 py-1 font-semibold text-emerald-300">Live ritual</span></div><p class="mt-12 text-sm text-slate-400">Minggu ini</p><p class="mt-2 text-4xl font-bold tracking-tight">4 dari 5</p><p class="mt-1 text-sm text-slate-400">challenge selesai bersama tim</p><div class="mt-7 h-2 rounded-full bg-white/10"><div class="h-2 w-4/5 rounded-full bg-indigo-400"></div></div><div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4 text-xs"><span class="text-slate-400">Skor rata-rata</span><span class="font-bold text-emerald-300">8,4  ↑ 12%</span></div></div></div></div></section>

    <section class="border-y border-slate-200 bg-slate-50/70 px-6 py-7"><div class="mx-auto max-w-7xl"><div class="flex flex-wrap items-center justify-between gap-5"><p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">Eksplorasi fitur</p><nav aria-label="Navigasi fitur" class="flex flex-wrap items-center gap-2">{features.map((feature) => <a href={`#${feature.id}`} class="group inline-flex items-center gap-2 rounded-full border border-transparent px-3 py-2 text-sm font-semibold text-slate-500 transition-colors hover:border-slate-200 hover:bg-white hover:text-slate-900"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-white text-[11px] font-bold text-slate-400 shadow-sm transition-colors group-hover:bg-indigo-600 group-hover:text-white">{feature.number}</span><span>{feature.eyebrow}</span></a>)}</nav></div></div></section>

    <div>{features.map((feature, index) => { const palette = colorClasses[feature.color as keyof typeof colorClasses]; return <section id={feature.id} class={`border-b border-slate-200 px-6 py-20 md:py-28 ${index % 2 ? 'bg-slate-50/80' : 'bg-white'}`}><div class={`mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-24 ${index % 2 ? 'lg:[&>div:first-child]:order-2' : ''}`}><div class="reveal-left"><div class="flex items-center gap-3"><span class={`flex h-11 w-11 items-center justify-center rounded-2xl text-sm font-bold ${palette.soft} ${palette.text}`}>{feature.number}</span><span class={`text-xs font-bold uppercase tracking-[0.18em] ${palette.text}`}>{feature.eyebrow}</span></div><h2 class="mt-7 max-w-xl text-3xl font-bold leading-tight tracking-tight text-slate-950 sm:text-5xl">{feature.title}</h2><p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600">{feature.text}</p><ul class="mt-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">{feature.points.map((point) => <li class="flex items-start gap-3 text-sm font-semibold text-slate-700"><span class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs text-white ${palette.line}`}>✓</span>{point}</li>)}</ul></div><div class="reveal-right"><div class="rounded-[2rem] border border-slate-200 bg-white p-3 shadow-xl shadow-slate-900/5 sm:p-5"><div class="rounded-[1.5rem] border border-slate-100 bg-slate-50 p-5 sm:p-7"><div class="flex items-center justify-between border-b border-slate-200 pb-5"><div class="flex items-center gap-2"><span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span><span class="ml-2 text-xs font-semibold text-slate-400">{feature.visual}</span></div><span class={`rounded-full border px-2.5 py-1 text-xs font-bold ${palette.soft} ${palette.text} ${palette.border}`}>Demo</span></div><div class="mt-8 rounded-2xl bg-white p-5 shadow-sm"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">{feature.visual}</p><p class="mt-3 text-xl font-bold leading-snug text-slate-900">{feature.visualText}</p><div class="mt-7 flex items-end justify-between"><div class="h-2 w-2/3 rounded-full bg-slate-100"><div class={`h-2 rounded-full ${palette.line} ${index === 0 ? 'w-4/5' : index === 1 ? 'w-1/3' : index === 2 ? 'w-5/6' : index === 3 ? 'w-4/5' : index === 4 ? 'w-3/5' : 'w-4/5'}`}></div></div><span class={`text-sm font-bold ${palette.text}`}>{feature.stat}</span></div></div><div class="mt-4 grid grid-cols-3 gap-3"><div class="h-16 rounded-xl bg-white"></div><div class="h-16 rounded-xl bg-white"></div><div class="h-16 rounded-xl bg-white"></div></div></div></div></div></div></section>; })}</div>

    <section class="bg-slate-950 px-6 py-24 text-center text-white md:py-32"><div class="mx-auto max-w-3xl reveal"><span class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-300">Mulai dari satu kebiasaan</span><h2 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-6xl">Bawa value ke percakapan berikutnya.</h2><p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-slate-300">Bangun ritual yang sederhana, terukur, dan relevan untuk organisasi Anda.</p><a href="/signup" class="btn-interactive mt-9 inline-flex rounded-full bg-white px-8 py-4 font-semibold text-slate-950 hover:bg-indigo-50">Buat akun organisasi <span class="ml-2" aria-hidden="true">→</span></a></div></section>
  </main>
  <PublicFooter />
  <script>const initReveal = () => { const els = document.querySelectorAll('.reveal, .reveal-left, .reveal-right'); if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) els.forEach((el) => el.classList.add('is-visible')); else { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: 0.1 }); els.forEach((el) => observer.observe(el)); } }; if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReveal); else initReveal();</script>
</BaseLayout>
