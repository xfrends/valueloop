---
import BaseLayout from '../layouts/BaseLayout.astro';

const error = Astro.url.searchParams.get('error') || '';
---

<BaseLayout title="Onboarding | ValueLoop">
  <main class="flex min-h-screen w-full bg-white">
    <!-- Bagian Kiri: Form Area -->
    <div class="flex flex-1 flex-col justify-center px-6 py-12 lg:flex-none lg:w-[500px] xl:w-[640px] xl:px-24 z-10 bg-white">
      <div class="mx-auto w-full max-w-sm lg:max-w-md lg:w-full">
        <!-- Brand -->
        <div class="flex justify-start mb-10">
          <div class="flex items-center gap-3 group w-max">
            <div class="w-10 h-10 rounded-xl bg-[#0F172A] border border-slate-700 flex items-center justify-center text-white font-bold text-xl shadow-sm transition-transform duration-200 group-active:scale-95">
              V
            </div>
            <span class="text-xl font-bold tracking-tight text-[#0F172A]">ValueLoop</span>
          </div>
        </div>

        <div class="mb-8">
          <p class="text-xs font-bold uppercase tracking-widest text-[#1D4ED8] mb-2">Onboarding</p>
          <h1 class="text-3xl font-bold tracking-tight text-[#0F172A]">Ruang Kerja Baru</h1>
          <p class="mt-2 text-[15px] text-[#64748B]">Satu langkah lagi untuk mulai menanamkan budaya kerja yang terukur.</p>
        </div>
        
        {error && (
          <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[14px] text-red-700 shadow-sm">
            {error}
          </div>
        )}
        
        <form method="post" action="/api/organizations" class="space-y-6">
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Nama Organisasi</label>
            <input name="name" type="text" placeholder="Contoh: PT Bangun Bangsa" class="w-full rounded-xl bg-[#F6F8FB] border border-[#DCE4F0] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:border-[#1D4ED8] focus:ring-2 focus:ring-indigo-500/20" required />
            <p class="text-[13px] text-[#64748B] mt-1">Alamat url (slug) dibuat otomatis dari nama ini.</p>
          </div>
          
          <div class="grid gap-6 md:grid-cols-2">
            <div class="space-y-1.5">
              <label class="text-[14px] font-semibold text-[#0F172A]">Timezone</label>
              <input name="timezone" type="text" value="Asia/Jakarta" class="w-full rounded-xl bg-[#F6F8FB] border border-[#DCE4F0] px-4 py-3 outline-none transition-all focus:bg-white focus:border-[#1D4ED8] focus:ring-2 focus:ring-indigo-500/20" required />
            </div>
            <div class="space-y-1.5">
              <label class="text-[14px] font-semibold text-[#0F172A]">Template Budaya</label>
              <select name="templateId" class="w-full rounded-xl bg-[#F6F8FB] border border-[#DCE4F0] px-4 py-3 outline-none transition-all focus:bg-white focus:border-[#1D4ED8] focus:ring-2 focus:ring-indigo-500/20 appearance-none cursor-pointer">
                <option value="">Blank (Kosong)</option>
                <option value="template-good-values">5 Good Values</option>
                <option value="template-leadership">Leadership Values</option>
                <option value="template-service">Service Team</option>
                <option value="template-startup">Startup Culture</option>
              </select>
            </div>
          </div>
          
          <div class="pt-4 border-t border-[#DCE4F0]">
            <button type="submit" class="btn-interactive w-full rounded-xl bg-[#0F172A] px-4 py-3 text-white font-semibold shadow-xl shadow-slate-900/10 hover:bg-[#1E293B]">Buat Ruang Kerja</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Bagian Kanan: Ilustrasi Visual -->
    <div class="relative hidden lg:flex lg:flex-1 bg-slate-50 overflow-hidden items-center justify-center border-l border-slate-200">
      <div class="absolute inset-0 pattern-grid opacity-[0.03]"></div>
      
      <div class="relative z-10 w-full max-w-lg p-10 flex flex-col items-start">
        <div class="h-12 w-12 rounded-xl bg-white shadow-sm border border-slate-200 flex items-center justify-center mb-8">
          <svg class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
        </div>
        
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-4 leading-tight">
          Bangun organisasi yang <br />berbasis pada nilai-nilai nyata.
        </h2>
        <p class="text-slate-600 text-lg leading-relaxed mb-10 max-w-md">
          Ruang kerja (Workspace) Anda akan menjadi pusat aktivitas karyawan. Setiap tantangan dan nilai perusahaan (core value) dikonfigurasi dari sini.
        </p>

        <div class="flex gap-4">
          <div class="rounded-lg bg-white p-4 shadow-sm border border-slate-200">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Step 1</div>
            <div class="font-medium text-slate-900">Buat Organisasi</div>
          </div>
          <div class="rounded-lg bg-slate-100 p-4 border border-slate-200 opacity-60">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Step 2</div>
            <div class="font-medium text-slate-900">Undang Anggota</div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <style>
    .pattern-grid {
      background-size: 40px 40px;
      background-image: linear-gradient(to right, #0F172A 1px, transparent 1px),
        linear-gradient(to bottom, #0F172A 1px, transparent 1px);
    }
  </style>
</BaseLayout>
