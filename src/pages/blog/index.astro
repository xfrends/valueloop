---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicHeader from '../../components/PublicHeader.astro';
import PublicFooter from '../../components/PublicFooter.astro';
import type { ArticleRow } from '../../lib/services/articles';

const response = await fetch(new URL('/api/articles', Astro.url));
const payload = response.ok ? await response.json() as { articles: ArticleRow[] } : { articles: [] };
const articles = payload.articles;

function formatDate(value: string | null): string {
  if (!value) return '';
  return new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium' }).format(new Date(value));
}
---

<BaseLayout
  title="Blog ValueLoop - Wawasan Seputar Budaya Kerja & HR"
  description="Kumpulan artikel, insight, dan panduan terbaik untuk membangun budaya kerja yang positif dan menghidupkan core value perusahaan Anda."
>
    <PublicHeader />

  <main class="mx-auto w-full max-w-7xl px-6 py-16 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">Wawasan & Panduan Budaya Kerja</h1>
      <p class="text-xl text-slate-600">Pelajari cara terbaik untuk membangun, mengukur, dan menghidupkan core value perusahaan Anda setiap hari.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map((article) => (
        <a href={`/blog/${article.slug}`} class="group flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all">
          <div class="aspect-video w-full bg-gradient-to-br from-blue-400 to-teal-500 relative overflow-hidden">
            {article.thumbnail_r2_key ? (
              <img src={`/api/assets/${article.thumbnail_r2_key}`} alt={article.thumbnail_alt || article.title} class="h-full w-full object-cover" loading="lazy" />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-blue-400 to-teal-500"></div>
            )}
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-4 text-sm">
              <span class="px-3 py-1 bg-blue-50 text-blue-800 font-medium rounded-full">{article.category}</span>
              <span class="text-slate-500">{formatDate(article.published_at || article.created_at)}</span>
            </div>
            <h2 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors line-clamp-2">{article.title}</h2>
            <p class="text-slate-600 line-clamp-3 mb-6 flex-1">{article.excerpt}</p>
            <div class="flex items-center text-blue-700 font-medium mt-auto group-hover:translate-x-1 transition-transform">
              Baca selengkapnya <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <PublicFooter />
</BaseLayout>
