---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicHeader from '../../components/PublicHeader.astro';
import PublicFooter from '../../components/PublicFooter.astro';
import type { ArticleRow } from '../../lib/services/articles';

const response = await fetch(new URL(`/api/articles/${Astro.params.slug || ''}`, Astro.url));
const payload = response.ok ? await response.json() as { article: ArticleRow | null } : { article: null };
const article = payload.article;

if (!article) {
  return Astro.redirect('/blog');
}

const formattedDate = new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(new Date(article.published_at || article.created_at));
---

<BaseLayout
  title={article.seo_title || `${article.title} | Blog ValueLoop`}
  description={article.seo_description || article.excerpt}
>
    <PublicHeader />

  <main class="mx-auto w-full max-w-7xl px-6 py-16 md:py-24 relative z-10">
    <article>
      <header class="mb-12 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 text-blue-700 font-medium hover:text-blue-800 transition-colors mb-8">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Blog
        </a>
        <div class="mb-6">
          <span class="inline-block bg-blue-50 text-blue-800 font-semibold px-4 py-1.5 rounded-full text-sm border border-blue-100">{article.category}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-8 leading-tight tracking-tight">
          {article.title}
        </h1>
        <div class="flex items-center justify-center gap-4 text-slate-600 text-sm md:text-base">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-sm">{article.author_name.slice(0, 1).toUpperCase()}</div>
            <span class="font-medium text-slate-900">{article.author_name}</span>
          </div>
          <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
          <span>{formattedDate}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-slate-300 hidden md:inline-block"></span>
          <span class="hidden md:inline-block">{article.reading_minutes} menit baca</span>
        </div>
      </header>

      <div class="w-full aspect-[16/9] md:aspect-[2/1] rounded-2xl bg-gradient-to-br from-blue-400 via-teal-500 to-blue-700 mb-16 shadow-lg shadow-slate-900/5 overflow-hidden">
        {article.thumbnail_r2_key && (
          <img src={`/api/assets/${article.thumbnail_r2_key}`} alt={article.thumbnail_alt || article.title} class="h-full w-full object-cover" />
        )}
      </div>

      <div class="article-content text-lg text-slate-700 leading-relaxed space-y-8" set:html={article.content_html}></div>

      <div class="mt-20 text-center bg-gradient-to-br from-slate-900 to-slate-800 p-10 md:p-16 rounded-2xl shadow-xl relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-transparent"></div>
        <div class="relative z-10">
          <h3 class="text-2xl md:text-4xl font-bold text-white mb-6 leading-tight">Siap Menghidupkan Budaya Perusahaan Anda?</h3>
          <p class="text-slate-300 mb-10 text-lg md:text-xl max-w-xl mx-auto">Mulai jadikan core value sebagai kebiasaan kerja harian yang nyata.</p>
          <a href="/signup" class="inline-flex items-center gap-2 bg-blue-500 text-white font-semibold px-8 py-4 rounded-full hover:bg-blue-400 transition-all hover:-translate-y-1 shadow-lg shadow-blue-500/20">
            Coba ValueLoop Sekarang
          </a>
        </div>
      </div>
    </article>
  </main>

  <PublicFooter />
</BaseLayout>

<style>
  .article-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 800;
    color: rgb(15 23 42);
  }
  .article-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: rgb(15 23 42);
  }
  .article-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .article-content :global(ul) {
    list-style: disc;
  }
  .article-content :global(ol) {
    list-style: decimal;
  }
  .article-content :global(li) {
    margin-bottom: 0.75rem;
  }
</style>
