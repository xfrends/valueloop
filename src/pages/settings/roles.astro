---
import AppLayout from '../../layouts/AppLayout.astro';
import DependencyAlert from '../../components/DependencyAlert.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import {
  PERMISSIONS,
  ROLE_PERMISSIONS,
  hasPermission,
  type OrganizationPermission,
  type OrganizationRole,
} from '../../lib/permissions';
import { listOrganizationMembers } from '../../lib/services/members';
import DataTable from '../../components/DataTable.astro';

const organization = Astro.locals.organization;
const membership = Astro.locals.membership;
const runtime = getCloudflareRuntime(Astro);
const members = organization && runtime?.env?.DB
  ? await listOrganizationMembers(runtime.env.DB, organization.id)
  : [];
const canManageRoles = hasPermission(membership?.role, PERMISSIONS.MEMBERS_MANAGE_ROLES);
const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('success') || '';

const roles: Array<{ id: OrganizationRole; name: string; description: string }> = [
  { id: 'owner', name: 'Owner', description: 'Akses penuh termasuk billing dan kontrol organisasi.' },
  { id: 'admin', name: 'Admin', description: 'Mengelola data operasional, member, value, dan pengaturan.' },
  { id: 'facilitator', name: 'Facilitator', description: 'Menjalankan challenge, mencatat jawaban, dan memberi skor.' },
  { id: 'member', name: 'Member', description: 'Berpartisipasi dan melihat data miliknya.' },
  { id: 'viewer', name: 'Viewer', description: 'Akses baca untuk laporan dan insight organisasi.' },
];

const permissionGroups: Array<{ name: string; permissions: Array<{ id: OrganizationPermission; label: string }> }> = [
  {
    name: 'Culture',
    permissions: [
      { id: PERMISSIONS.CORE_VALUES_VIEW, label: 'View Core Values' },
      { id: PERMISSIONS.CORE_VALUES_MANAGE, label: 'Manage Core Values' },
      { id: PERMISSIONS.QUESTIONS_VIEW, label: 'View Question Bank' },
      { id: PERMISSIONS.QUESTIONS_MANAGE, label: 'Manage Questions' },
      { id: PERMISSIONS.CHALLENGE_START, label: 'Start Challenge' },
      { id: PERMISSIONS.CHALLENGE_REROLL, label: 'Reroll Challenge' },
      { id: PERMISSIONS.CHALLENGE_ANSWER, label: 'Submit Answer' },
      { id: PERMISSIONS.CHALLENGE_SCORE, label: 'Submit Score' },
      { id: PERMISSIONS.CHALLENGE_EDIT_SCORED, label: 'Edit Scored Session' },
      { id: PERMISSIONS.CHALLENGE_CANCEL, label: 'Cancel Session' },
    ],
  },
  {
    name: 'Organization',
    permissions: [
      { id: PERMISSIONS.MEMBERS_VIEW, label: 'View Members' },
      { id: PERMISSIONS.MEMBERS_INVITE, label: 'Invite Members' },
      { id: PERMISSIONS.MEMBERS_MANAGE, label: 'Manage Members' },
      { id: PERMISSIONS.MEMBERS_MANAGE_ROLES, label: 'Manage Member Roles' },
      { id: PERMISSIONS.TEAMS_VIEW, label: 'View Teams' },
      { id: PERMISSIONS.TEAMS_MANAGE, label: 'Manage Teams' },
      { id: PERMISSIONS.ORG_SETTINGS_MANAGE, label: 'Manage Settings' },
      { id: PERMISSIONS.AUDIT_VIEW, label: 'View Audit Log' },
    ],
  },
  {
    name: 'Reports & Access',
    permissions: [
      { id: PERMISSIONS.DASHBOARD_VIEW, label: 'View Dashboard' },
      { id: PERMISSIONS.HISTORY_VIEW_ALL, label: 'View All History' },
      { id: PERMISSIONS.HISTORY_VIEW_OWN, label: 'View Own History' },
      { id: PERMISSIONS.LEADERBOARD_VIEW, label: 'View Leaderboard' },
      { id: PERMISSIONS.INSIGHTS_VIEW, label: 'View Insights' },
      { id: PERMISSIONS.REPORT_EXPORT, label: 'Export Reports' },
      { id: PERMISSIONS.BILLING_MANAGE, label: 'Manage Billing' },
      { id: PERMISSIONS.ORG_DELETE, label: 'Delete Organization' },
    ],
  },
];
---

<AppLayout title="Roles & Access - ValueLoop" currentPath="/settings/roles">
  <div class="space-y-8">
    {error && <DependencyAlert title="Perubahan role gagal" message={error} tone="danger" />}
    {success && <DependencyAlert title="Berhasil" message={success} tone="info" />}

    <div class="mb-8 md:flex md:items-end md:justify-between">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Roles & Access</h1>
        <p class="mt-1 text-slate-500">Kelola izin dan hak akses tiap anggota dalam organisasi (RBAC).</p>
      </div>
    </div>

    <!-- Role Summary Cards -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {roles.map((role) => {
        const memberCount = members.filter((member) => member.role === role.id).length;
        const isCurrentRole = membership?.role === role.id;
        return (
          <article class={`relative overflow-hidden rounded-2xl border bg-white p-5 shadow-sm transition-all hover:shadow-md ${isCurrentRole ? 'border-indigo-200 ring-1 ring-indigo-100' : 'border-slate-200/60'}`}>
            {isCurrentRole && <div class="absolute top-0 left-0 h-1 w-full bg-indigo-500" />}
            <div class="flex items-start justify-between gap-3 mb-3">
              <h2 class="font-bold text-slate-900">{role.name}</h2>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">
                {memberCount} <span class="sr-only">members</span>
              </span>
            </div>
            <p class="text-xs leading-relaxed text-slate-500 min-h-[40px]">{role.description}</p>
            <div class="mt-4 flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-indigo-600">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              {ROLE_PERMISSIONS[role.id].length} Permissions
            </div>
          </article>
        );
      })}
    </div>

    <!-- Permission Matrix -->
    <section class="overflow-hidden rounded-2xl border border-slate-200/60 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-5 bg-slate-50/50">
        <h2 class="font-bold text-slate-900">Permission Matrix</h2>
        <p class="mt-1 text-sm text-slate-500">Matriks mendetail untuk setiap hak akses pada role bawaan (Default Roles).</p>
      </div>
      <div class="overflow-x-auto">
        <DataTable class="rounded-none border-0 shadow-none" tableClass="">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="border-b border-slate-100 bg-white text-[11px] uppercase tracking-wider text-slate-400 font-semibold">
            <tr>
              <th class="px-6 py-4">Nama Izin (Permission)</th>
              {roles.map((role) => <th class="px-4 py-4 text-center">{role.name}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {permissionGroups.map((group) => (
              <>
                <tr class="bg-slate-50/50">
                  <th colspan={roles.length + 1} class="px-6 py-3 text-xs font-bold uppercase tracking-wider text-slate-900">
                    {group.name}
                  </th>
                </tr>
                {group.permissions.map((permission) => (
                  <tr class="hover:bg-slate-50/50 transition-colors group">
                    <td class="px-6 py-3">
                      <div class="font-medium text-slate-700">{permission.label}</div>
                      <div class="font-mono text-[10px] text-slate-400 opacity-0 group-hover:opacity-100 transition-opacity">{permission.id}</div>
                    </td>
                    {roles.map((role) => {
                      const granted = ROLE_PERMISSIONS[role.id].includes(permission.id);
                      return (
                        <td class="px-4 py-3 text-center align-middle">
                          {granted ? (
                            <svg class="mx-auto h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                          ) : (
                            <svg class="mx-auto h-4 w-4 text-slate-200" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h12.5a.75.75 0 010 1.5H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
        </DataTable>
      </div>
    </section>

  </div>
</AppLayout>
