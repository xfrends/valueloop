---
import AppLayout from '../../layouts/AppLayout.astro';
import DependencyAlert from '../../components/DependencyAlert.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import { dbAll } from '../../lib/db/client';
import { getOrganizationAiSettings } from '../../lib/services/ai-settings';

type CoreValueListRow = {
  id: string;
  name: string;
  short_description: string;
  is_active: number;
  questions_count: number;
};

const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const coreValues = organization
  && runtime?.env?.DB
  ? await dbAll<CoreValueListRow>(
      runtime.env.DB,
      `select cv.*, count(q.id) as questions_count
       from core_values cv
       left join questions q on q.core_value_id = cv.id and q.organization_id = cv.organization_id
       where cv.organization_id = ?
       group by cv.id
       order by cv.is_active desc, cv.sort_order asc, cv.name asc`,
      [organization.id]
    )
  : [];
const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('success') || '';
const aiEnabled = Boolean(organization && runtime?.env?.DB && Astro.locals.membership && ['owner', 'admin', 'facilitator'].includes(Astro.locals.membership.role));
const aiConfigured = Boolean(organization && runtime?.env?.DB && (await getOrganizationAiSettings(runtime.env.DB, organization.id)));
---

<AppLayout title="Manage Core Values - ValueLoop" currentPath="/settings/values">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Core Values</h1>
        <p class="text-slate-500 mt-1 text-sm">Tentukan nilai utama, ekspektasi perilaku, dan bank pertanyaan (challenge) organisasi Anda.</p>
      </div>
      
      <div class="flex items-center gap-3">
        {aiEnabled && (aiConfigured
          ? <button id="open-ai-generator" type="button" class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">✦ Buat dengan AI</button>
          : <a href="/settings" class="inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-semibold text-indigo-700">Siapkan AI di Settings</a>)}
        <button class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 border border-slate-200/80 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          Browse Templates
        </button>
        <a href="/settings/values/new" class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Buat Core Value
        </a>
      </div>
    </div>

    {aiEnabled && <div id="ai-generator" class="hidden mb-8 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-6">
      <div class="flex items-start justify-between gap-4"><div><h2 class="text-lg font-bold text-slate-900">Buat rekomendasi core value</h2><p class="mt-1 text-sm text-slate-600">Tulis konteks organisasi atau perilaku yang ingin dibangun. Hasilnya adalah draft yang masih dapat diedit.</p></div><button id="close-ai-generator" type="button" class="text-slate-500">Tutup</button></div>
      <div id="ai-input-state" class="mt-5 space-y-3"><textarea id="ai-basic-information" rows="4" minlength="20" maxlength="4000" placeholder="Contoh: Kami adalah perusahaan teknologi yang membantu UMKM. Tim kami bekerja hybrid dan ingin meningkatkan kepemilikan terhadap kualitas layanan pelanggan." class="w-full rounded-xl border border-indigo-200 bg-white px-4 py-3 text-sm text-slate-900"></textarea><div class="flex items-center gap-3"><button id="ai-generate" type="button" class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white">Generate rekomendasi</button><span id="ai-generator-message" class="text-sm text-slate-600"></span></div></div>
      <form id="ai-draft-form" class="mt-5 hidden space-y-4 rounded-xl bg-white p-5">
        <div class="grid gap-4 md:grid-cols-2"><label class="space-y-1 text-sm font-semibold">Nama<input name="name" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required /></label><label class="space-y-1 text-sm font-semibold">Deskripsi singkat<input name="shortDescription" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required /></label></div>
        <label class="block space-y-1 text-sm font-semibold">Deskripsi lengkap<textarea name="description" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required></textarea></label>
        <div class="grid gap-4 md:grid-cols-2"><label class="space-y-1 text-sm font-semibold">Expected behaviors<textarea name="expectedBehaviors" rows="4" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required></textarea><small class="font-normal text-slate-500">Satu item per baris</small></label><label class="space-y-1 text-sm font-semibold">Anti-patterns<textarea name="antiPatterns" rows="4" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required></textarea><small class="font-normal text-slate-500">Satu item per baris</small></label></div>
        <label class="block space-y-1 text-sm font-semibold">Contoh penerapan<textarea name="example" rows="2" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" required></textarea></label>
        <div class="grid gap-4 md:grid-cols-2"><label class="space-y-1 text-sm font-semibold">Warna<select name="color" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"><option value="blue">Blue</option><option value="emerald">Emerald</option><option value="amber">Amber</option><option value="purple">Purple</option><option value="rose">Rose</option><option value="slate">Slate</option></select></label><label class="space-y-1 text-sm font-semibold">Ikon<input name="iconName" value="star" class="w-full rounded-lg border border-slate-300 px-3 py-2 font-normal" /></label></div>
        <div class="flex items-center gap-3"><button type="submit" class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white">Simpan sebagai draft</button><button id="discard-ai-draft" type="button" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold">Batalkan preview</button><span id="ai-draft-message" class="text-sm text-slate-600"></span></div>
      </form>
    </div>}

    {error && <DependencyAlert title="Aksi core value gagal" message={error} tone="danger" />}
    {success && <DependencyAlert title="Berhasil" message={success} tone="info" />}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {coreValues.map((value) => (
        <a href={`/settings/values/${value.id}`} class="group relative flex flex-col min-h-[220px] bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden hover:shadow-lg hover:border-indigo-200 hover:-translate-y-0.5 transition-all focus:outline-none">
          {value.is_active === 0 && (
            <div class="absolute inset-0 bg-slate-50/40 backdrop-blur-[0.5px] z-10 rounded-2xl pointer-events-none"></div>
          )}
          
          <div class="h-2 w-full bg-indigo-500/90 rounded-t-2xl"></div>
          
          <div class="p-6 flex-1 flex flex-col relative z-20">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-700 transition-colors leading-tight line-clamp-2 pr-2">
                {value.name}
              </h3>
            </div>
            
            <p class="text-sm text-slate-500 mb-6 flex-1 line-clamp-3 leading-relaxed">{value.short_description}</p>
            
            <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-auto">
              <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-slate-100 text-[11px] font-bold uppercase tracking-wider text-slate-600 border border-slate-200/60 shadow-sm">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                {value.questions_count} Qs
              </span>
              <span class:list={[
                'inline-flex items-center px-2 py-1 rounded text-[10px] font-bold uppercase tracking-widest shadow-sm',
                value.is_active === 1 ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/60' : 'bg-slate-100 text-slate-500 border border-slate-200/60'
              ]}>
                {value.is_active === 1 ? 'Aktif' : 'Draft'}
              </span>
            </div>
          </div>
        </a>
      ))}

      <!-- Add New Placeholder Card -->
      <a href="/settings/values/new" class="group bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-300/80 p-6 flex flex-col items-center justify-center text-slate-500 hover:text-indigo-700 hover:border-indigo-400 hover:bg-indigo-50/50 transition-all min-h-[220px]">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-sm mb-4 group-hover:scale-110 transition-transform">
          <svg class="h-6 w-6 text-slate-400 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
        </div>
        <span class="font-bold text-slate-700 group-hover:text-indigo-700">Buat Core Value Baru</span>
        <span class="text-sm mt-1 text-center max-w-[200px]">Rancang fondasi nilai baru untuk organisasi.</span>
      </a>
    </div>
  </div>
</AppLayout>

{aiEnabled && <script is:inline>
  const panel = document.querySelector('#ai-generator'); const msg = document.querySelector('#ai-generator-message'); const draftForm = document.querySelector('#ai-draft-form');
  document.querySelector('#open-ai-generator')?.addEventListener('click', () => panel.classList.remove('hidden')); document.querySelector('#close-ai-generator')?.addEventListener('click', () => panel.classList.add('hidden')); document.querySelector('#discard-ai-draft')?.addEventListener('click', () => draftForm.classList.add('hidden'));
  document.querySelector('#ai-generate')?.addEventListener('click', async () => { const basicInformation = document.querySelector('#ai-basic-information').value; msg.textContent = 'Membuat rekomendasi...'; const response = await fetch('/api/settings/values/ai-generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ basicInformation }) }); const result = await response.json(); if (!result.ok) { msg.textContent = result.message || 'Generate gagal.'; return; } const draft = result.draft; for (const [key, val] of Object.entries(draft)) { const field = draftForm.elements[key]; if (field) field.value = Array.isArray(val) ? val.join('\n') : val; } draftForm.classList.remove('hidden'); msg.textContent = 'Draft siap diedit.'; });
  draftForm?.addEventListener('submit', async (event) => { event.preventDefault(); const data = Object.fromEntries(new FormData(draftForm)); const response = await fetch('/api/settings/values', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, expectedBehaviors: data.expectedBehaviors, antiPatterns: data.antiPatterns, isActive: 0, sortOrder: 0 }) }); const result = await response.json(); document.querySelector('#ai-draft-message').textContent = result.ok ? 'Draft tersimpan. Membuka halaman core value...' : (result.message || 'Draft gagal disimpan.'); if (result.ok) window.location.href = `/settings/values/${result.valueId}`; });
</script>}
