---
import AppLayout from '../../layouts/AppLayout.astro';

const coreValues = [
  { 
    id: 'val_1',
    name: 'Ownership', 
    shortDesc: 'Taking initiative beyond core duties.',
    questionsCount: 12,
    status: 'Active',
    color: 'emerald'
  },
  { 
    id: 'val_2',
    name: 'Customer Obsession', 
    shortDesc: 'Working vigorously to earn and keep customer trust.',
    questionsCount: 8,
    status: 'Active',
    color: 'blue'
  },
  { 
    id: 'val_3',
    name: 'Innovation', 
    shortDesc: 'Expect and require innovation and invention from teams.',
    questionsCount: 5,
    status: 'Active',
    color: 'amber'
  },
  { 
    id: 'val_4',
    name: 'Integrity', 
    shortDesc: 'Doing the right thing even when no one is looking.',
    questionsCount: 10,
    status: 'Active',
    color: 'purple'
  },
  { 
    id: 'val_5',
    name: 'Speed', 
    shortDesc: 'Moving fast in business matters.',
    questionsCount: 0,
    status: 'Inactive',
    color: 'slate'
  }
];
---

<AppLayout title="Manage Core Values - ValueLoop" currentPath="/settings/values">
  
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Core Values</h1>
      <p class="text-slate-500 mt-1">Define the values, behaviors, and question banks for your organization.</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
        Browse Templates
      </button>
      <a href="/settings/values/new" class="flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-medium shadow-sm hover:bg-slate-800 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Add Value
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {coreValues.map(value => (
      <div class={`bg-white rounded-2xl border border-slate-200 shadow-sm overflow-visible flex flex-col hover:border-${value.color}-300 hover:shadow-md transition-all group relative`}>
        {value.status === 'Inactive' && (
          <div class="absolute inset-0 bg-slate-50/50 backdrop-blur-[1px] z-10 rounded-2xl pointer-events-none"></div>
        )}
        
        <div class={`h-2 w-full bg-${value.color}-500 rounded-t-2xl relative z-20`}></div>
        
        <div class="p-6 flex-1 flex flex-col relative z-20">
          <div class="flex justify-between items-start mb-4">
            <div class={`w-12 h-12 rounded-xl bg-${value.color}-100 text-${value.color}-600 flex items-center justify-center shadow-sm`}>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            </div>
            
            <!-- Dropdown Menu Container -->
            <div class="relative group/menu">
              <button class="text-slate-400 hover:text-slate-700 p-1.5 rounded-md hover:bg-slate-100 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path></svg>
              </button>
              
              <!-- Dropdown Options (Visible on Hover for Prototype) -->
              <div class="absolute right-0 top-full mt-1 w-40 bg-white rounded-lg shadow-lg border border-slate-200 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all z-50">
                <div class="p-1 flex flex-col">
                  <a href={`/settings/values/${value.id}/edit`} class="px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-emerald-600 rounded-md text-left">Edit Value</a>
                  <div class="h-px bg-slate-100 my-1"></div>
                  <button class="px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-md text-left">Deactivate</button>
                </div>
              </div>
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            <a href={`/settings/values/${value.id}`} class="before:absolute before:inset-0 before:z-10 focus:outline-none">
              {value.name}
            </a>
          </h3>
          <p class="text-sm text-slate-600 mb-6 flex-1 relative z-20 pointer-events-none">{value.shortDesc}</p>
          
          <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-auto relative z-20">
            <span class="text-sm font-medium text-slate-500 flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              {value.questionsCount} Questions
            </span>
            <span class={`text-xs font-bold uppercase tracking-wider ${value.status === 'Active' ? 'text-emerald-600' : 'text-slate-500'}`}>
              {value.status}
            </span>
          </div>
        </div>
      </div>
    ))}

    <!-- Add New Placeholder Card -->
    <a href="/settings/values/new" class="bg-slate-50 rounded-2xl border-2 border-dashed border-slate-300 p-6 flex flex-col items-center justify-center text-slate-500 hover:text-emerald-600 hover:border-emerald-300 hover:bg-emerald-50 transition-colors min-h-[280px]">
      <svg class="w-10 h-10 mb-4 text-slate-400 group-hover:text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
      <span class="font-bold">Create New Value</span>
      <span class="text-sm mt-1 text-center">Add custom core values for your org</span>
    </a>
  </div>

</AppLayout>
