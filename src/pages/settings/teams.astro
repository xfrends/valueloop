---
import AppLayout from '../../layouts/AppLayout.astro';
import DependencyAlert from '../../components/DependencyAlert.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import { listTeams } from '../../lib/services/members';
import { hasPermission, PERMISSIONS } from '../../lib/permissions';
import TableToolbar from '../../components/TableToolbar.astro';
import TableFilterDialog from '../../components/TableFilterDialog.astro';

const organization = Astro.locals.organization;
const membership = Astro.locals.membership;
const runtime = getCloudflareRuntime(Astro);
const canManageTeams = hasPermission(membership?.role, PERMISSIONS.TEAMS_MANAGE);

const query = Astro.url.searchParams.get('query') || '';
const statusFilter = Astro.url.searchParams.get('status') || '';

let teams = organization && runtime?.env?.DB ? await listTeams(runtime.env.DB, organization.id) : [];

if (query) {
  const q = query.toLowerCase();
  teams = teams.filter(t => t.name.toLowerCase().includes(q) || (t.description || '').toLowerCase().includes(q));
}
if (statusFilter === 'active') {
  teams = teams.filter(t => t.is_active);
} else if (statusFilter === 'inactive') {
  teams = teams.filter(t => !t.is_active);
}

const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('success') || '';
---

<AppLayout title="Teams - ValueLoop" currentPath="/settings/teams">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Teams</h1>
        <p class="mt-1 text-slate-500 text-sm">Daftar tim dalam organisasi. Buka detail tim untuk mengelola anggotanya.</p>
      </div>
      <div class="flex flex-col md:flex-row md:items-center gap-3">
        <TableToolbar action="/settings/teams" searchValue={query} searchPlaceholder="Search team..." submitLabel={null} compact>
          <Fragment slot="filters">
            <input type="hidden" name="status" value={statusFilter} />
          </Fragment>
        </TableToolbar>
        <button onclick="document.getElementById('teamFilterModal').showModal()" class="btn-interactive flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
          Filters
        </button>
        {canManageTeams && (
          <button onclick="document.getElementById('createTeamModal').showModal()" class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Buat Tim Baru
          </button>
        )}
      </div>
    </div>

    {error && <DependencyAlert title="Perubahan tim gagal" message={error} tone="danger" />}
    {success && <DependencyAlert title="Berhasil" message={success} tone="info" />}

    <div class="mt-8">
      {teams.length > 0 || query || statusFilter ? (
        <div class="overflow-hidden rounded-2xl border border-slate-200/60 bg-white shadow-sm">
          <div class="hidden grid-cols-[minmax(0,1fr)_130px_130px] gap-4 border-b border-slate-100 bg-slate-50/50 px-6 py-4 text-[11px] font-bold uppercase tracking-wider text-slate-500 md:grid">
            <span>Tim</span>
            <span>Anggota</span>
            <span class="text-right">Aksi</span>
          </div>
          <div class="divide-y divide-slate-50">
            {teams.map((team) => (
              <article class="grid gap-4 px-6 py-5 transition-colors hover:bg-slate-50/50 group md:grid-cols-[minmax(0,1fr)_130px_130px] md:items-center">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-3 mb-1">
                    <h2 class="truncate font-bold text-slate-900 text-base">{team.name}</h2>
                    <span class:list={[
                      'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider',
                      team.is_active ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-500',
                    ]}>
                      {team.is_active ? 'Aktif' : 'Nonaktif'}
                    </span>
                  </div>
                  <p class="line-clamp-2 text-sm text-slate-500 leading-relaxed">{team.description || 'Belum ada deskripsi tim.'}</p>
                </div>
                <div>
                  <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
                    <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H2v-2a4 4 0 014-4h3m0-4a4 4 0 100-8 4 4 0 000 8zm8 4a4 4 0 100-8 4 4 0 000 8z"></path></svg>
                    {team.member_count}
                  </span>
                </div>
                <div class="md:text-right">
                  <a href={`/settings/teams/${team.id}`} class="btn-interactive inline-flex items-center justify-center rounded-lg border border-slate-200/80 bg-white px-4 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:border-slate-300 hover:bg-slate-50 transition-colors">
                    Lihat detail
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-slate-200/80 bg-white px-6 py-16 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-50 mb-4">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H2v-2a4 4 0 014-4h3m0-4a4 4 0 100-8 4 4 0 000 8zm8 4a4 4 0 100-8 4 4 0 000 8z"></path></svg>
          </div>
          <h2 class="font-bold text-slate-900">Belum ada tim</h2>
          <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">{canManageTeams ? 'Buat tim pertama untuk mengelompokkan anggota organisasi.' : 'Owner atau admin perlu membuat tim terlebih dahulu.'}</p>
          {canManageTeams && (
            <button onclick="document.getElementById('createTeamModal').showModal()" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition-colors">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Buat Tim
            </button>
          )}
        </div>
      )}
    </div>

    <!-- Create Team Modal -->
    {canManageTeams && (
      <dialog id="createTeamModal" class="m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm rounded-2xl shadow-2xl border-0 p-0 w-full max-w-md open:animate-in open:fade-in-90 open:zoom-in-95">
        <div class="bg-white p-6">
          <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <h2 class="font-bold text-slate-900 text-lg">Buat Tim Baru</h2>
            <form method="dialog">
              <button class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </form>
          </div>
          <form method="post" action="/api/settings/teams" class="space-y-5">
            <div class="flex flex-col gap-2">
              <label for="team-name" class="block text-sm font-semibold text-slate-700">Nama tim <span class="text-rose-500">*</span></label>
              <input id="team-name" name="name" type="text" required minlength="2" maxlength="120" placeholder="Contoh: Product & Design" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
            </div>
            <div class="flex flex-col gap-2">
              <label for="team-description" class="block text-sm font-semibold text-slate-700">Deskripsi</label>
              <textarea id="team-description" name="description" rows="3" placeholder="Jelaskan fungsi atau ruang lingkup tim" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors"></textarea>
            </div>
            <input type="hidden" name="isActive" value="1" />
            <div class="mt-6 pt-4 border-t border-slate-100 flex justify-end gap-3">
              <form method="dialog"><button type="submit" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">Batal</button></form>
              <button type="submit" class="btn-interactive rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">Simpan Tim</button>
            </div>
          </form>
        </div>
      </dialog>
    )}

    <!-- Filter Modal -->
    <TableFilterDialog id="teamFilterModal" bare>
      <form method="get" class="bg-white p-6">
        <input type="hidden" name="query" value={query} />
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
          <h2 class="font-bold text-slate-900 text-lg">Filter Teams</h2>
          <div class="flex items-center gap-2">
            <a href="/settings/teams" title="Reset Filters" class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">Reset</a>
            <button type="submit" title="Terapkan Filter" class="btn-interactive px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm">Filter</button>
            <button type="button" onclick="document.getElementById('teamFilterModal').close()" title="Tutup" class="p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 rounded-lg transition-colors ml-1">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        </div>
        
        <div class="space-y-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700">Status</label>
            <select name="status" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
              <option value="">Semua Status</option>
              <option value="active" selected={statusFilter === 'active'}>Aktif</option>
              <option value="inactive" selected={statusFilter === 'inactive'}>Nonaktif</option>
            </select>
          </div>
        </div>
      </form>
    </TableFilterDialog>
  </div>
</AppLayout>
