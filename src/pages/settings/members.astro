---
import AppLayout from '../../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import { listInvitations, listOrganizationMembers } from '../../lib/services/members';
import { hasPermission, PERMISSIONS, ROLE_PERMISSIONS, type OrganizationRole } from '../../lib/permissions';

const organization = Astro.locals.organization;
const membership = Astro.locals.membership;
const runtime = getCloudflareRuntime(Astro);
const canManageRoles = hasPermission(membership?.role, PERMISSIONS.MEMBERS_MANAGE_ROLES);
const roles = (Object.keys(ROLE_PERMISSIONS) as OrganizationRole[]).map((role) => ({
  id: role,
  name: role.charAt(0).toUpperCase() + role.slice(1),
}));
const members = organization && runtime?.env?.DB ? await listOrganizationMembers(runtime.env.DB, organization.id) : [];
const invitations = organization && runtime?.env?.DB ? await listInvitations(runtime.env.DB, organization.id) : [];
const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('success') || '';
---

<AppLayout title="Members - ValueLoop" currentPath="/settings/members">
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Members</h1>
        <p class="text-slate-500 mt-1 text-sm">Kelola akses anggota, role (RBAC), dan status undangan.</p>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="document.getElementById('inviteModal').showModal()" class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
          Undang Member
        </button>
      </div>
    </div>

    {error && (
      <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 shadow-sm flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        {error}
      </div>
    )}
    {success && (
      <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm">
        {success}
      </div>
    )}

    <!-- Member filters -->
    <div class="mb-6 flex gap-2" role="tablist" aria-label="Filter member">
      <button id="tab-members" type="button" role="tab" aria-selected="true" class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">
        Organization Members
        <span class="ml-1 opacity-80">{members.length}</span>
      </button>
      <button id="tab-invites" type="button" role="tab" aria-selected="false" class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-600 ring-1 ring-slate-200 hover:text-indigo-700">
        Pending Invites
        <span class="ml-1 opacity-70">{invitations.length}</span>
      </button>
    </div>

    <!-- Tab 1 & Tab 2: Merged Single Table -->
    <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden animate-in fade-in duration-300">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50/50 text-slate-500 border-b border-slate-100 text-[11px] font-bold uppercase tracking-wider">
            <tr>
              <th class="px-6 py-4">Name</th>
              <th class="px-6 py-4">Role</th>
              <th class="px-6 py-4">Teams</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="merged-table-body" class="divide-y divide-slate-50">
            {/* Render Organization Members */}
            {members.length === 0 && invitations.length === 0 ? (
              <tr data-empty-row>
                <td colspan="5" class="px-6 py-12 text-center text-sm text-slate-500">Belum ada anggota atau undangan.</td>
              </tr>
            ) : null}
            
            {members.map((member) => {
              const ownerLocked = member.role === 'owner';
              return (
                <tr data-type="member" class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="font-bold text-slate-900">{member.full_name}</div>
                    <div class="text-xs text-slate-500">{member.email}</div>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-[11px] font-bold uppercase tracking-wider border border-slate-200/60 shadow-sm">
                      {member.role}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-600 font-medium">{member.team_names || '-'}</td>
                  <td class="px-6 py-4">
                    <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold capitalize ${member.status === 'active' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'}`}>
                      {member.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 flex justify-end">
                    {canManageRoles && !ownerLocked ? (
                      <button 
                        type="button" 
                        title="Ganti Role" 
                        class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 hover:text-indigo-800 transition-colors"
                        data-action="change-role"
                        data-member-id={member.id}
                        data-member-name={member.full_name}
                        data-member-role={member.role}
                      >
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                      </button>
                    ) : (
                      <span class="inline-flex items-center px-2.5 py-1 text-[11px] font-bold text-slate-400">
                        {ownerLocked ? 'LOCKED' : '-'}
                      </span>
                    )}
                  </td>
                </tr>
              );
            })}

            {/* Render Pending Invitations */}
            {invitations.map((invite) => (
              <tr data-type="invite" class="hidden hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-medium text-slate-700 italic">Pending Invite</div>
                  <div class="text-xs text-slate-500">{invite.email}</div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-[11px] font-bold uppercase tracking-wider border border-slate-200/60 shadow-sm">
                    {invite.role}
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-400 font-medium">-</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-bold capitalize">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    {invite.status}
                  </span>
                </td>
                <td class="px-6 py-4 flex justify-end">
                  {invite.status === 'invited' && (
                    <div class="flex justify-end gap-2">
                      <form method="post" action={`/api/settings/members/invitations/${invite.id}/resend`}>
                        <button type="submit" title="Kirim Ulang Undangan" class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </button>
                      </form>
                      <form method="post" action={`/api/settings/members/invitations/${invite.id}/cancel`} data-confirm-cancel-invite>
                        <button type="submit" title="Batalkan Undangan" class="flex items-center justify-center w-8 h-8 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                      </form>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Change Role Modal -->
    <dialog id="roleModal" class="m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm rounded-2xl shadow-2xl border-0 p-0 w-full max-w-md open:animate-in open:fade-in-90 open:zoom-in-95">
      <div class="bg-white p-6">
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
          <h2 class="font-bold text-slate-900 text-lg">Ganti Role Anggota</h2>
          <form method="dialog">
            <button class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </form>
        </div>
        <form id="roleForm" method="post" action="" class="space-y-5">
          <div>
            <p class="text-sm text-slate-500 mb-1">Anggota</p>
            <p id="roleModalMemberName" class="font-bold text-slate-900">-</p>
          </div>
          <div class="flex flex-col gap-2">
            <label class="block text-sm font-semibold text-slate-700">Role Baru</label>
            <select id="roleModalSelect" name="role" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
              {roles.filter(r => r.id !== 'owner').map(r => (
                <option value={r.id}>{r.name}</option>
              ))}
            </select>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex justify-end gap-3">
            <form method="dialog"><button type="submit" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">Batal</button></form>
            <button type="submit" class="btn-interactive rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">Simpan Role</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Invite Member Modal -->
    <dialog id="inviteModal" class="m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm rounded-2xl shadow-2xl border-0 p-0 w-full max-w-md open:animate-in open:fade-in-90 open:zoom-in-95">
      <div class="bg-white p-6">
        <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
          <h2 class="font-bold text-slate-900 text-lg">Undang Member</h2>
          <form method="dialog">
            <button class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </form>
        </div>
        <form method="post" action="/api/settings/members/invite" class="space-y-5">
          <div class="flex flex-col gap-2">
            <label class="block text-sm font-semibold text-slate-700">Email <span class="text-rose-500">*</span></label>
            <input name="email" type="email" required placeholder="nama@perusahaan.com" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="block text-sm font-semibold text-slate-700">Role</label>
            <select name="role" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
              <option value="member">Member</option>
              <option value="viewer">Viewer</option>
              <option value="facilitator">Facilitator</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex justify-end gap-3">
            <form method="dialog"><button type="submit" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">Batal</button></form>
            <button type="submit" class="btn-interactive rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">Kirim Undangan</button>
          </div>
        </form>
      </div>
    </dialog>

  </div>

  <script>
    const roleModal = document.getElementById('roleModal') as HTMLDialogElement;
    const roleForm = document.getElementById('roleForm') as HTMLFormElement;
    const roleModalMemberName = document.getElementById('roleModalMemberName');
    const roleModalSelect = document.getElementById('roleModalSelect') as HTMLSelectElement;

    document.querySelectorAll('button[data-action="change-role"]').forEach(btn => {
      btn.addEventListener('click', () => {
        const memberId = btn.getAttribute('data-member-id');
        const memberName = btn.getAttribute('data-member-name');
        const memberRole = btn.getAttribute('data-member-role');

        if (roleModalMemberName) roleModalMemberName.textContent = memberName || '-';
        if (roleModalSelect && memberRole) roleModalSelect.value = memberRole;
        if (roleForm && memberId) roleForm.action = `/api/settings/members/${memberId}/role?source=members`;

        roleModal?.showModal();
      });
    });

    document.querySelectorAll('[data-confirm-cancel-invite]').forEach((form) => form.addEventListener('submit', (event) => {
      if (!window.confirm('Batalkan undangan ini? Link undangan lama tidak akan dapat digunakan lagi.')) event.preventDefault();
    }));

    const tabMembers = document.getElementById('tab-members');
    const tabInvites = document.getElementById('tab-invites');
    
    const activeClass = "rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white";
    const inactiveClass = "rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-600 ring-1 ring-slate-200 hover:text-indigo-700";

    const filterRows = (type: string) => {
      document.querySelectorAll('#merged-table-body tr[data-type]').forEach((row) => {
        if (row.getAttribute('data-type') === type) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
      // Handle empty state gracefully
      const emptyRow = document.querySelector('#merged-table-body tr[data-empty-row]');
      const visibleRows = document.querySelectorAll(`#merged-table-body tr[data-type="${type}"]`);
      if (emptyRow) {
        if (visibleRows.length === 0) {
          emptyRow.classList.remove('hidden');
        } else {
          emptyRow.classList.add('hidden');
        }
      }
    };

    tabMembers?.addEventListener('click', () => {
      tabMembers.className = activeClass;
      tabMembers.setAttribute('aria-selected', 'true');
      if(tabInvites) tabInvites.className = inactiveClass;
      tabInvites?.setAttribute('aria-selected', 'false');
      filterRows('member');
    });

    tabInvites?.addEventListener('click', () => {
      tabInvites.className = activeClass;
      tabInvites.setAttribute('aria-selected', 'true');
      if(tabMembers) tabMembers.className = inactiveClass;
      tabMembers?.setAttribute('aria-selected', 'false');
      filterRows('invite');
    });
  </script>
</AppLayout>
