---
import AppLayout from '../../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import { listAuditLogs, listOrganizationMembers } from '../../lib/services/members';
import { formatOrgDateTime } from '../../lib/utils/date';
import { canViewAudit } from '../../lib/permissions';
import DataTable from '../../components/DataTable.astro';
import TableToolbar from '../../components/TableToolbar.astro';
import TableFilterDialog from '../../components/TableFilterDialog.astro';

const organization = Astro.locals.organization;
const allowed = canViewAudit(Astro.locals.membership?.role);
const runtime = getCloudflareRuntime(Astro);

const url = new URL(Astro.request.url);
const qDateFrom = url.searchParams.get('date_from') || undefined;
const qDateTo = url.searchParams.get('date_to') || undefined;
const qActor = url.searchParams.get('actor') || undefined;
const qAction = url.searchParams.get('action') || undefined;
const qEntity = url.searchParams.get('entity') || undefined;

const filters = {
  dateFrom: qDateFrom,
  dateTo: qDateTo,
  actorUserId: qActor,
  action: qAction,
  entityType: qEntity
};

const auditLogs = allowed && organization && runtime?.env?.DB 
  ? await listAuditLogs(runtime.env.DB, organization.id, 100, 0, filters) 
  : [];

const members = allowed && organization && runtime?.env?.DB 
  ? await listOrganizationMembers(runtime.env.DB, organization.id) 
  : [];

const translateAction = (action: string) => {
  if (!action) return action;
  const parts = action.split('.');
  const verb = parts.length > 1 ? parts[1] : action;
  
  const map: Record<string, string> = {
    create: 'Membuat',
    created: 'Membuat',
    update: 'Memperbarui',
    updated: 'Memperbarui',
    delete: 'Menghapus',
    deleted: 'Menghapus',
    invite: 'Mengundang',
    invited: 'Mengundang',
    remove: 'Mengeluarkan',
    removed: 'Mengeluarkan',
    score: 'Menilai',
    scored: 'Menilai',
    answer: 'Menjawab',
    answered: 'Menjawab',
    login: 'Masuk',
    logout: 'Keluar',
    activate: 'Mengaktifkan',
    activated: 'Mengaktifkan',
    deactivate: 'Menonaktifkan',
    deactivated: 'Menonaktifkan',
    accept: 'Menerima',
    accepted: 'Menerima',
    reject: 'Menolak',
    rejected: 'Menolak',
    reroll: 'Mereroll',
    rerolled: 'Mereroll',
    started: 'Memulai',
    status_updated: 'Mengubah Status',
    role_changed: 'Mengubah Peran',
    role_updated: 'Mengubah Peran',
    settings_updated: 'Mengubah Pengaturan'
  };
  return map[verb] || verb;
};

const translateEntity = (entity: string) => {
  if (!entity) return entity;
  const map: Record<string, string> = {
    organization: 'Organisasi',
    organization_settings: 'Pengaturan Organisasi',
    organization_member: 'Anggota Organisasi',
    member: 'Anggota',
    core_value: 'Core Value',
    question: 'Pertanyaan',
    challenge: 'Challenge',
    challenge_session: 'Sesi Challenge',
    team: 'Tim',
    team_member: 'Anggota Tim',
    session: 'Sesi',
    invitation: 'Undangan',
    score: 'Skor'
  };
  return map[entity] || entity;
};
const getDiff = (beforeStr: string | null | undefined, afterStr: string | null | undefined) => {
  if (!beforeStr && !afterStr) return null;
  let before = {}, after = {};
  try { if (beforeStr) before = JSON.parse(beforeStr); } catch (e) {}
  try { if (afterStr) after = JSON.parse(afterStr); } catch (e) {}
  
  const changes: string[] = [];
  const allKeys = new Set([...Object.keys(before), ...Object.keys(after)]);
  
  allKeys.forEach(key => {
    // Skip noisy fields
    if (['id', 'created_at', 'updated_at', 'organization_id', 'actor_user_id', 'actor_member_id', 'token_hash'].includes(key)) return;
    
    const b = (before as any)[key];
    const a = (after as any)[key];
    
    if (JSON.stringify(b) !== JSON.stringify(a)) {
      if (b === undefined || b === null) {
        changes.push(`+ ${key}: ${typeof a === 'object' ? '...' : a}`);
      } else if (a === undefined || a === null) {
        changes.push(`- ${key}: ${typeof b === 'object' ? '...' : b}`);
      } else {
        changes.push(`~ ${key}: ${typeof b === 'object' ? '...' : b} → ${typeof a === 'object' ? '...' : a}`);
      }
    }
  });
  
  return changes.length > 0 ? changes : null;
};
---

<AppLayout title="Audit Log - ValueLoop" currentPath="/settings/audit">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Audit Log</h1>
      <p class="text-slate-500 mt-1">Read-only trail of important organization changes.</p>
    </div>
  </div>

  {!allowed ? (
    <div role="alert" class="rounded-2xl border border-red-100 bg-red-50 p-6 text-red-700">Audit log hanya dapat dilihat oleh owner atau admin organisasi.</div>
  ) : (
    <div class="space-y-6">
      <div class="flex items-center gap-3">
        <div class="flex-grow">
          <TableToolbar action="/settings/audit" searchValue={url.searchParams.get('query') || ''} searchPlaceholder="Search actor or action..." submitLabel={null} compact>
            <Fragment slot="filters">
              <input type="hidden" name="date_from" value={qDateFrom || ''} />
              <input type="hidden" name="date_to" value={qDateTo || ''} />
              <input type="hidden" name="actor" value={qActor || ''} />
              <input type="hidden" name="action" value={qAction || ''} />
              <input type="hidden" name="entity" value={qEntity || ''} />
            </Fragment>
          </TableToolbar>
        </div>
        <button onclick="document.getElementById('auditFilterModal').showModal()" class="btn-interactive flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
          Filters
        </button>
      </div>

      <!-- Filter Modal -->
      <TableFilterDialog id="auditFilterModal" bare>
        <form method="get" class="bg-white p-6">
          <input type="hidden" name="query" value={url.searchParams.get('query') || ''} />
          <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
            <h2 class="font-bold text-slate-900 text-lg">Filter Audit Logs</h2>
            <div class="flex items-center gap-2">
              <a href="/settings/audit" title="Reset Filters" class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">Reset</a>
              <button type="submit" title="Terapkan Filter" class="btn-interactive px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm">Filter</button>
              <button type="button" onclick="document.getElementById('auditFilterModal').close()" title="Tutup" class="p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600 rounded-lg transition-colors ml-1">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
          </div>
          
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-700">Date From</label>
                <input type="date" name="date_from" value={qDateFrom || ''} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-700">Date To</label>
                <input type="date" name="date_to" value={qDateTo || ''} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class="text-sm font-semibold text-slate-700">Actor</label>
              <select name="actor" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
                <option value="">Semua Actor</option>
                {members.map((m: any) => (
                  <option value={m.user_id} selected={qActor === m.user_id}>{m.full_name}</option>
                ))}
              </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-700">Action</label>
                <select name="action" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
                  <option value="">Semua Action</option>
                  {['create', 'update', 'delete', 'invite', 'remove', 'score', 'answer', 'activate', 'deactivate'].map(a => (
                    <option value={a} selected={qAction === a}>{translateAction(a)}</option>
                  ))}
                </select>
              </div>
              <div class="flex flex-col gap-2">
                <label class="text-sm font-semibold text-slate-700">Entity</label>
                <select name="entity" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
                  <option value="">Semua Entity</option>
                  {['organization', 'member', 'core_value', 'question', 'challenge', 'team', 'invitation'].map(e => (
                    <option value={e} selected={qEntity === e}>{translateEntity(e)}</option>
                  ))}
                </select>
              </div>
            </div>
          </div>
        </form>
      </TableFilterDialog>

      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <DataTable class="rounded-none border-0 shadow-none" tableClass="">
          <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-500">
          <tr>
            <th class="px-6 py-3 font-medium whitespace-nowrap">Time</th>
            <th class="px-6 py-3 font-medium whitespace-nowrap">Actor</th>
            <th class="px-6 py-3 font-medium whitespace-nowrap">Action</th>
            <th class="px-6 py-3 font-medium whitespace-nowrap">Entity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {auditLogs.map((log) => {
            const diff = getDiff(log.before_value, log.after_value);
            return (
              <tr 
                class="hover:bg-slate-50/80 transition-colors cursor-pointer group"
                data-diff={diff ? JSON.stringify(diff) : ''}
                data-action={translateAction(log.action)}
                data-entity={translateEntity(log.entity_type)}
                data-time={formatOrgDateTime(new Date(log.created_at), organization?.timezone || 'Asia/Jakarta')}
                onclick="openAuditModal(this)"
              >
                <td class="px-6 py-4 align-middle text-slate-500">{formatOrgDateTime(new Date(log.created_at), organization?.timezone || 'Asia/Jakarta')}</td>
                <td class="px-6 py-4 align-middle font-medium text-slate-700">{log.actor_name || '-'}</td>
                <td class="px-6 py-4 align-middle">
                  <span class="inline-flex items-center px-2 py-1 rounded bg-slate-100 text-slate-700 text-xs font-semibold">
                    {translateAction(log.action)}
                  </span>
                </td>
                <td class="px-6 py-4 align-middle font-medium text-slate-900">{translateEntity(log.entity_type)}</td>
              </tr>
            );
          })}
        </tbody>
          </table>
          </DataTable>
    </div>
  </div>

  <!-- Audit Detail Modal -->
  <dialog id="audit-modal" class="backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm rounded-2xl shadow-2xl border border-slate-200 p-0 max-w-lg w-full m-auto">
    <div class="p-6">
      <div class="flex items-start justify-between mb-5">
        <div>
          <h3 class="text-lg font-bold text-slate-900" id="modal-title">Log Detail</h3>
          <p class="text-sm text-slate-500 mt-1" id="modal-time"></p>
        </div>
        <form method="dialog">
          <button class="p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </form>
      </div>
      <div class="bg-slate-50 rounded-xl border border-slate-100 p-4 max-h-[60vh] overflow-y-auto">
        <ul id="modal-diff-list" class="space-y-1.5 font-mono text-xs text-slate-600">
          <!-- Populated by JS -->
        </ul>
        <div id="modal-no-diff" class="text-sm text-slate-500 italic hidden text-center py-4">
          Tidak ada detail perubahan untuk direkam.
        </div>
      </div>
    </div>
  </dialog>

  <script is:inline>
    function openAuditModal(tr) {
      const modal = document.getElementById('audit-modal');
      const diffStr = tr.getAttribute('data-diff');
      const action = tr.getAttribute('data-action');
      const entity = tr.getAttribute('data-entity');
      const time = tr.getAttribute('data-time');
      
      document.getElementById('modal-title').textContent = `${action} ${entity}`;
      document.getElementById('modal-time').textContent = time;
      
      const list = document.getElementById('modal-diff-list');
      const empty = document.getElementById('modal-no-diff');
      
      list.innerHTML = '';
      if (diffStr) {
        try {
          const diff = JSON.parse(diffStr);
          diff.forEach(d => {
            const li = document.createElement('li');
            li.textContent = d;
            li.className = `whitespace-pre-wrap break-words ${
              d.startsWith('+') ? 'text-emerald-700' : 
              d.startsWith('-') ? 'text-rose-700' : 'text-indigo-700'
            }`;
            list.appendChild(li);
          });
          list.classList.remove('hidden');
          empty.classList.add('hidden');
        } catch(e) {
          list.classList.add('hidden');
          empty.classList.remove('hidden');
        }
      } else {
        list.classList.add('hidden');
        empty.classList.remove('hidden');
      }
      
      modal.showModal();
    }
  </script>
  </div>
  )}
</AppLayout>
