---
import AppLayout from '../../../../layouts/AppLayout.astro';
import DependencyAlert from '../../../../components/DependencyAlert.astro';
import { getCloudflareRuntime } from '../../../../lib/cloudflare/bindings';
import { dbFirst } from '../../../../lib/db/client';
import { parseJsonArray } from '../../../../lib/utils/json';

type CoreValueDetailRow = {
  id: string;
  name: string;
  short_description: string;
  description: string | null;
  expected_behaviors: string;
  anti_patterns: string;
  example: string | null;
  color: string;
  is_active: number;
  questions_count: number;
  active_questions_count: number;
};

const organization = Astro.locals.organization;
const valueId = Astro.params.id;
const runtime = getCloudflareRuntime(Astro);
const valueRow = organization
  && runtime?.env?.DB
  ? await dbFirst<CoreValueDetailRow>(
      runtime.env.DB,
      `select cv.*,
              count(q.id) as questions_count,
              sum(case when q.is_active = 1 then 1 else 0 end) as active_questions_count
       from core_values cv
       left join questions q on q.core_value_id = cv.id and q.organization_id = cv.organization_id
       where cv.organization_id = ? and cv.id = ?
       group by cv.id
       limit 1`,
      [organization.id, valueId]
    )
  : null;

const valueData = valueRow
  ? {
      name: valueRow.name,
      shortDesc: valueRow.short_description,
      fullDesc: valueRow.description || '',
      rootQuestion: valueRow.short_description,
      expectedBehaviors: parseJsonArray(valueRow.expected_behaviors) as string[],
      antiPatterns: parseJsonArray(valueRow.anti_patterns) as string[],
      example: valueRow.example || '',
      status: valueRow.is_active === 1 ? 'Active' : 'Inactive',
      color: valueRow.color || 'emerald',
    }
  : null;
---

<AppLayout title={`${valueData?.name || 'Core Value'} - Detail Value`} currentPath="/settings/values">
  {!valueData && (
    <DependencyAlert
      title="Core value tidak ditemukan"
      message="Core value mungkin sudah tidak tersedia atau berasal dari organisasi lain."
      actionHref="/settings/values"
      actionLabel="Kembali ke core values"
      tone="danger"
    />
  )}
  <div class:list={["max-w-[1100px] mx-auto space-y-10", { hidden: !valueData }]}>
    
    <!-- Header Section -->
    <div class="flex flex-col gap-6 md:flex-row md:items-start justify-between border-b border-slate-200/60 pb-6">
      <div>
        <nav class="flex text-sm text-slate-500 font-medium mb-4" aria-label="Breadcrumb">
          <a href="/settings/values" class="hover:text-indigo-600 transition-colors">Core Values</a>
          <span class="mx-2 text-slate-300">/</span>
          <span class="text-slate-900 truncate max-w-[200px]" aria-current="page">{valueData?.name}</span>
        </nav>
        
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200/60 text-slate-800 flex items-center justify-center shadow-sm">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
          </div>
          <div>
            <div class="flex items-center gap-3">
              <h1 class="text-2xl font-bold text-slate-900 tracking-tight">{valueData?.name}</h1>
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider rounded-full border ${valueData?.status === 'Active' ? 'bg-emerald-50 text-emerald-700 border-emerald-200/60' : 'bg-slate-50 text-slate-600 border-slate-200/60'}`}>
                {valueData?.status}
              </span>
            </div>
            <p class="text-sm text-slate-500 mt-1 max-w-xl leading-relaxed">{valueData?.shortDesc}</p>
          </div>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <a href={`/settings/values/${valueId}/edit`} class="btn-interactive inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:border-slate-300 transition-all">
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          Edit Detail
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column (Description & Root Question) -->
      <div class="lg:col-span-2 space-y-8">
        
        <div class="bg-slate-900 rounded-2xl border border-slate-800 shadow-md p-8 md:p-10 text-white relative overflow-hidden group">
          <!-- Geometric Pattern -->
          <svg class="absolute -bottom-24 -right-24 w-96 h-96 text-slate-800 opacity-50 transform rotate-12 group-hover:rotate-6 transition-transform duration-700" fill="currentColor" viewBox="0 0 100 100">
            <rect x="20" y="20" width="60" height="60" rx="8" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          
          <div class="relative z-10">
            <h2 class="text-[11px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-4 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
              Root Question
            </h2>
            <p class="text-2xl md:text-3xl font-medium leading-tight text-white max-w-2xl">
              "{valueData?.rootQuestion}"
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
          <div class="p-8">
            <h2 class="text-sm font-bold text-slate-900 mb-4 uppercase tracking-wider">Maksud & Tujuan</h2>
            <p class="text-slate-600 leading-relaxed text-sm">{valueData?.fullDesc}</p>
          </div>
          
          <div class="bg-slate-50/80 border-t border-slate-100 p-8">
            <h2 class="text-sm font-bold text-slate-900 mb-4 uppercase tracking-wider">Contoh Implementasi</h2>
            <div class="relative pl-6">
              <div class="absolute left-0 top-1 bottom-1 w-1 bg-indigo-200 rounded-full"></div>
              <p class="italic text-slate-700 text-sm leading-relaxed">
                "{valueData?.example}"
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200/60 bg-white p-8 shadow-sm">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 border border-slate-200/50">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.23 9a4 4 0 0 1 7.54 1.87c0 1.86-1.28 3.43-3 3.88-.46.12-.77.52-.77.99V16m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path></svg>
              </div>
              <div>
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-1">Bank Pertanyaan</h2>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-sm font-bold text-slate-900">{Number(valueRow?.questions_count ?? 0)}</span> <span class="text-sm text-slate-500">total questions,</span>
                  <span class="text-sm font-bold text-slate-900">{Number(valueRow?.active_questions_count ?? 0)}</span> <span class="text-sm text-slate-500">active.</span>
                </div>
              </div>
            </div>
            <a href={`/settings/values/${valueId}/questions`} class="btn-interactive inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">
              Manage Questions
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"></path></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column (Rules & Stats) -->
      <div class="space-y-6">
        
        <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 bg-slate-50/30">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Expected Behaviors
            </h3>
          </div>
          <div class="p-6">
            <ul class="space-y-4">
              {valueData?.expectedBehaviors.map((behavior) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
                  <span class="flex-shrink-0 w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  </span>
                  <span>{behavior}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm overflow-hidden">
          <div class="p-6 border-b border-slate-100 bg-slate-50/30">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
              <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              Anti-patterns
            </h3>
          </div>
          <div class="p-6">
            <ul class="space-y-4">
              {valueData?.antiPatterns.map((pattern) => (
                <li class="flex items-start gap-3 text-sm text-slate-700 leading-relaxed">
                  <span class="flex-shrink-0 w-5 h-5 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mt-0.5">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </span>
                  <span>{pattern}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-6">
          <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-5">Performance Stats</h3>
          <div class="space-y-5">
            <div>
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Impact Radius</p>
              <div class="flex items-end gap-2">
                <p class="text-3xl font-bold text-slate-900 tracking-tight">{valueRow?.questions_count ?? 0}</p>
                <p class="text-sm font-medium text-slate-500 mb-1">Sesi Challenge</p>
              </div>
            </div>
            <div class="pt-4 border-t border-slate-100">
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Avg. Score</p>
              <div class="flex items-center gap-3">
                <p class="text-3xl font-bold text-slate-300 tracking-tight">N/A</p>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-slate-500">Belum ada data</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</AppLayout>
