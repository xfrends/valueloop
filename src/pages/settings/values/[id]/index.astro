---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../../../../lib/cloudflare/bindings';
import { dbAll, dbFirst } from '../../../../lib/db/client';
import { parseJsonArray } from '../../../../lib/utils/json';

type CoreValueDetailRow = {
  id: string;
  name: string;
  short_description: string;
  description: string | null;
  expected_behaviors: string;
  anti_patterns: string;
  example: string | null;
  color: string;
  is_active: number;
  questions_count: number;
};

type QuestionRow = {
  id: string;
  question_text: string;
  difficulty: string;
  is_active: number;
};

const organization = Astro.locals.organization;
const valueId = Astro.params.id;
const runtime = getCloudflareRuntime(Astro);
const valueRow = organization
  && runtime?.env?.DB
  ? await dbFirst<CoreValueDetailRow>(
      runtime.env.DB,
      `select cv.*, count(q.id) as questions_count
       from core_values cv
       left join questions q on q.core_value_id = cv.id and q.organization_id = cv.organization_id
       where cv.organization_id = ? and cv.id = ?
       group by cv.id
       limit 1`,
      [organization.id, valueId]
    )
  : null;

const questions = organization && valueRow
  && runtime?.env?.DB
  ? await dbAll<QuestionRow>(
      runtime.env.DB,
      `select * from questions where organization_id = ? and core_value_id = ? order by is_active desc, created_at desc`,
      [organization.id, valueId]
    )
  : [];

const valueData = valueRow
  ? {
      name: valueRow.name,
      shortDesc: valueRow.short_description,
      fullDesc: valueRow.description || '',
      rootQuestion: valueRow.short_description,
      expectedBehaviors: parseJsonArray(valueRow.expected_behaviors) as string[],
      antiPatterns: parseJsonArray(valueRow.anti_patterns) as string[],
      example: valueRow.example || '',
      status: valueRow.is_active === 1 ? 'Active' : 'Inactive',
      color: valueRow.color || 'emerald',
    }
  : null;
---

<AppLayout title={`${valueData?.name || 'Core Value'} - Detail Value`} currentPath="/settings/values">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <a href="/settings/values" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-emerald-600 mb-4 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Core Values
        </a>
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
          </div>
          <div>
            <h1 class="text-3xl font-bold text-slate-900">{valueData?.name}</h1>
            <p class="text-slate-500 mt-1">{valueData?.shortDesc}</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg border ${valueData?.status === 'Active' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-slate-50 text-slate-700 border-slate-200'}`}>
          <span class={`w-2 h-2 rounded-full ${valueData?.status === 'Active' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`}></span>
          {valueData?.status}
        </span>
        <a href={`/settings/values/${valueId}/edit`} class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          Edit
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-slate-900 rounded-2xl border border-slate-800 shadow-lg p-6 md:p-8 text-white relative overflow-hidden">
          <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/3 opacity-10">
            <svg class="w-48 h-48" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L16.4 14.6h-4.382l2.383-6.4H12.02l-2.382 6.4h4.382L11.638 21h2.379zm-7.618 0L8.782 14.6H4.4L6.782 8.2H4.402L2.02 14.6h4.382L4.022 21h2.377z"></path></svg>
          </div>
          <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Root Question</h2>
          <p class="text-xl md:text-2xl font-medium leading-relaxed relative z-10">"{valueData?.rootQuestion}"</p>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 md:p-8">
          <h2 class="text-lg font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Full Description</h2>
          <p class="text-slate-700 leading-relaxed">{valueData?.fullDesc}</p>

          <div class="mt-8">
            <h2 class="text-lg font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2">Example in Practice</h2>
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-5 italic text-slate-700 relative">
              <svg class="w-8 h-8 text-slate-200 absolute top-2 left-2 -translate-y-1/2 -translate-x-1/2" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L16.4 14.6h-4.382l2.383-6.4H12.02l-2.382 6.4h4.382L11.638 21h2.379zm-7.618 0L8.782 14.6H4.4L6.782 8.2H4.402L2.02 14.6h4.382L4.022 21h2.377z"></path></svg>
              "{valueData?.example}"
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="p-6 md:p-8 border-b border-slate-100 flex items-center justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Question Bank</h2>
              <p class="text-sm text-slate-500 mt-1">Situational questions randomly drawn during the Daily Challenge.</p>
            </div>
            <button onclick="document.getElementById('modal-question').showModal()" class="px-4 py-2 bg-slate-900 text-white rounded-lg text-sm font-medium shadow-sm hover:bg-slate-800 transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Add Question
            </button>
          </div>

          <ul class="divide-y divide-slate-100">
            {questions.map((q) => (
              <li class={`p-6 transition-colors hover:bg-slate-50 flex flex-col md:flex-row gap-4 justify-between items-start ${q.is_active === 0 ? 'opacity-60 bg-slate-50/50' : ''}`}>
                <div class="flex-1 pr-4">
              <p class="text-slate-900 font-medium mb-2">{q.question_text}</p>
                  <div class="flex items-center gap-3">
                    <span class={`text-xs font-bold uppercase tracking-wider ${q.difficulty === 'easy' ? 'text-green-600' : q.difficulty === 'medium' ? 'text-amber-600' : 'text-red-600'}`}>
                      {q.difficulty}
                    </span>
                    <span class="text-slate-300">•</span>
                    <span class={`text-xs font-semibold ${q.is_active === 1 ? 'text-slate-500' : 'text-slate-400'}`}>
                      {q.is_active === 1 ? 'Active' : 'Inactive'}
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button onclick="document.getElementById('modal-question').showModal()" class="p-2 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="Edit Question">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </button>
                  <button onclick="document.getElementById('modal-delete').showModal()" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Delete Question">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-emerald-50 rounded-2xl border border-emerald-100 shadow-sm p-6">
          <h3 class="font-bold text-emerald-800 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Expected Behaviors
          </h3>
          <ul class="space-y-3">
            {valueData?.expectedBehaviors.map((behavior) => (
              <li class="flex items-start gap-2 text-sm text-emerald-900">
                <span class="text-emerald-500 mt-0.5">•</span>
                {behavior}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-red-50 rounded-2xl border border-red-100 shadow-sm p-6">
          <h3 class="font-bold text-red-800 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            Anti-patterns
          </h3>
          <ul class="space-y-3">
            {valueData?.antiPatterns.map((pattern) => (
              <li class="flex items-start gap-2 text-sm text-red-900">
                <span class="text-red-400 mt-0.5">•</span>
                {pattern}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <h3 class="font-bold text-slate-900 mb-4">Value Performance</h3>
          <div class="space-y-4">
            <div>
              <p class="text-sm text-slate-500 mb-1">Times Selected in Challenge</p>
              <p class="text-2xl font-bold text-slate-900">{valueRow?.questions_count ?? 0} <span class="text-sm font-medium text-slate-500">questions</span></p>
            </div>
            <div>
              <p class="text-sm text-slate-500 mb-1">Average Organization Score</p>
              <div class="flex items-center gap-2">
                <p class="text-2xl font-bold text-slate-900">-<span class="text-sm font-medium text-slate-500">/10</span></p>
                <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Live</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <dialog id="modal-question" class="bg-transparent p-0 m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm open:animate-in open:fade-in open:zoom-in-95">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-lg font-bold text-slate-900">Add / Edit Question</h3>
        <button onclick="document.getElementById('modal-question').close()" class="p-2 text-slate-400 hover:text-slate-600 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <form method="post" action="/api/settings/questions" class="p-6 space-y-5">
        <input type="hidden" name="coreValueId" value={valueId} />
        <div class="space-y-2">
          <label class="block text-sm font-bold text-slate-900">Question Text <span class="text-red-500">*</span></label>
          <textarea name="questionText" rows="3" placeholder="e.g. Ceritakan saat kamu..." class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow" required></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-900">Difficulty</label>
            <select name="difficulty" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none bg-white">
              <option value="easy">Easy</option>
              <option value="medium">Medium</option>
              <option value="hard">Hard</option>
            </select>
          </div>
          <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-900">Status</label>
            <select name="isActive" class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none bg-white">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
        </div>
        <div class="space-y-2">
          <label class="block text-sm font-bold text-slate-900">Suggested Rubric / Note</label>
          <input name="suggestedRubricNote" type="text" placeholder="Guidance for the facilitator scoring this..." class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow" />
        </div>
        <div class="pt-4 flex justify-end gap-3">
          <button type="button" onclick="document.getElementById('modal-question').close()" class="px-5 py-2.5 rounded-lg font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition-colors">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-lg font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-sm">
            Save Question
          </button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog id="modal-delete" class="bg-transparent p-0 m-auto backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm open:animate-in open:fade-in open:zoom-in-95">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-sm overflow-hidden p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">Delete Question?</h3>
      <p class="text-sm text-slate-500 mb-6">Are you sure you want to delete this question? This action cannot be undone.</p>
      <div class="flex gap-3">
        <button type="button" onclick="document.getElementById('modal-delete').close()" class="flex-1 px-4 py-2.5 rounded-lg font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition-colors">
          Cancel
        </button>
        <button type="button" class="flex-1 px-4 py-2.5 rounded-lg font-medium text-white bg-red-600 hover:bg-red-700 transition-colors">
          Delete
        </button>
      </div>
    </div>
  </dialog>
</AppLayout>
