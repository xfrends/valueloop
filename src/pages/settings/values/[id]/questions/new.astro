---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import DependencyAlert from '../../../../../components/DependencyAlert.astro';
import QuestionForm from '../../../../../components/QuestionForm.astro';
import { getCloudflareRuntime } from '../../../../../lib/cloudflare/bindings';
import { canManageValues } from '../../../../../lib/permissions';
import { getCoreValue } from '../../../../../lib/services/values';
import { parseJsonRecord } from '../../../../../lib/utils/form-errors';

const valueId = Astro.params.id || '';
const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const allowed = canManageValues(Astro.locals.membership?.role);
const coreValue = organization && runtime?.env?.DB ? await getCoreValue(runtime.env.DB, organization.id, valueId) : null;
const error = Astro.url.searchParams.get('error') || '';
const fieldErrors = parseJsonRecord(Astro.url.searchParams.get('fieldErrors'));
const questionText = Astro.url.searchParams.get('questionText') || '';
---

<AppLayout title={`Add Question - ${coreValue?.name || 'Core Value'}`} currentPath="/settings/values">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <a href={`/settings/values/${valueId}/questions`} class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-700 mb-3 transition-colors uppercase tracking-wider">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Bank
        </a>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">{coreValue?.name || 'Core Value'}</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Add Question</h1>
        <p class="text-slate-500 mt-1 text-sm leading-relaxed">Tambahkan pertanyaan baru khusus untuk core value ini.</p>
      </div>
    </div>

    {error && <DependencyAlert title="Question gagal disimpan" message={error} tone="danger" />}
    {!coreValue ? (
      <DependencyAlert title="Core value tidak ditemukan" message="Question tidak dapat dibuat karena core value tidak tersedia atau berasal dari organisasi lain." actionHref="/settings/values" actionLabel="Kembali ke core values" tone="danger" />
    ) : !allowed ? (
      <DependencyAlert title="Akses terbatas" message="Hanya owner atau admin yang dapat menambahkan question." tone="danger" />
    ) : (
      <QuestionForm
        action="/api/settings/questions"
        coreValueId={valueId}
        questionText={questionText}
        fieldErrors={fieldErrors}
        submitLabel="Add Question"
      />
    )}
  </div>
</AppLayout>
