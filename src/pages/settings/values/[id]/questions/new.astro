---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import DependencyAlert from '../../../../../components/DependencyAlert.astro';
import QuestionForm from '../../../../../components/QuestionForm.astro';
import { getCloudflareRuntime } from '../../../../../lib/cloudflare/bindings';
import { canManageValues } from '../../../../../lib/permissions';
import { getCoreValue } from '../../../../../lib/services/values';
import { getOrganizationAiSettings } from '../../../../../lib/services/ai-settings';
import { parseJsonRecord } from '../../../../../lib/utils/form-errors';

const valueId = Astro.params.id || '';
const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const allowed = canManageValues(Astro.locals.membership?.role);
const coreValue = organization && runtime?.env?.DB ? await getCoreValue(runtime.env.DB, organization.id, valueId) : null;
const aiConfigured = Boolean(organization && runtime?.env?.DB && (await getOrganizationAiSettings(runtime.env.DB, organization.id))?.isEnabled);
const error = Astro.url.searchParams.get('error') || '';
const fieldErrors = parseJsonRecord(Astro.url.searchParams.get('fieldErrors'));
const questionText = Astro.url.searchParams.get('questionText') || '';
---

<AppLayout title={`Add Question - ${coreValue?.name || 'Core Value'}`} currentPath="/settings/values">
  <div class="mx-auto max-w-3xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <a href={`/settings/values/${valueId}/questions`} class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-700 mb-3 transition-colors uppercase tracking-wider">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Bank
        </a>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">{coreValue?.name || 'Core Value'}</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Add Question</h1>
        <p class="text-slate-500 mt-1 text-sm leading-relaxed">Tambahkan pertanyaan baru khusus untuk core value ini.</p>
      </div>
    </div>

    {error && <DependencyAlert title="Question gagal disimpan" message={error} tone="danger" />}
    {!coreValue ? (
      <DependencyAlert title="Core value tidak ditemukan" message="Question tidak dapat dibuat karena core value tidak tersedia atau berasal dari organisasi lain." actionHref="/settings/values" actionLabel="Kembali ke core values" tone="danger" />
    ) : !allowed ? (
      <DependencyAlert title="Akses terbatas" message="Hanya owner atau admin yang dapat menambahkan question." tone="danger" />
    ) : (
      <div>
      {aiConfigured && <section class="mb-5 rounded-2xl border border-indigo-200 bg-indigo-50/60 p-5"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="font-bold text-slate-900">Buat question dengan AI</h2><p class="mt-1 text-sm text-slate-600">AI akan membuat draft berdasarkan core value ini. Anda tetap dapat mengeditnya sebelum menyimpan.</p></div><button id="generate-question-ai" data-core-value-id={valueId} type="button" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700">✦ Generate dengan AI</button></div><div id="question-ai-message" class="mt-3 hidden rounded-xl border px-4 py-3 text-sm font-medium" role="alert" aria-live="polite"></div></section>}
      <QuestionForm
        action="/api/settings/questions"
        coreValueId={valueId}
        questionText={questionText}
        fieldErrors={fieldErrors}
        submitLabel="Add Question"
      />
      </div>
    )}
  </div>
</AppLayout>

<script is:inline>
  const aiButton = document.querySelector('#generate-question-ai');
  const aiMessage = document.querySelector('#question-ai-message');
  aiButton?.addEventListener('click', async () => {
    aiButton.disabled = true; aiButton.textContent = 'Membuat draft...'; aiMessage.className = 'mt-3 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-medium text-indigo-700'; aiMessage.textContent = 'AI sedang menyusun question...';
    try {
      const response = await fetch('/api/settings/questions/ai-generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ coreValueId: aiButton.dataset.coreValueId }) });
      const result = await response.json();
      if (!result.ok) throw new Error(result.message || 'Question AI gagal dibuat.');
      document.querySelector('#questionText').value = result.draft.questionText;
      document.querySelector('#difficulty').value = result.draft.difficulty;
      document.querySelector('#suggestedRubricNote').value = result.draft.suggestedRubricNote;
      aiMessage.className = 'mt-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700'; aiMessage.textContent = 'Draft berhasil dibuat. Silakan review sebelum menyimpan.';
    } catch (error) { aiMessage.className = 'mt-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700'; aiMessage.textContent = error instanceof Error ? error.message : 'Question AI gagal dibuat.'; }
    aiButton.disabled = false; aiButton.textContent = '✦ Generate dengan AI';
  });
</script>
