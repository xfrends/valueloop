---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import DependencyAlert from '../../../../../components/DependencyAlert.astro';
import { getCloudflareRuntime } from '../../../../../lib/cloudflare/bindings';
import { canManageValues } from '../../../../../lib/permissions';
import { listQuestionsForCoreValue } from '../../../../../lib/services/questions';
import { getCoreValue } from '../../../../../lib/services/values';
import { formatOrgDateTime } from '../../../../../lib/utils/date';
import DataTable from '../../../../../components/DataTable.astro';
import TableToolbar from '../../../../../components/TableToolbar.astro';

const valueId = Astro.params.id || '';
const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const allowed = canManageValues(Astro.locals.membership?.role);
const coreValue = organization && runtime?.env?.DB
  ? await getCoreValue(runtime.env.DB, organization.id, valueId)
  : null;
const questions = organization && coreValue && runtime?.env?.DB
  ? await listQuestionsForCoreValue(runtime.env.DB, organization.id, valueId)
  : [];
const stats = {
  total: questions.length,
  active: questions.filter((question) => question.is_active === 1).length,
  inactive: questions.filter((question) => question.is_active === 0).length,
  hard: questions.filter((question) => question.difficulty === 'hard').length,
};
const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('success') || '';
---

<AppLayout title={`Question Bank - ${coreValue?.name || 'Core Value'}`} currentPath="/settings/values">
  <div class="mx-auto max-w-5xl space-y-6">
    {error && <DependencyAlert title="Question Bank gagal diproses" message={error} tone="danger" />}
    {success && <DependencyAlert title="Berhasil" message={success} tone="info" />}
    {!coreValue ? (
      <DependencyAlert title="Core value tidak ditemukan" message="Question Bank tidak tersedia atau berasal dari organisasi lain." actionHref="/settings/values" actionLabel="Kembali ke core values" tone="danger" />
    ) : (
      <>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6 mb-8">
          <div>
            <a href={`/settings/values/${valueId}`} class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-700 mb-3 transition-colors uppercase tracking-wider">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
              Kembali
            </a>
            <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">{coreValue.name}</p>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Question Bank</h1>
            <p class="text-slate-500 mt-1 text-sm leading-relaxed">Kelola pertanyaan yang digunakan randomizer challenge untuk core value ini.</p>
          </div>
          {allowed && (
            <div class="flex items-center gap-3 shrink-0">
              <a href={`/settings/values/${valueId}/questions/new`} class="btn-interactive inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m7-7H5"></path></svg>
                Tambah Question
              </a>
            </div>
          )}
        </div>

        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total</p><p class="mt-2 text-2xl font-bold text-slate-900">{stats.total}</p></div>
          <div class="rounded-xl border border-green-100 bg-green-50/60 p-4"><p class="text-xs font-semibold uppercase tracking-wider text-green-700">Active</p><p class="mt-2 text-2xl font-bold text-green-800">{stats.active}</p></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4"><p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Inactive</p><p class="mt-2 text-2xl font-bold text-slate-700">{stats.inactive}</p></div>
          <div class="rounded-xl border border-red-100 bg-red-50/60 p-4"><p class="text-xs font-semibold uppercase tracking-wider text-red-700">Hard</p><p class="mt-2 text-2xl font-bold text-red-800">{stats.hard}</p></div>
        </div>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <TableToolbar searchId="question-search" searchPlaceholder="Cari question atau rubric..." submitLabel={null}>
            <Fragment slot="filters">
              <label><span class="sr-only">Filter difficulty</span><select id="question-difficulty" class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"><option value="all">Semua difficulty</option><option value="easy">Easy</option><option value="medium">Medium</option><option value="hard">Hard</option></select></label>
              <label><span class="sr-only">Filter status</span><select id="question-status" class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"><option value="all">Semua status</option><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
            </Fragment>
          </TableToolbar>

          {questions.length > 0 ? (
            <>
              <div class="overflow-x-auto">
                <DataTable class="rounded-none border-0 shadow-none" tableClass="">
                <table class="w-full text-left text-sm">
                  <thead class="border-b border-slate-200 bg-white text-xs uppercase tracking-wider text-slate-400">
                    <tr>
                      <th class="px-6 py-3.5 font-semibold">Question & Rubric</th>
                      <th class="px-6 py-3.5 font-semibold">Difficulty</th>
                      <th class="px-6 py-3.5 font-semibold">Status</th>
                      <th class="px-6 py-3.5 font-semibold">Updated</th>
                      {allowed && <th class="px-6 py-3.5 text-right font-semibold">Action</th>}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {questions.map((question) => (
                      <tr data-question-row data-search={`${question.question_text} ${question.suggested_rubric_note || ''}`.toLowerCase()} data-difficulty={question.difficulty} data-status={question.is_active === 1 ? 'active' : 'inactive'} class="hover:bg-slate-50/70">
                        <td class="min-w-96 px-6 py-4">
                          <p class={`font-semibold ${question.is_active === 1 ? 'text-slate-900' : 'text-slate-500'}`}>{question.question_text}</p>
                          <p class="mt-1.5 line-clamp-2 text-xs leading-5 text-slate-500">{question.suggested_rubric_note || 'Belum ada panduan rubric.'}</p>
                        </td>
                        <td class="px-6 py-4"><span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold capitalize ${question.difficulty === 'easy' ? 'bg-green-50 text-green-700' : question.difficulty === 'medium' ? 'bg-amber-50 text-amber-700' : 'bg-red-50 text-red-700'}`}>{question.difficulty}</span></td>
                        <td class="px-6 py-4"><span class={`inline-flex items-center gap-1.5 text-xs font-semibold ${question.is_active === 1 ? 'text-green-700' : 'text-slate-500'}`}><span class={`h-1.5 w-1.5 rounded-full ${question.is_active === 1 ? 'bg-green-500' : 'bg-slate-400'}`}></span>{question.is_active === 1 ? 'Active' : 'Inactive'}</span></td>
                        <td class="whitespace-nowrap px-6 py-4 text-xs text-slate-500">{formatOrgDateTime(new Date(question.updated_at), organization?.timezone || 'Asia/Jakarta')}</td>
                        {allowed && (
                          <td class="px-6 py-4 flex justify-end">
                            <a href={`/settings/values/${valueId}/questions/${question.id}/edit`} title="Edit Question" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-slate-600 hover:bg-indigo-100 hover:text-indigo-800 transition-colors">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                            </a>
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
                </DataTable>
              </div>
              <div id="question-filter-empty" class="hidden px-6 py-12 text-center"><p class="font-semibold text-slate-900">Question tidak ditemukan</p><p class="mt-1 text-sm text-slate-500">Ubah kata pencarian atau filter yang dipilih.</p></div>
            </>
          ) : (
            <div class="px-6 py-16 text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-500"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.23 9a4 4 0 0 1 7.54 1.87c0 1.86-1.28 3.43-3 3.88-.46.12-.77.52-.77.99V16m0 3h.01"></path></svg></div>
              <p class="mt-4 font-semibold text-slate-900">Belum ada question</p>
              <p class="mt-1 text-sm text-slate-500">Tambahkan question pertama agar core value siap digunakan dalam challenge.</p>
              {allowed && <a href={`/settings/values/${valueId}/questions/new`} class="mt-5 inline-flex rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">Add Question</a>}
            </div>
          )}
        </section>
      </>
    )}
  </div>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#question-search');
    const difficultyInput = document.querySelector<HTMLInputElement>('#question-difficulty');
    const statusInput = document.querySelector<HTMLInputElement>('#question-status');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-question-row]'));
    const filterEmpty = document.querySelector<HTMLElement>('#question-filter-empty');
    const filterQuestions = () => {
      const query = searchInput?.value.trim().toLowerCase() || '';
      const difficulty = difficultyInput?.value || 'all';
      const status = statusInput?.value || 'all';
      let visible = 0;
      rows.forEach((row) => {
        const matches = (!query || (row.dataset.search || '').includes(query))
          && (difficulty === 'all' || row.dataset.difficulty === difficulty)
          && (status === 'all' || row.dataset.status === status);
        row.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });
      filterEmpty?.classList.toggle('hidden', visible > 0);
    };
    searchInput?.addEventListener('input', filterQuestions);
    difficultyInput?.addEventListener('change', filterQuestions);
    statusInput?.addEventListener('change', filterQuestions);
  </script>
</AppLayout>
