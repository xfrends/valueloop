---
import AppLayout from '../../../../layouts/AppLayout.astro';

// This is a UI prototype. In reality, you would fetch data by Astro.params.id
const id = 'val_1';
const valueData = {
  name: 'Ownership',
  shortDesc: 'Taking initiative beyond core duties.',
  fullDesc: 'Ownership means you act on behalf of the entire company, beyond just your team. You never say "that is not my job".',
  expectedBehaviors: '- Taking accountability for mistakes.\n- Proactively identifying problems and proposing solutions.',
  antiPatterns: '- Blaming others when a project fails.\n- Waiting to be told exactly what to do.',
  example: 'When the server went down on weekend, Budi from frontend team actively coordinated the incident response even though it was a backend issue.',
  color: 'emerald',
  sortOrder: 1,
  status: 'Active'
};
---

<AppLayout title={`Edit ${valueData.name} - ValueLoop`} currentPath="/settings/values">
  <div class="max-w-3xl mx-auto">
    
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <a href="/settings/values" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-emerald-600 mb-4 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Core Values
        </a>
        <h1 class="text-2xl font-bold text-slate-900">Edit: {valueData.name}</h1>
        <p class="text-slate-500 mt-1">Update information or manage the status of this core value.</p>
      </div>

      <div class="flex items-center gap-2">
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium rounded-full ${valueData.status === 'Active' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}`}>
          <span class={`w-2 h-2 rounded-full ${valueData.status === 'Active' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-500'}`}></span>
          {valueData.status}
        </span>
      </div>
    </div>

    <form class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8" onsubmit="event.preventDefault();">
      <div class="p-8 space-y-8">
        
        <!-- Basic Info Section -->
        <section class="space-y-6">
          <h2 class="text-lg font-semibold text-slate-900 border-b border-slate-100 pb-2">1. Basic Information</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2 md:col-span-2">
              <label class="block text-sm font-bold text-slate-900">Value Name <span class="text-red-500">*</span></label>
              <input type="text" value={valueData.name} class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow" />
            </div>

            <div class="space-y-2 md:col-span-2">
              <label class="block text-sm font-bold text-slate-900">Short Description <span class="text-red-500">*</span></label>
              <input type="text" value={valueData.shortDesc} class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow" />
            </div>

            <div class="space-y-2 md:col-span-2">
              <label class="block text-sm font-bold text-slate-900">Full Description</label>
              <textarea rows="3" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow">{valueData.fullDesc}</textarea>
            </div>
          </div>
        </section>

        <!-- Behaviors Section -->
        <section class="space-y-6">
          <h2 class="text-lg font-semibold text-slate-900 border-b border-slate-100 pb-2">2. Behaviors in Practice</h2>
          
          <div class="space-y-6">
            <div class="space-y-2">
              <label class="block text-sm font-bold text-emerald-700">Expected Behaviors</label>
              <textarea rows="3" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow">{valueData.expectedBehaviors}</textarea>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-bold text-red-700">Anti-patterns</label>
              <textarea rows="3" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow">{valueData.antiPatterns}</textarea>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-bold text-slate-900">Real-world Example</label>
              <textarea rows="2" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow">{valueData.example}</textarea>
            </div>
          </div>
        </section>

        <!-- Presentation Section -->
        <section class="space-y-6">
          <h2 class="text-lg font-semibold text-slate-900 border-b border-slate-100 pb-2">3. Presentation & Order</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="block text-sm font-bold text-slate-900">Theme Color</label>
              <select class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow bg-white">
                <option value="emerald" selected={valueData.color === 'emerald'}>Emerald</option>
                <option value="blue" selected={valueData.color === 'blue'}>Blue</option>
                <option value="amber" selected={valueData.color === 'amber'}>Amber</option>
                <option value="purple" selected={valueData.color === 'purple'}>Purple</option>
                <option value="rose" selected={valueData.color === 'rose'}>Rose</option>
                <option value="slate" selected={valueData.color === 'slate'}>Slate</option>
              </select>
            </div>

            <div class="space-y-2">
              <label class="block text-sm font-bold text-slate-900">Sort Order</label>
              <input type="number" min="0" value={valueData.sortOrder} class="w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-shadow" />
            </div>
          </div>
        </section>

      </div>

      <!-- Action Footer -->
      <div class="bg-slate-50 border-t border-slate-200 p-6 flex justify-end gap-3">
        <a href="/settings/values" class="px-6 py-2.5 rounded-lg font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition-colors">
          Cancel
        </a>
        <button type="button" class="px-6 py-2.5 rounded-lg font-medium text-white bg-slate-900 hover:bg-slate-800 transition-colors shadow-sm">
          Save Changes
        </button>
      </div>
    </form>

    <!-- Danger Zone for Soft Delete -->
    <div class="bg-white rounded-2xl border border-red-200 shadow-sm overflow-hidden">
      <div class="p-6 md:p-8">
        <h2 class="text-lg font-bold text-red-700 mb-2">Danger Zone</h2>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <p class="text-sm font-bold text-slate-900">Deactivate Core Value</p>
            <p class="text-sm text-slate-500 mt-1 max-w-xl">
              Deactivating this value means it will no longer appear in new daily challenges. 
              However, any existing history and past challenges related to this value will be kept safe.
            </p>
          </div>
          <button type="button" class="shrink-0 px-5 py-2.5 rounded-lg font-bold text-red-600 bg-red-50 border border-red-200 hover:bg-red-600 hover:text-white hover:border-red-600 transition-colors shadow-sm">
            Deactivate Value
          </button>
        </div>
      </div>
    </div>

  </div>
</AppLayout>
