---
import AppLayout from '../../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../../lib/cloudflare/bindings';
import { listQuestions } from '../../lib/services/questions';
import { listCoreValues } from '../../lib/services/values';

const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const questions = organization && runtime?.env?.DB ? await listQuestions(runtime.env.DB, organization.id) : [];
const coreValues = organization && runtime?.env?.DB ? await listCoreValues(runtime.env.DB, organization.id) : [];
---

<AppLayout title="Questions - ValueLoop" currentPath="/settings/questions">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Question Bank</h1>
      <p class="text-slate-500 mt-1">Manage active questions connected to each core value.</p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-slate-500">
            <tr>
              <th class="px-6 py-3 font-medium">Question</th>
              <th class="px-6 py-3 font-medium">Core Value</th>
              <th class="px-6 py-3 font-medium">Difficulty</th>
              <th class="px-6 py-3 font-medium">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {questions.map((question) => (
              <tr>
                <td class="px-6 py-4">
                  <div class="font-medium text-slate-900">{question.question_text}</div>
                  <div class="text-xs text-slate-500 mt-1">{question.suggested_rubric_note || 'Belum ada catatan rubrik.'}</div>
                </td>
                <td class="px-6 py-4">{question.core_value_name}</td>
                <td class="px-6 py-4 capitalize">{question.difficulty}</td>
                <td class="px-6 py-4">{question.is_active === 1 ? 'Active' : 'Inactive'}</td>
              </tr>
            ))}
            {!questions.length && (
              <tr>
                <td colspan="4" class="px-6 py-10 text-center text-slate-500">Belum ada pertanyaan.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
      <h2 class="font-bold text-slate-900 mb-4">Create Question</h2>
      <form method="post" action="/api/settings/questions" class="space-y-4">
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Core Value</label>
          <select name="coreValueId" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required>
            {coreValues.map((value) => (
              <option value={value.id}>{value.name}</option>
            ))}
          </select>
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Question</label>
          <textarea name="questionText" rows="4" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required></textarea>
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Difficulty</label>
          <select name="difficulty" class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Rubric Note</label>
          <textarea name="suggestedRubricNote" rows="3" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"></textarea>
        </div>
        <input type="hidden" name="isActive" value="1" />
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 text-white font-medium hover:bg-slate-800">Save Question</button>
      </form>
    </div>
  </div>
</AppLayout>
