---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = Astro.url.searchParams.get('email') || '';
const error = Astro.url.searchParams.get('error') || '';
const devOtp = Astro.url.searchParams.get('devOtp') || '';
---

<BaseLayout title="Verifikasi Email | ValueLoop">
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6">
    <a class="mb-8 text-lg font-semibold tracking-tight" href="/">ValueLoop</a>
    <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h1 class="text-2xl font-semibold tracking-tight">Verifikasi email</h1>
      <p class="mt-2 text-sm text-slate-500">Masukkan kode OTP 6 digit yang dikirim ke email Anda.</p>

      {error && (
        <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )}

      {devOtp && (
        <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Mode development: kode OTP adalah <strong>{devOtp}</strong>.
        </div>
      )}

      <form method="post" action="/api/auth/verify-email" class="mt-6 space-y-4">
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Email</label>
          <input name="email" type="email" value={email} class="w-full rounded-lg border border-slate-300 px-4 py-2.5 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Kode OTP</label>
          <input name="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-center text-xl tracking-[0.4em] outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" required />
        </div>
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 text-white font-medium hover:bg-slate-800">Verifikasi dan masuk</button>
      </form>

      <form method="post" action="/api/auth/resend-otp" class="mt-3">
        <input type="hidden" name="email" value={email} />
        <button type="submit" class="w-full rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Kirim ulang kode</button>
      </form>
    </section>
  </main>
</BaseLayout>
