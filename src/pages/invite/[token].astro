---
import BaseLayout from '../../layouts/BaseLayout.astro';

const token = Astro.params.token;
---

<BaseLayout title="Undangan Organisasi | ValueLoop">
  <main class="mx-auto flex min-h-screen w-full max-w-xl flex-col justify-center px-6">
    <section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-800">Undangan</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Gabung ke organisasi</h1>
      <p class="mt-3 text-slate-600">Klik tombol di bawah untuk menerima undangan dan masuk ke workspace organisasi.</p>

      <form method="post" action={`/api/invitations/${token}/accept`} class="mt-8">
        <button type="submit" class="w-full rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-800">
          Terima Undangan
        </button>
      </form>
    </section>
  </main>
</BaseLayout>
