---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Notifikasi | ValueLoop" currentPath="/notifications">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div><p class="text-sm font-medium text-indigo-600">Inbox</p><h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Notifikasi</h1><p class="mt-2 text-sm text-slate-500">Aktivitas penting dari organisasi Anda.</p></div>
    <button id="notifications-read-all" type="button" class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:border-indigo-300 hover:text-indigo-700">Tandai semua dibaca</button>
  </div>
  <div class="mt-6 flex gap-2" role="tablist"><button data-notification-filter="all" class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Semua</button><button data-notification-filter="unread" class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-600 ring-1 ring-slate-200">Belum dibaca</button></div>
  <div id="notifications-list" class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white"><p class="p-8 text-center text-sm text-slate-500">Memuat notifikasi...</p></div>
  <script>
    // @ts-nocheck
    const list = document.querySelector('#notifications-list'); let filter = 'all';
    const load = async () => { const response = await fetch(`/api/notifications?limit=50&unread=${filter === 'unread'}`); const data = await response.json(); const rows = data.notifications || []; list.innerHTML = rows.length ? rows.map((n) => `<a data-notification-id="${n.id}" href="${n.entity_id ? '/challenge' : '/notifications'}" class="block p-5 hover:bg-slate-50 ${n.read_at ? '' : 'bg-indigo-50/40'}"><div class="flex items-start justify-between gap-4"><div><p class="text-sm font-semibold text-slate-900">${n.title}</p><p class="mt-1 text-sm text-slate-600">${n.message}</p><p class="mt-2 text-xs text-slate-400">${new Date(n.created_at).toLocaleString('id-ID')}</p></div>${n.read_at ? '' : '<span class="mt-1 h-2 w-2 flex-none rounded-full bg-indigo-600"></span>'}</div></a>`).join('') : '<p class="p-10 text-center text-sm text-slate-500">Belum ada notifikasi.</p>'; list.querySelectorAll('[data-notification-id]').forEach((item) => item.addEventListener('click', () => fetch(`/api/notifications/${item.dataset.notificationId}/read`, { method: 'POST' }))); };
    document.querySelector('#notifications-read-all')?.addEventListener('click', async () => { await fetch('/api/notifications/read-all', { method: 'POST' }); await load(); });
    document.querySelectorAll('[data-notification-filter]').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.notificationFilter; load(); })); load();
  </script>
</AppLayout>
