---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';
import { parseJsonRecord } from '../lib/utils/form-errors';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;
const error = Astro.url.searchParams.get('error') || '';
const fieldErrors = parseJsonRecord(Astro.url.searchParams.get('fieldErrors'));
const fullName = Astro.url.searchParams.get('fullName') || '';
const email = Astro.url.searchParams.get('email') || '';

const inputClass = (field: string) =>
  `w-full rounded-lg px-4 py-2.5 outline-none focus:ring-1 ${fieldErrors[field] ? 'border border-red-300 focus:border-red-500 focus:ring-red-500' : 'border border-slate-300 focus:border-emerald-500 focus:ring-emerald-500'}`;
---

<BaseLayout title="Buat Akun | ValueLoop">
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6">
    <a class="mb-8 text-lg font-semibold tracking-tight" href="/">ValueLoop</a>
    <section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
      <h1 class="text-2xl font-semibold tracking-tight">Buat akun</h1>
      <p class="mt-2 text-sm text-slate-500">Daftar dengan Google disarankan. Email/password tetap tersedia dengan verifikasi OTP.</p>
      {!bootstrapReady && (
        <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Instalasi awal harus selesai lewat <code class="font-semibold">npm run setup</code> sebelum pendaftaran akun lewat web dibuka.
        </div>
      )}
      {error && (
        <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          {error}
        </div>
      )}
      <a href="/api/auth/google/start" class={`mt-6 flex w-full items-center justify-center gap-3 rounded-lg border border-slate-300 bg-white px-4 py-2.5 font-medium text-slate-800 shadow-sm hover:bg-slate-50 ${bootstrapReady ? '' : 'opacity-50 pointer-events-none'}`}>
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white text-sm font-bold text-blue-600">G</span>
        Lanjutkan dengan Google
      </a>
      <div class="my-6 flex items-center gap-3">
        <div class="h-px flex-1 bg-slate-200"></div>
        <span class="text-xs font-medium uppercase tracking-wider text-slate-400">atau email</span>
        <div class="h-px flex-1 bg-slate-200"></div>
      </div>
      <form method="post" action="/api/auth/signup" class={`mt-6 space-y-4 ${bootstrapReady ? '' : 'opacity-50 pointer-events-none'}`}>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Nama Lengkap</label>
          <input
            name="fullName"
            type="text"
            value={fullName}
            aria-invalid={fieldErrors.fullName ? 'true' : 'false'}
            class={inputClass('fullName')}
          />
          {fieldErrors.fullName && <p class="text-sm text-red-600">{fieldErrors.fullName}</p>}
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Email</label>
          <input
            name="email"
            type="email"
            value={email}
            aria-invalid={fieldErrors.email ? 'true' : 'false'}
            class={inputClass('email')}
          />
          {fieldErrors.email && <p class="text-sm text-red-600">{fieldErrors.email}</p>}
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700">Kata Sandi</label>
          <input
            name="password"
            type="password"
            aria-invalid={fieldErrors.password ? 'true' : 'false'}
            class={inputClass('password')}
          />
          {fieldErrors.password && <p class="text-sm text-red-600">{fieldErrors.password}</p>}
        </div>
        <div class="space-y-2">
          <label class="flex items-start gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
            <input
              name="termsAccepted"
              type="checkbox"
              value="on"
              required
              aria-invalid={fieldErrors.termsAccepted ? 'true' : 'false'}
              class="mt-0.5 h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
            />
            <span>
              Saya setuju dengan <a href="/terms" class="font-medium text-emerald-700 hover:text-emerald-800">Syarat & Ketentuan</a> dan <a href="/privacy" class="font-medium text-emerald-700 hover:text-emerald-800">Kebijakan Privasi</a>.
            </span>
          </label>
          {fieldErrors.termsAccepted && <p class="text-sm text-red-600">{fieldErrors.termsAccepted}</p>}
        </div>
        <button type="submit" class="w-full rounded-lg bg-slate-900 px-4 py-2.5 text-white font-medium hover:bg-slate-800">Buat akun dan kirim OTP</button>
      </form>
      <p class="mt-6 text-center text-xs text-slate-500">
        Dengan mendaftar, Anda menyetujui <a href="/terms" class="underline hover:text-slate-800">Syarat & Ketentuan</a> dan <a href="/privacy" class="underline hover:text-slate-800">Kebijakan Privasi</a> kami.
      </p>
      <p class="mt-4 text-center text-sm text-slate-500">Sudah punya akun? <a href="/login" class="font-medium text-emerald-700 hover:text-emerald-800">Masuk</a></p>
    </section>
  </main>
</BaseLayout>
