---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';
import { parseJsonRecord } from '../lib/utils/form-errors';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;
const googleReady = Boolean(runtime?.env?.GOOGLE_CLIENT_ID);
const error = Astro.url.searchParams.get('error') || '';
const fieldErrors = parseJsonRecord(Astro.url.searchParams.get('fieldErrors'));
const fullName = Astro.url.searchParams.get('fullName') || '';
const email = Astro.url.searchParams.get('email') || '';
---

<BaseLayout title="Buat Akun | ValueLoop">
  <main class="flex min-h-screen w-full bg-white">
    <!-- Bagian Kiri: Form Area -->
    <div class="flex flex-1 flex-col justify-center px-6 py-12 lg:flex-none lg:w-[500px] xl:w-[600px] xl:px-20 z-10 bg-white">
      <div class="mx-auto w-full max-w-sm lg:w-full">
        <!-- Brand / Back to Home -->
        <a class="flex items-center gap-3 group mb-10 w-max" href="/">
          <div class="w-10 h-10 rounded-xl bg-[#0F172A] border border-slate-700 flex items-center justify-center text-white font-bold text-xl shadow-sm transition-transform duration-200 group-active:scale-95">
            V
          </div>
          <span class="text-xl font-bold tracking-tight text-[#0F172A]">ValueLoop</span>
        </a>

        <!-- Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold tracking-tight text-[#0F172A]">Buat Akun</h1>
          <p class="mt-2 text-[15px] text-[#64748B]">Daftar dan mulai transformasi budaya kerja.</p>
        </div>

        {!bootstrapReady && (
          <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-[14px] text-amber-900 shadow-sm">
            Instalasi awal harus selesai lewat <code class="font-semibold bg-amber-100 px-1 py-0.5 rounded">npm run setup</code> sebelum pendaftaran akun lewat web dibuka.
          </div>
        )}
        {bootstrapReady && !googleReady && (
          <div role="alert" class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-[14px] text-amber-900 shadow-sm">
            <p class="font-semibold">Pendaftaran Google belum tersedia</p>
            <p class="mt-1 opacity-90">GOOGLE_CLIENT_ID belum dikonfigurasi. Silakan daftar dengan email.</p>
          </div>
        )}
        {error && (
          <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[14px] text-red-700 shadow-sm">
            {error}
          </div>
        )}

        <!-- Google SSO -->
        <a href="/api/auth/google/start" aria-disabled={!bootstrapReady || !googleReady ? 'true' : 'false'} class={`btn-interactive flex w-full items-center justify-center gap-3 rounded-xl border border-[#DCE4F0] bg-white px-4 py-3 font-semibold text-[#0F172A] shadow-sm hover:bg-[#F8FAFC] hover:border-[#CBD5E1] transition-all ${bootstrapReady && googleReady ? '' : 'opacity-50 pointer-events-none'}`}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Lanjutkan dengan Google
        </a>

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-[#DCE4F0]"></div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#64748B]">Atau Email</span>
          <div class="h-px flex-1 bg-[#DCE4F0]"></div>
        </div>

        <form method="post" action="/api/auth/signup" class={`space-y-4 ${bootstrapReady ? '' : 'opacity-50 pointer-events-none'}`}>
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Nama Lengkap</label>
            <input
              name="fullName"
              type="text"
              value={fullName}
              placeholder="John Doe"
              aria-invalid={fieldErrors.fullName ? 'true' : 'false'}
              class={`w-full rounded-xl bg-[#F6F8FB] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:ring-2 ${fieldErrors.fullName ? 'border border-red-300 focus:border-red-500 focus:ring-red-500/20' : 'border border-[#DCE4F0] focus:border-[#0F172A] focus:ring-slate-900/10'}`}
            />
            {fieldErrors.fullName && <p class="text-sm text-red-600 font-medium">{fieldErrors.fullName}</p>}
          </div>
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Alamat Email</label>
            <input
              name="email"
              type="email"
              value={email}
              placeholder="nama@perusahaan.com"
              aria-invalid={fieldErrors.email ? 'true' : 'false'}
              class={`w-full rounded-xl bg-[#F6F8FB] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:ring-2 ${fieldErrors.email ? 'border border-red-300 focus:border-red-500 focus:ring-red-500/20' : 'border border-[#DCE4F0] focus:border-[#0F172A] focus:ring-slate-900/10'}`}
            />
            {fieldErrors.email && <p class="text-sm text-red-600 font-medium">{fieldErrors.email}</p>}
          </div>
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Kata Sandi</label>
            <input
              name="password"
              type="password"
              placeholder="Min. 8 karakter"
              aria-invalid={fieldErrors.password ? 'true' : 'false'}
              class={`w-full rounded-xl bg-[#F6F8FB] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:ring-2 ${fieldErrors.password ? 'border border-red-300 focus:border-red-500 focus:ring-red-500/20' : 'border border-[#DCE4F0] focus:border-[#0F172A] focus:ring-slate-900/10'}`}
            />
            {fieldErrors.password && <p class="text-sm text-red-600 font-medium">{fieldErrors.password}</p>}
          </div>
          
          <div class="pt-2 pb-1">
            <label class="flex items-start gap-3 rounded-xl border border-[#DCE4F0] bg-[#F6F8FB] px-4 py-3 text-[14px] text-[#0F172A] cursor-pointer group hover:bg-[#F8FAFC] transition-colors">
              <div class="relative flex items-center mt-0.5">
                <input
                  name="termsAccepted"
                  type="checkbox"
                  value="on"
                  required
                  aria-invalid={fieldErrors.termsAccepted ? 'true' : 'false'}
                  class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-[#DCE4F0] bg-white checked:border-[#0F172A] checked:bg-[#0F172A] focus:outline-none focus:ring-2 focus:ring-slate-900/10 transition-all"
                />
                <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-3.5 w-3.5 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="leading-relaxed text-[#64748B]">
                Saya setuju dengan <a href="/terms" class="font-semibold text-[#0F172A] hover:underline underline-offset-4">Syarat & Ketentuan</a> dan <a href="/privacy" class="font-semibold text-[#0F172A] hover:underline underline-offset-4">Kebijakan Privasi</a>.
              </span>
            </label>
            {fieldErrors.termsAccepted && <p class="mt-2 text-sm text-red-600 font-medium">{fieldErrors.termsAccepted}</p>}
          </div>
          
          <button type="submit" class="btn-interactive mt-2 w-full rounded-xl bg-[#0F172A] px-4 py-3 text-white font-semibold shadow-xl shadow-slate-900/10 hover:bg-[#1E293B]">Daftar dan Kirim OTP</button>
        </form>
        
        <p class="mt-8 text-center text-[15px] text-[#64748B]">Sudah punya akun? <a href="/login" class="font-semibold text-[#0F172A] hover:underline underline-offset-4">Masuk ke sistem</a></p>
      </div>
    </div>

    <!-- Bagian Kanan: Ilustrasi Visual -->
    <div class="relative hidden lg:flex lg:flex-1 bg-[#F8FAFC] border-l border-[#DCE4F0] overflow-hidden items-center justify-center">
      <!-- Pola Titik (Dot Pattern) yang rapi -->
      <div class="absolute inset-0 pattern-dots opacity-40"></div>
      
      <div class="relative z-10 w-full max-w-lg p-10 flex flex-col items-start">
        <div class="inline-flex items-center gap-2.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-[13px] font-semibold tracking-wide text-slate-700 mb-6 shadow-sm">
          Ubah kebiasaan, ubah hasil
        </div>
        
        <h2 class="text-4xl font-bold tracking-tight text-[#0F172A] mb-4 leading-tight">
          Langkah pertama menuju <br />tim yang berprestasi.
        </h2>
        <p class="text-[#64748B] text-lg leading-relaxed mb-12">
          Ciptakan lingkungan kerja yang lebih produktif, positif, dan selaras dengan nilai-nilai fundamental perusahaan Anda.
        </p>

        <!-- Dummy UI Card as Illustration -->
        <div class="w-full rounded-[24px] bg-white border border-slate-200 p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] -rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200">
                <svg class="h-5 w-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              </div>
              <div>
                <div class="font-bold text-[#0F172A]">Budi Santoso</div>
                <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Top Leaderboard</div>
              </div>
            </div>
            <div class="text-2xl font-black text-[#0F172A]">1,250 <span class="text-sm font-medium text-[#64748B] uppercase">PTS</span></div>
          </div>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <div class="h-2 w-2 rounded-full bg-slate-800"></div>
              <div class="h-2 w-full rounded-full bg-slate-100">
                <div class="h-full w-[85%] rounded-full bg-slate-800"></div>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="h-2 w-2 rounded-full bg-slate-400"></div>
              <div class="h-2 w-full rounded-full bg-slate-100">
                <div class="h-full w-[65%] rounded-full bg-slate-400"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <style>
    .pattern-dots {
      background-image: radial-gradient(#CBD5E1 1px, transparent 1px);
      background-size: 24px 24px;
    }
  </style>
</BaseLayout>
