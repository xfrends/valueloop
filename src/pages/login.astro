---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';
import { parseJsonRecord } from '../lib/utils/form-errors';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;
const googleReady = Boolean(runtime?.env?.GOOGLE_CLIENT_ID);
const error = Astro.url.searchParams.get('error') || '';
const alertType = Astro.url.searchParams.get('alert') || 'credentials';
const fieldErrors = parseJsonRecord(Astro.url.searchParams.get('fieldErrors'));
const email = Astro.url.searchParams.get('email') || '';
const rememberMe = Astro.url.searchParams.get('rememberMe') === '1';
const isEmailUnverified = alertType === 'email_unverified';
const alertTitle =
  alertType === 'validation'
    ? 'Data login belum lengkap'
    : alertType === 'email_unverified'
      ? 'Email belum diverifikasi'
      : alertType === 'system'
        ? 'Layanan login bermasalah'
        : alertType === 'session'
          ? 'Sesi berakhir'
        : 'Login gagal';
const verifyEmailHref = `/verify-email?email=${encodeURIComponent(email)}`;
---

<BaseLayout title="Masuk | ValueLoop">
  <main class="flex min-h-screen w-full bg-white">
    <!-- Bagian Kiri: Form Area -->
    <div class="flex flex-1 flex-col justify-center px-6 py-12 lg:flex-none lg:w-[500px] xl:w-[600px] xl:px-20 z-10 bg-white">
      <div class="mx-auto w-full max-w-sm lg:w-full">
        <!-- Brand / Back to Home -->
        <a class="flex items-center gap-3 group mb-10 w-max" href="/">
          <div class="w-10 h-10 rounded-xl bg-[#0F172A] border border-slate-700 flex items-center justify-center text-white font-bold text-xl shadow-sm transition-transform duration-200 group-active:scale-95">
            V
          </div>
          <span class="text-xl font-bold tracking-tight text-[#0F172A]">ValueLoop</span>
        </a>
        
        <!-- Header -->
        <div class="mb-8">
          <h1 class="text-3xl font-bold tracking-tight text-[#0F172A]">Masuk</h1>
          <p class="mt-2 text-[15px] text-[#64748B]">Masuk ke akun Anda untuk melanjutkan perjalanan.</p>
        </div>

        {!bootstrapReady && (
          <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-[14px] text-amber-900 shadow-sm">
            Instalasi belum disiapkan. Jalankan <code class="font-semibold bg-amber-100 px-1 py-0.5 rounded">npm run setup</code> dari terminal terlebih dahulu.
          </div>
        )}
        {bootstrapReady && !googleReady && (
          <div role="alert" class="mb-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-[14px] text-amber-900 shadow-sm">
            <p class="font-semibold">Login Google belum tersedia</p>
            <p class="mt-1 opacity-90">GOOGLE_CLIENT_ID belum dikonfigurasi. Silakan masuk dengan email.</p>
          </div>
        )}
        {error && (
          <div
            role="alert"
            aria-live="assertive"
            class={`mb-6 rounded-xl border px-4 py-3 text-[14px] shadow-sm ${isEmailUnverified ? 'border-amber-200 bg-amber-50 text-amber-900' : 'border-red-200 bg-red-50 text-red-700'}`}
          >
            <p class="font-semibold">{alertTitle}</p>
            <p class="mt-1 opacity-90">{error}</p>
            {isEmailUnverified && (
              <a
                href={verifyEmailHref}
                class="mt-3 btn-interactive inline-flex rounded-lg bg-amber-600 px-4 py-2 font-semibold text-white hover:bg-amber-700 text-sm"
              >
                Verifikasi email
              </a>
            )}
          </div>
        )}

        <!-- Google SSO -->
        <a href="/api/auth/google/start" aria-disabled={!bootstrapReady || !googleReady ? 'true' : 'false'} class={`btn-interactive flex w-full items-center justify-center gap-3 rounded-xl border border-[#DCE4F0] bg-white px-4 py-3 font-semibold text-[#0F172A] shadow-sm hover:bg-[#F8FAFC] hover:border-[#CBD5E1] transition-all ${bootstrapReady && googleReady ? '' : 'opacity-50 pointer-events-none'}`}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Lanjutkan dengan Google
        </a>

        <div class="my-6 flex items-center gap-3">
          <div class="h-px flex-1 bg-[#DCE4F0]"></div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#64748B]">Atau Email</span>
          <div class="h-px flex-1 bg-[#DCE4F0]"></div>
        </div>

        <form method="post" action="/api/auth/login" class={`space-y-4 ${bootstrapReady ? '' : 'opacity-50 pointer-events-none'}`}>
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Alamat Email</label>
            <input
              id="email"
              name="email"
              type="email"
              value={email}
              autocomplete="email"
              placeholder="nama@perusahaan.com"
              aria-invalid={fieldErrors.email ? 'true' : 'false'}
              aria-describedby={fieldErrors.email ? 'email-error' : undefined}
              class={`w-full rounded-xl bg-[#F6F8FB] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:ring-2 ${fieldErrors.email ? 'border border-red-300 focus:border-red-500 focus:ring-red-500/20' : 'border border-[#DCE4F0] focus:border-[#0F172A] focus:ring-slate-900/10'}`}
            />
            {fieldErrors.email && <p id="email-error" class="text-sm text-red-600 font-medium">{fieldErrors.email}</p>}
          </div>
          <div class="space-y-1.5">
            <label class="text-[14px] font-semibold text-[#0F172A]">Kata Sandi</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="••••••••"
              aria-invalid={fieldErrors.password ? 'true' : 'false'}
              aria-describedby={fieldErrors.password ? 'password-error' : undefined}
              class={`w-full rounded-xl bg-[#F6F8FB] px-4 py-3 outline-none transition-all placeholder:text-slate-400 focus:bg-white focus:ring-2 ${fieldErrors.password ? 'border border-red-300 focus:border-red-500 focus:ring-red-500/20' : 'border border-[#DCE4F0] focus:border-[#0F172A] focus:ring-slate-900/10'}`}
            />
            {fieldErrors.password && <p id="password-error" class="text-sm text-red-600 font-medium">{fieldErrors.password}</p>}
          </div>
          <div class="pt-2">
            <label class="flex items-center gap-3 text-[14px] text-[#64748B] cursor-pointer group w-max">
              <div class="relative flex items-center">
                <input
                  name="rememberMe"
                  type="checkbox"
                  value="on"
                  checked={rememberMe}
                  class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-[#DCE4F0] bg-[#F6F8FB] checked:border-[#0F172A] checked:bg-[#0F172A] focus:outline-none focus:ring-2 focus:ring-slate-900/20 transition-all"
                />
                <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-3.5 w-3.5 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="font-medium group-hover:text-[#0F172A] transition-colors">Ingat saya selama 1 bulan</span>
            </label>
          </div>
          <button type="submit" class="btn-interactive mt-4 w-full rounded-xl bg-[#0F172A] px-4 py-3 text-white font-semibold shadow-xl shadow-slate-900/10 hover:bg-[#1E293B]">Masuk ke Akun</button>
        </form>
        
        <p class="mt-8 text-center text-[15px] text-[#64748B]">Belum punya akun? <a href="/signup" class="font-semibold text-[#0F172A] hover:underline underline-offset-4">Buat akun baru</a></p>
      </div>
    </div>

    <!-- Bagian Kanan: Ilustrasi Visual Bersih -->
    <div class="relative hidden lg:flex lg:flex-1 bg-[#F8FAFC] border-l border-[#DCE4F0] overflow-hidden items-center justify-center">
      <!-- Pola Titik (Dot Pattern) yang rapi -->
      <div class="absolute inset-0 pattern-dots opacity-40"></div>
      
      <div class="relative z-10 w-full max-w-lg p-10 flex flex-col items-start">
        <div class="inline-flex items-center gap-2.5 rounded-full border border-slate-200 bg-white px-4 py-1.5 text-[13px] font-semibold tracking-wide text-slate-700 mb-6 shadow-sm">
          Sistem Cloud Multi-tenant
        </div>
        
        <h2 class="text-4xl font-bold tracking-tight text-[#0F172A] mb-4 leading-tight">
          Pusat kendali <br />budaya kerja tim Anda.
        </h2>
        <p class="text-[#64748B] text-lg leading-relaxed mb-12">
          Lacak performa nilai perusahaan, bangun interaksi yang lebih baik, dan dapatkan analisis transparan.
        </p>

        <!-- Dummy UI Card as Illustration (Clean Border) -->
        <div class="w-full rounded-[24px] bg-white border border-slate-200 p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="flex items-center gap-4 mb-5">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-50 text-slate-700 border border-slate-200">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <div class="text-[13px] font-semibold text-slate-500 uppercase tracking-wide">Tantangan AI Terjawab</div>
              <div class="font-bold text-[#0F172A] text-lg">Skor Rata-rata: 9.4</div>
            </div>
          </div>
          <div class="space-y-3">
            <div class="h-3 w-3/4 rounded-full bg-slate-100"></div>
            <div class="h-3 w-1/2 rounded-full bg-slate-100"></div>
            <div class="h-3 w-5/6 rounded-full bg-slate-100"></div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <style>
    .pattern-dots {
      background-image: radial-gradient(#CBD5E1 1px, transparent 1px);
      background-size: 24px 24px;
    }
  </style>
</BaseLayout>
