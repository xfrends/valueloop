  <script>
    function initRevealAnimations() {
      const elements = document.querySelectorAll('.reveal, .reveal-scale, .reveal-left, .reveal-right');
      if (!elements.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elements.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      elements.forEach((el) => observer.observe(el));
    }

    function initHeroTypewriter() {
      const input = document.querySelector<HTMLInputElement>('#hero-question');
      if (!input || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const prompts = [
        'Ceritakan momen kamu menolong customer tanpa diminta',
        'Kapan terakhir kamu mengambil ownership penuh?',
        'Apa satu hal yang kamu perbaiki minggu ini?',
      ];
      let promptIndex = 0;
      let charIndex = 0;
      let deleting = false;
      const tick = () => {
        const text = prompts[promptIndex];
        charIndex += deleting ? -1 : 1;
        input.placeholder = `${text.slice(0, charIndex)}|`;
        let delay = deleting ? 28 : 55;
        if (!deleting && charIndex === text.length) { deleting = true; delay = 1800; }
        if (deleting && charIndex === 0) { deleting = false; promptIndex = (promptIndex + 1) % prompts.length; delay = 400; }
        window.setTimeout(tick, delay);
      };
      tick();
    }

    // Generic tab switcher: buttons carry data-<name>-tab, panels carry data-<name>-panel.
    function initTabs(name: string, onChange?: (key: string) => void) {
      const tabs = document.querySelectorAll<HTMLElement>(`[data-${name}-tab]`);
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const key = tab.getAttribute(`data-${name}-tab`) ?? '';
        tabs.forEach((other) => other.setAttribute('aria-selected', String(other === tab)));
        document.querySelectorAll<HTMLElement>(`[data-${name}-panel]`).forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute(`data-${name}-panel`) !== key);
        });
        onChange?.(key);
      }));
    }

    function initCarousel() {
      const track = document.querySelector<HTMLElement>('[data-carousel]');
      const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !prev || !next) return;
      const step = () => (track.querySelector('article')?.clientWidth ?? 400) + 10;
      const sync = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', sync, { passive: true });
      sync();
    }

    // Scroll-pinned hero (desktop only): the values frame swings off its nail and falls to the floor,
    // then the product motion grows out of the spot where the frame hung (FLIP from the frame's rect).
    // Below 1024px the hero is static and the video simply autoplays (muted) while on screen.
    // Keep this query in sync with the hero sequence media query in global.css.
    const HERO_SEQUENCE_QUERY = '(prefers-reduced-motion: no-preference) and (min-width: 1024px)';

    function initHeroSequence() {
      const wrapper = document.querySelector<HTMLElement>('[data-hero-scroll]');
      const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
      const fall = document.querySelector<HTMLElement>('[data-hero-fall]');
      const media = document.querySelector<HTMLElement>('[data-hero-media]');
      if (!wrapper || !stage || !fall || !media) return;
      const video = media.querySelector<HTMLVideoElement>('[data-hero-video]');
      const soundButton = media.querySelector<HTMLButtonElement>('[data-hero-sound]');

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // No scroll sequence and no autoplay: let the viewer start the motion themselves.
        if (video) video.controls = true;
        soundButton?.classList.add('hidden');
        return;
      }

      if (video && soundButton) {
        soundButton.addEventListener('click', () => {
          video.muted = !video.muted;
          const on = !video.muted;
          soundButton.setAttribute('aria-pressed', String(on));
          soundButton.setAttribute('aria-label', on ? 'Matikan suara' : 'Nyalakan suara');
          soundButton.querySelector('[data-icon-muted]')?.classList.toggle('hidden', on);
          soundButton.querySelector('[data-icon-sound]')?.classList.toggle('hidden', !on);
          const label = soundButton.querySelector('[data-sound-label]');
          if (label) label.textContent = on ? 'Bisukan' : 'Suara';
          if (on && video.paused) video.play().catch(() => {});
        });
      }

      const copy = document.querySelector<HTMLElement>('[data-hero-copy]');
      const plaque = document.querySelector<HTMLElement>('[data-hero-plaque]');
      const nail = document.querySelector<HTMLElement>('[data-hero-nail]');
      const hint = document.querySelector<HTMLElement>('[data-hero-hint]');
      const floor = stage.querySelector<HTMLElement>('.hero-floor');
      const animated = [fall, media, copy, plaque, nail, hint].filter((el): el is HTMLElement => !!el);

      const clamp = (v: number, min = 0, max = 1) => Math.min(max, Math.max(min, v));
      const range = (p: number, start: number, end: number) => clamp((p - start) / (end - start));
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      const easeIn = (t: number) => t * t;

      // Geometry measured with transforms cleared, relative to the stage.
      let dropY = 0;
      let flip = { x: 0, y: 0, s: 0.3 };
      const measure = () => {
        fall.style.transform = '';
        media.style.transform = '';
        const frameRect = fall.getBoundingClientRect();
        const mediaRect = media.getBoundingClientRect();
        const floorTop = floor ? floor.getBoundingClientRect().top : window.innerHeight * 0.8;
        // Land with the frame's bottom edge just past the skirting board.
        dropY = Math.max(0, floorTop + 18 - frameRect.bottom);
        flip = {
          x: frameRect.left + frameRect.width / 2 - (mediaRect.left + mediaRect.width / 2),
          y: frameRect.top + frameRect.height / 2 - (mediaRect.top + mediaRect.height / 2),
          s: frameRect.width / mediaRect.width,
        };
      };

      const progress = () => {
        const rect = wrapper.getBoundingClientRect();
        return clamp(-rect.top / Math.max(1, rect.height - window.innerHeight));
      };

      let playing = false;
      const render = (p: number) => {
        // Swing around the nail (0.03–0.24), then fall with gravity and a small bounce (0.24–0.52).
        const swing = range(p, 0.03, 0.24);
        const angleSwing = Math.sin(swing * Math.PI * 2) * 4 * (1 - swing * 0.4);
        const drop = range(p, 0.24, 0.44);
        const bounce = range(p, 0.44, 0.52);
        const y = easeIn(drop) * dropY - Math.sin(bounce * Math.PI) * 12;
        const angle = angleSwing + easeIn(drop) * 8;
        fall.style.transform = `translate3d(0, ${y}px, 0) rotate(${angle}deg)`;
        fall.style.opacity = String(1 - range(p, 0.5, 0.6));

        const fade = range(p, 0.2, 0.42);
        if (copy) {
          copy.style.opacity = String(1 - fade);
          copy.style.transform = `translate3d(0, ${-24 * fade}px, 0)`;
        }
        if (plaque) plaque.style.opacity = String(1 - range(p, 0.16, 0.3));
        if (nail) nail.style.opacity = String(1 - range(p, 0.52, 0.62));
        if (hint) hint.style.opacity = String(1 - range(p, 0, 0.04));

        // Media grows out of the frame's original spot (0.42–0.86), fading in on the way.
        const grow = easeInOut(range(p, 0.42, 0.86));
        const scale = lerp(flip.s, 1, grow);
        media.style.transform = `translate3d(${lerp(flip.x, 0, grow)}px, ${lerp(flip.y, 0, grow)}px, 0) scale(${scale})`;
        media.style.opacity = String(range(p, 0.42, 0.52));
        media.style.pointerEvents = p > 0.8 ? 'auto' : 'none';

        if (video) {
          const shouldPlay = p > 0.44;
          if (shouldPlay !== playing) {
            playing = shouldPlay;
            if (shouldPlay) {
              // The motion tells a story from its first frame, so restart it each time it grows in.
              video.currentTime = 0;
              video.play().catch(() => {});
            }
            else video.pause();
          }
        }
      };

      // Ease the rendered progress toward the scroll position so fast flicks still read as motion.
      let current = 0;
      let frame = 0;
      let settleTimer = 0;
      const tick = () => {
        const target = progress();
        current += (target - current) * 0.12;
        if (Math.abs(target - current) < 0.0005) current = target;
        render(current);
        frame = current === target ? 0 : requestAnimationFrame(tick);
      };
      const schedule = () => { if (!frame) frame = requestAnimationFrame(tick); };
      const remeasure = () => { measure(); render(current); };

      const startSequence = () => {
        current = progress();
        playing = false;
        if (video) video.pause();
        remeasure();
        // The hero load animation shifts the frame for ~1s; measure again once it settles.
        settleTimer = window.setTimeout(remeasure, 1000);
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', remeasure);
      };
      const stopSequence = () => {
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', remeasure);
        window.clearTimeout(settleTimer);
        cancelAnimationFrame(frame);
        frame = 0;
        for (const el of animated) el.removeAttribute('style');
      };

      // Static hero: autoplay the muted motion only while it is on screen.
      let observer: IntersectionObserver | null = null;
      const startStatic = () => {
        if (!video) return;
        observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        }, { threshold: 0.35 });
        observer.observe(video);
      };
      const stopStatic = () => {
        observer?.disconnect();
        observer = null;
      };

      const sequenceQuery = window.matchMedia(HERO_SEQUENCE_QUERY);
      const apply = () => {
        if (sequenceQuery.matches) { stopStatic(); startSequence(); }
        else { stopSequence(); startStatic(); }
      };
      apply();
      sequenceQuery.addEventListener('change', apply);
    }

    initRevealAnimations();
    initHeroSequence();
    initHeroTypewriter();
    initCarousel();
    initTabs('engine');
    initTabs('role');
    initTabs('chart', (key) => {
      document.querySelectorAll<SVGGElement>('[data-chart-line]').forEach((line) => {
        line.classList.toggle('hidden', line.dataset.chartLine !== key);
      });
      const withValueLoop = key === 'with';
      const participation = document.querySelector('[data-chart-stat="participation"]');
      const score = document.querySelector('[data-chart-stat="score"]');
      if (participation) participation.textContent = withValueLoop ? '86%' : '18%';
      if (score) score.textContent = withValueLoop ? '8,4' : '—';
    });
  </script>
</BaseLayout>
