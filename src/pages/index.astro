---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;
---

<BaseLayout
  title="ValueLoop - Ubah Core Value Menjadi Kebiasaan Tim Setiap Hari"
  description="Platform SaaS untuk menghidupkan core value perusahaan lewat daily reflection challenge, scoring berbasis contoh nyata, leaderboard, dan insight otomatis."
>
  <!-- Mark js-ready synchronously before first paint to prevent layout flashes -->
  <script is:inline>document.documentElement.classList.add('js-ready');</script>

  <!-- Ambient background glow layers (GPU-accelerated, zero continuous layout recalculation) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    <div class="absolute inset-0 bg-white [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] z-0"></div>
  </div>

  <PublicHeader />

  {!bootstrapReady && (
    <div class="mx-auto w-full max-w-7xl px-6 relative z-10 my-4">
      <div class="rounded-2xl border border-amber-200 bg-amber-50/90 backdrop-blur-md px-5 py-3.5 text-sm text-amber-900 shadow-sm flex items-center gap-3">
        <span class="flex h-2.5 w-2.5 rounded-full bg-amber-500 shrink-0"></span>
        <p>Instalasi baru terdeteksi. Jalankan <code class="font-semibold px-1.5 py-0.5 rounded bg-amber-100/80">npm run setup</code> di terminal untuk inisialisasi user root & organisasi pertama.</p>
      </div>
    </div>
  )}

  <main class="relative z-10 overflow-hidden">
    <!-- Hero Section -->
    <section class="pt-20 pb-24 md:pt-28 md:pb-32">
      <div class="mx-auto w-full max-w-7xl px-6 flex flex-col items-center text-center">
        
        <!-- Live Status Pill with Emil's subtle pulse -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-slate-200 bg-white backdrop-blur-md px-4 py-1.5 text-[13px] font-semibold tracking-wide text-slate-600 mb-8 shadow-sm hero-animate">
          <span class="relative flex h-2 w-2">
            <span class="pulse-live absolute inline-flex h-full w-full rounded-full bg-indigo-600 opacity-70"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"></span>
          </span>
          <span class="text-slate-900">ValueLoop</span> SaaS Budaya Kerja
        </div>
        
        <h1 class="max-w-4xl text-[40px] leading-[1.1] sm:text-6xl md:text-7xl font-bold tracking-[-0.02em] text-slate-900 hero-animate-delay-1">
          Dari hiasan tembok <br />ke <span class="text-indigo-600">kebiasaan nyata.</span>
        </h1>
        
        <p class="mt-6 max-w-2xl text-[17px] sm:text-[19px] leading-[1.6] text-slate-600 hero-animate-delay-2 font-medium">
          SOP tak lagi tersimpan di laci. Bawa nilai luhur perusahaan ke keseharian tim Anda lewat refleksi, kompetisi, dan leaderboard yang terus berputar di ingatan.
        </p>
        
        <!-- Action buttons with tactile scale & shimmer -->
        <div class="mt-10 flex flex-wrap justify-center gap-4 hero-animate-delay-3">
          <a class="btn-shimmer btn-interactive inline-flex items-center gap-2 rounded-full bg-slate-900 px-8 py-3.5 font-semibold text-white shadow-xl shadow-slate-900/10 hover:bg-slate-800" href="/signup">
            Mulai Transformasi
            <svg class="w-4 h-4 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a class="btn-interactive inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-8 py-3.5 font-semibold text-slate-900 shadow-sm hover:border-slate-300 hover:bg-slate-50" href="#how-it-works">
            Lihat Cara Kerja
          </a>
        </div>

        <!-- Interactive Product Preview Mockup -->
        <div id="demo-preview" class="mt-16 w-full max-w-4xl hero-animate-delay-4">
          <div class="relative rounded-3xl border border-slate-200/80 bg-white/75 p-3 sm:p-5 shadow-2xl backdrop-blur-xl transition-all">
            <div class="rounded-2xl border border-slate-100 bg-white p-6 sm:p-8 text-left shadow-sm">
              <div class="flex items-center justify-between border-b border-slate-100 pb-5 mb-6 flex-wrap gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-rose-400"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                  <span class="text-xs font-mono text-slate-400 ml-2">Daily Core Value Challenge</span>
                </div>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold border border-indigo-100">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-600"></span>
                  Value: Customer Obsession
                </div>
              </div>

              <div class="space-y-4">
                <div class="p-4 rounded-xl bg-slate-50/80 border border-slate-100">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Pertanyaan AI Hari Ini</p>
                  <p class="text-base sm:text-lg font-semibold text-slate-900">
                    "Ceritakan 1 momen minggu ini di mana kamu mengambil inisiatif ekstra untuk menyelesaikan kendala customer tanpa diminta!"
                  </p>
                </div>

                <div class="p-4 rounded-xl bg-indigo-50/40 border border-indigo-100/60">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-semibold text-indigo-900">Jawaban Tim Member (Rian - Support)</span>
                    <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md">Skor: 9/10 (Sangat Baik)</span>
                  </div>
                  <p class="text-sm sm:text-base text-slate-700 leading-relaxed italic">
                    "Kemarin ada user mengalami kendala integrasi API saat deploy malam. Saya buatkan video walkthrough 3 menit dan snippet kustom langsung agar problem tuntas sebelum launch mereka."
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Masalah yang Diselesaikan -->
    <section class="py-24 bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="reveal-left">
            <span class="text-xs font-bold uppercase tracking-widest text-indigo-600 mb-3 block">Problem vs Solution</span>
            <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6 leading-tight">
              Value perusahaan sering berujung jadi hiasan tembok. ValueLoop mengubahnya jadi rutinitas.
            </h2>
            <p class="text-base sm:text-lg text-slate-600 mb-6 leading-relaxed">
              Banyak organisasi kesulitan menanamkan value karena hanya dibaca saat onboarding. SOP seringkali hanya berupa PDF tebal yang tersimpan di laci.
            </p>
            <ul class="space-y-4">
              <li class="flex items-start gap-3.5 reveal stagger-1">
                <div class="mt-1 w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0 border border-indigo-100">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-700 font-medium">Ubah PDF statis menjadi sesi interaksi harian</span>
              </li>
              <li class="flex items-start gap-3.5 reveal stagger-2">
                <div class="mt-1 w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0 border border-indigo-100">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-700 font-medium">Beri skor untuk setiap implementasi value dengan AI & manual review</span>
              </li>
              <li class="flex items-start gap-3.5 reveal stagger-3">
                <div class="mt-1 w-6 h-6 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center shrink-0 border border-indigo-100">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-700 font-medium">Bakar semangat tim lewat Leaderboard dan rekam jejak performa</span>
              </li>
            </ul>
          </div>

          <div class="relative reveal-right">
            <div class="interactive-card bg-white rounded-3xl shadow-xl border border-slate-100 p-8">
              <div class="space-y-4">
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between opacity-60">
                  <span class="text-slate-500 line-through text-sm sm:text-base font-medium">Slogan pajangan dinding</span>
                  <span class="text-xs bg-slate-200 text-slate-600 px-2.5 py-1 rounded-md font-semibold">Pasif</span>
                </div>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between opacity-70">
                  <span class="text-slate-600 line-through text-sm sm:text-base font-medium">Dokumen SOP di laci meja</span>
                  <span class="text-xs bg-slate-200 text-slate-600 px-2.5 py-1 rounded-md font-semibold">Jarang Dibaca</span>
                </div>
                <div class="p-5 rounded-2xl bg-white border border-indigo-600 ring-4 ring-indigo-50 shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex items-center justify-between">
                  <div class="flex items-center gap-4">
                    <div class="h-10 w-10 flex items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 font-bold shadow-inner">
                      V
                    </div>
                    <span class="text-slate-900 font-bold text-base sm:text-lg">Refleksi harian interaktif & terukur</span>
                  </div>
                  <span class="text-xs bg-indigo-600 text-white px-3 py-1.5 rounded-full font-bold shadow-sm">Terus Berputar</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Solusi 5 Langkah -->
    <section id="how-it-works" class="py-24 bg-slate-900 text-white relative overflow-hidden">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3 block">Alur Kerja Cerdas</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
            Bagaimana ValueLoop bekerja untuk organisasi Anda
          </h2>
          <p class="mt-4 text-slate-300 text-base sm:text-lg">
            Cukup definisikan core values organisasi. Sistem mengotomasi proses tantangan hingga perhitungan skor.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          <div class="interactive-card bg-slate-800/70 border border-slate-700/80 rounded-2xl p-6 reveal stagger-1">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/20 text-indigo-400 font-bold flex items-center justify-center mb-4 border border-indigo-400/30">1</div>
            <h3 class="font-bold text-white text-base mb-2">Input Nilai</h3>
            <p class="text-slate-300 text-sm leading-relaxed">Masukkan core values dan definisi prinsip organisasi Anda.</p>
          </div>

          <div class="interactive-card bg-slate-800/70 border border-slate-700/80 rounded-2xl p-6 reveal stagger-2">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center mb-4 border border-emerald-400/30">2</div>
            <h3 class="font-bold text-white text-base mb-2">AI Generate</h3>
            <p class="text-slate-300 text-sm leading-relaxed">AI menyusun studi kasus & pertanyaan refleksi kontekstual.</p>
          </div>

          <div class="interactive-card bg-slate-800/70 border border-slate-700/80 rounded-2xl p-6 reveal stagger-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-500/20 text-indigo-400 font-bold flex items-center justify-center mb-4 border border-indigo-400/30">3</div>
            <h3 class="font-bold text-white text-base mb-2">Daily Session</h3>
            <p class="text-slate-300 text-sm leading-relaxed">Member dipilih secara berkala untuk menjawab pertanyaan.</p>
          </div>

          <div class="interactive-card bg-slate-800/70 border border-slate-700/80 rounded-2xl p-6 reveal stagger-4">
            <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center mb-4 border border-amber-400/30">4</div>
            <h3 class="font-bold text-white text-base mb-2">Scoring Realistis</h3>
            <p class="text-slate-300 text-sm leading-relaxed">Penilaian awal otomatis oleh AI, dengan fleksibilitas edit skor oleh reviewer (user berizin) untuk akurasi terbaik.</p>
          </div>

          <div class="interactive-card bg-slate-800/70 border border-slate-700/80 rounded-2xl p-6 reveal stagger-5">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center mb-4 border border-emerald-400/30">5</div>
            <h3 class="font-bold text-white text-base mb-2">Insight & Ranking</h3>
            <p class="text-slate-300 text-sm leading-relaxed">Leaderboard terupdate & grafik perkembangan budaya kerja.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Fitur Unggulan Grid -->
    <section id="features" class="py-24 bg-[#F6F8FB]">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <span class="text-[13px] font-bold uppercase tracking-widest text-[#1D4ED8] mb-3 block">Fitur Utama</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-[#0F172A] leading-tight">
            Dirancang untuk kesederhanaan, fokus pada dampak nyata
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-1">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Pertanyaan AI Kontekstual</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Pertanyaan dirancang relevan dengan skenario kerja nyata, bukan hafalan teori.</p>
          </div>

          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-2">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Sesi Challenge Terstruktur</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Rotasi pemilihan member dan value yang adil tanpa bias.</p>
          </div>

          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-3">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Leaderboard & Rekam Jejak</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Apresiasi staff yang paling konsisten menghidupkan core values perusahaan.</p>
          </div>

          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-4">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Multi-tenant & Aman</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Data setiap organisasi terisolasi penuh dengan proteksi otentikasi ketat.</p>
          </div>

          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-5">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Meeting Room Ready</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Tampilan sesi challenge dirancang jelas untuk diproyeksikan di layar rapat tim.</p>
          </div>

          <div class="card-interactive bg-white p-8 rounded-3xl border border-[#DCE4F0] shadow-sm reveal-scale stagger-6">
            <div class="w-12 h-12 bg-[#EEF4FF] text-[#1D4ED8] rounded-2xl flex items-center justify-center mb-6 font-bold">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H4a2 2 0 00-2 2v6a2 2 0 002 2h3a2 2 0 002-2zm0 0V9a2 2 0 012-2h3a2 2 0 012 2v10m-6 0a2 2 0 002 2h3a2 2 0 002-2m0 0V5a2 2 0 012-2h3a2 2 0 012 2v14a2 2 0 01-2 2h-3a2 2 0 01-2-2z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-[#0F172A] mb-2">Insight Perkembangan Tim</h3>
            <p class="text-[#64748B] text-[15px] leading-relaxed">Metrik dan grafik evaluasi tingkat pemahaman nilai di tiap divisi.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="py-28 text-center bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-5xl px-6 reveal">
        <div class="rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 p-10 sm:p-16 text-white shadow-2xl relative overflow-hidden">
          <div class="relative z-10 max-w-3xl mx-auto">
            <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
              Mulai hidupkan budaya kerja tim Anda hari ini.
            </h2>
            <p class="text-slate-300 text-base sm:text-xl mb-10 leading-relaxed">
              Jadikan core values pegangan nyata dalam rutinitas kerja, tingkatkan engagement tim, dan bangun kebiasaan yang berakar kuat.
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <a class="btn-shimmer btn-interactive inline-flex items-center gap-2 rounded-full bg-indigo-600 px-8 py-4 font-semibold text-white shadow-lg shadow-indigo-600/25 hover:bg-indigo-500" href="/signup">
                Buat Akun Organisasi
              </a>
              <a class="btn-interactive inline-flex items-center gap-2 rounded-full bg-slate-800 border border-slate-700 px-8 py-4 font-semibold text-slate-200 hover:bg-slate-700" href="/login">
                Masuk ke Dashboard
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <PublicFooter />

  <!-- Scroll-reveal Intersection Observer (Off-thread, buttery smooth) -->
  <script>
    function initRevealAnimations() {
      const revealSelectors = '.reveal, .reveal-scale, .reveal-left, .reveal-right';
      const elements = document.querySelectorAll(revealSelectors);

      if (!elements.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elements.forEach(el => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -40px 0px',
        }
      );

      elements.forEach((el) => observer.observe(el));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRevealAnimations);
    } else {
      initRevealAnimations();
    }

    document.addEventListener('astro:after-swap', initRevealAnimations);
  </script>
</BaseLayout>
