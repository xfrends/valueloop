---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;
---

<BaseLayout
  title="ValueLoop - Ubah Core Value Menjadi Kebiasaan"
  description="SaaS platform untuk menghidupkan core value perusahaan melalui tantangan harian, leaderboard, dan insight."
>
  <!-- Mark js-ready synchronously before first paint to gate reveal animations -->
  <script is:inline>document.documentElement.classList.add('js-ready');</script>

  <!-- Static decorative background — no continuous animation -->
  
  <!-- Static blobs — fixed positions, no floating animation -->
  <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 blur-3xl opacity-30 pointer-events-none">
    <div class="aspect-square w-[600px] rounded-full bg-gradient-to-tr from-blue-400 to-teal-200"></div>
  </div>
  <div class="absolute top-[40%] left-0 -translate-x-1/2 blur-3xl opacity-20 pointer-events-none">
    <div class="aspect-square w-[400px] rounded-full bg-gradient-to-br from-teal-300 to-blue-100"></div>
  </div>
  <div class="absolute top-[70%] right-0 translate-x-1/3 blur-3xl opacity-15 pointer-events-none">
    <div class="aspect-square w-[500px] rounded-full bg-gradient-to-tl from-blue-200 to-cyan-100"></div>
  </div>

  <PublicHeader />

  {!bootstrapReady && (
    <div class="mx-auto w-full max-w-7xl px-6 relative z-10">
      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 shadow-sm">
        Instalasi baru terdeteksi. Jalankan <code class="font-semibold">npm run setup</code> dari terminal untuk membuat root user dan organisasi pertama.
      </div>
    </div>
  )}

  <main class="relative z-10 overflow-hidden">
    <!-- Hero Section -->
    <section class="py-24 md:py-32">
      <div class="mx-auto w-full max-w-7xl px-6 flex flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/50 px-4 py-1.5 text-sm font-medium text-blue-900 mb-8 shadow-sm backdrop-blur-sm hero-animate">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        Tersedia Sekarang
      </div>
      
      <h1 class="max-w-5xl text-5xl font-extrabold tracking-tight text-slate-900 sm:text-7xl leading-[1.1] hero-animate-delay-1">
        Ubah core value perusahaan menjadi <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-teal-500">kebiasaan tim setiap hari.</span>
      </h1>
      
      <p class="mt-8 max-w-2xl text-lg sm:text-xl leading-relaxed text-slate-600 hero-animate-delay-2">
        AI membuat pertanyaan berbasis cerita dari core value perusahaan, mengirimkannya ke staff, lalu menampilkan skor dan leaderboard untuk menjaga budaya tetap hidup.
      </p>
      
      <div class="mt-10 flex flex-wrap justify-center gap-4 hero-animate-delay-3">
        <a class="btn-shimmer rounded-full bg-slate-900 px-8 py-4 font-semibold text-white shadow-xl shadow-slate-900/20 hover:bg-blue-800 hover:-translate-y-0.5 transition-all active:translate-y-0" href="/signup">
          Coba Sekarang
        </a>
        <a class="rounded-full bg-white border border-slate-200 px-8 py-4 font-semibold text-slate-700 shadow-sm hover:border-blue-300 hover:text-blue-800 transition-all hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2" href="#how-it-works">
          Lihat Cara Kerja
        </a>
      </div>
      </div>
    </section>

    <!-- Masalah yang Diselesaikan -->
    <section class="py-24 bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="reveal-left">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6 leading-tight">
            Core value sering berakhir di dinding. Kami membantu menjadikannya bagian dari rutinitas tim.
          </h2>
          <p class="text-lg text-slate-600 mb-6">
            Banyak perusahaan sudah punya core value, tetapi belum tentu benar-benar dipahami dan dipraktikkan oleh seluruh tim. Akibatnya, value hanya menjadi slogan, bukan budaya.
          </p>
          <p class="text-lg text-slate-600 mb-8 font-medium">
            Aplikasi ini membantu perusahaan:
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3 reveal stagger-1">
              <div class="mt-1 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-700 text-lg">Menghidupkan core value dalam percakapan harian</span>
            </li>
            <li class="flex items-start gap-3 reveal stagger-2">
              <div class="mt-1 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-700 text-lg">Melatih staff menjawab dengan contoh dan cerita</span>
            </li>
            <li class="flex items-start gap-3 reveal stagger-3">
              <div class="mt-1 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-700 text-lg">Memantau partisipasi tim secara konsisten</span>
            </li>
            <li class="flex items-start gap-3 reveal stagger-4">
              <div class="mt-1 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-slate-700 text-lg">Membangun budaya kerja yang lebih selaras</span>
            </li>
          </ul>
        </div>
        <div class="relative reveal-right">
          <div class="absolute inset-0 bg-gradient-to-tr from-blue-100 to-teal-50 rounded-2xl transform rotate-3 scale-105 -z-10 transition-transform hover:rotate-6"></div>
          <div class="bg-white/80 backdrop-blur-xl rounded-2xl shadow-xl border border-white p-8">
             <div class="space-y-6">
               <div class="opacity-50 line-through text-slate-500 flex items-center gap-4 text-lg reveal stagger-1">
                 <div class="w-3 h-3 rounded-full bg-slate-300"></div> Slogan di dinding
               </div>
               <div class="opacity-75 text-slate-600 flex items-center gap-4 text-lg reveal stagger-2">
                 <div class="w-3 h-3 rounded-full bg-slate-400"></div> Dokumen PDF core value
               </div>
               <div class="text-slate-900 font-semibold flex items-center gap-4 text-xl border-l-4 border-blue-500 pl-6 py-4 bg-blue-50 rounded-r-2xl shadow-sm reveal stagger-3">
                 <div class="w-4 h-4 rounded-full bg-blue-500 animate-pulse shadow-[0_0_15px_rgba(16,185,129,0.5)]"></div> Praktik nyata sehari-hari
               </div>
             </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Solusi -->
    <section class="py-24 bg-slate-50/80 border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="bg-slate-900 rounded-2xl p-10 md:p-16 text-center text-white relative overflow-hidden shadow-2xl reveal-scale">
          <div class="absolute inset-0 opacity-20 bg-transparent"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-5xl font-bold mb-6 leading-tight reveal">AI yang mengubah core value menjadi pertanyaan yang relevan dan membumi.</h2>
          <p class="text-lg md:text-xl text-slate-300 max-w-3xl mx-auto mb-12 reveal stagger-1">
            Cukup input core value perusahaan beserta penjelasannya. Sistem akan:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4 md:gap-6 text-left">
            <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700 rounded-2xl p-6 hover:bg-slate-800 hover:border-blue-500/50 transition-all hover:-translate-y-1 reveal stagger-1">
              <div class="text-blue-400 font-bold text-xl mb-3">1</div>
              <p class="text-slate-200 font-medium leading-snug">Membaca inti value perusahaan</p>
            </div>
            <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700 rounded-2xl p-6 hover:bg-slate-800 hover:border-blue-500/50 transition-all hover:-translate-y-1 reveal stagger-2">
              <div class="text-blue-400 font-bold text-xl mb-3">2</div>
              <p class="text-slate-200 font-medium leading-snug">Membuat pertanyaan harian yang selaras dengan value</p>
            </div>
            <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700 rounded-2xl p-6 hover:bg-slate-800 hover:border-blue-500/50 transition-all hover:-translate-y-1 reveal stagger-3">
              <div class="text-blue-400 font-bold text-xl mb-3">3</div>
              <p class="text-slate-200 font-medium leading-snug">Mengirim pertanyaan acak ke staff</p>
            </div>
            <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700 rounded-2xl p-6 hover:bg-slate-800 hover:border-blue-500/50 transition-all hover:-translate-y-1 reveal stagger-4">
              <div class="text-blue-400 font-bold text-xl mb-3">4</div>
              <p class="text-slate-200 font-medium leading-snug">Mengumpulkan jawaban berbasis cerita atau contoh nyata</p>
            </div>
            <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700 rounded-2xl p-6 hover:bg-slate-800 hover:border-blue-500/50 transition-all hover:-translate-y-1 reveal stagger-5">
              <div class="text-blue-400 font-bold text-xl mb-3">5</div>
              <p class="text-slate-200 font-medium leading-snug">Menghitung skor dan menampilkan leaderboard</p>
            </div>
          </div>
          <div class="mt-16 inline-block bg-blue-500/10 border border-blue-500/20 rounded-full px-8 py-4 backdrop-blur-sm reveal stagger-6">
            <p class="text-xl font-medium text-blue-300">
              Dengan begitu, core value tidak lagi berhenti sebagai dokumen. Ia hadir dalam kebiasaan kerja sehari-hari.
            </p>
          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- Fitur Utama -->
    <section id="features" class="py-24 bg-slate-50/80">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6 leading-tight">Semua yang Anda butuhkan untuk membangun budaya kerja yang aktif.</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-1">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">AI generate pertanyaan</h3>
          <p class="text-slate-600 leading-relaxed">AI membuat pertanyaan yang kontekstual, reflektif, dan sesuai dengan core value perusahaan.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-2">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Pertanyaan harian</h3>
          <p class="text-slate-600 leading-relaxed">Setiap hari, staff menerima pertanyaan acak yang mendorong mereka menjawab dengan pengalaman nyata.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-3">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Jawaban berbasis cerita</h3>
          <p class="text-slate-600 leading-relaxed">Bukan jawaban singkat atau formalitas semata. Staff diajak menjawab dengan contoh, situasi, dan cerita kerja yang konkret.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-4">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Leaderboard &amp; ranking</h3>
          <p class="text-slate-600 leading-relaxed">Pantau skor masing-masing staff dan lihat siapa yang paling aktif serta paling konsisten.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-5">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H4a2 2 0 00-2 2v6a2 2 0 002 2h3a2 2 0 002-2zm0 0V9a2 2 0 012-2h3a2 2 0 012 2v10m-6 0a2 2 0 002 2h3a2 2 0 002-2m0 0V5a2 2 0 012-2h3a2 2 0 012 2v14a2 2 0 01-2 2h-3a2 2 0 01-2-2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Dashboard admin</h3>
          <p class="text-slate-600 leading-relaxed">Owner atau HR bisa mengatur core value, melihat aktivitas tim, dan memantau perkembangan budaya kerja dengan lebih mudah.</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all group reveal-scale stagger-6">
          <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-700 mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all shadow-sm">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Riwayat &amp; insight</h3>
          <p class="text-slate-600 leading-relaxed">Lihat riwayat jawaban dan skor setiap staff, serta dapatkan insight tentang tren partisipasi dan perkembangan budaya kerja tim.</p>
        </div>
      </div>
      </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works" class="py-24 bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6">
        <div class="text-center mb-20 reveal">
          <h2 class="text-3xl md:text-5xl font-bold text-slate-900">Cara kerjanya sederhana.</h2>
      </div>
      
      <div class="relative max-w-5xl mx-auto">
        <!-- Line connecting steps -->
        <div class="hidden md:block absolute left-1/2 top-8 bottom-8 w-1 bg-gradient-to-b from-blue-100 via-blue-200 to-blue-100 -translate-x-1/2 rounded-full"></div>
        
        <div class="space-y-16 relative z-10">
          <!-- Step 1 -->
          <div class="flex flex-col md:flex-row items-center gap-10">
            <div class="flex-1 w-full">
              <div class="bg-white p-8 md:p-10 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl transition-shadow md:text-left text-center reveal-left stagger-1">
                <div class="inline-block bg-blue-100 text-blue-800 font-bold tracking-wider uppercase text-xs px-4 py-1.5 rounded-full mb-4">Langkah 1</div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">Masukkan core value perusahaan</h3>
                <p class="text-slate-600 text-lg md:text-xl leading-relaxed">Tulis core value beserta penjelasannya agar AI memahami konteksnya.</p>
              </div>
            </div>
            <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-700 rounded-full border-4 border-white shadow-xl flex items-center justify-center text-white text-xl font-bold shrink-0 z-10 hidden md:flex glow-step">1</div>
            <div class="flex-1 w-full hidden md:block"></div>
          </div>
          <!-- Step 2 -->
          <div class="flex flex-col md:flex-row-reverse items-center gap-10">
            <div class="flex-1 w-full">
              <div class="bg-white p-8 md:p-10 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl transition-shadow md:text-right text-center reveal-right stagger-2">
                <div class="inline-block bg-blue-100 text-blue-800 font-bold tracking-wider uppercase text-xs px-4 py-1.5 rounded-full mb-4">Langkah 2</div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">AI membuat pertanyaan</h3>
                <p class="text-slate-600 text-lg md:text-xl leading-relaxed">Sistem otomatis menghasilkan pertanyaan yang sesuai dengan value tersebut.</p>
              </div>
            </div>
            <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-700 rounded-full border-4 border-white shadow-xl flex items-center justify-center text-white text-xl font-bold shrink-0 z-10 hidden md:flex glow-step">2</div>
            <div class="flex-1 w-full hidden md:block"></div>
          </div>
          <!-- Step 3 -->
          <div class="flex flex-col md:flex-row items-center gap-10">
            <div class="flex-1 w-full">
              <div class="bg-white p-8 md:p-10 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl transition-shadow md:text-left text-center reveal-left stagger-3">
                <div class="inline-block bg-blue-100 text-blue-800 font-bold tracking-wider uppercase text-xs px-4 py-1.5 rounded-full mb-4">Langkah 3</div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">Staff menjawab setiap hari</h3>
                <p class="text-slate-600 text-lg md:text-xl leading-relaxed">Pertanyaan dikirim secara acak ke staff untuk dijawab dengan cerita atau contoh.</p>
              </div>
            </div>
            <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-700 rounded-full border-4 border-white shadow-xl flex items-center justify-center text-white text-xl font-bold shrink-0 z-10 hidden md:flex glow-step">3</div>
            <div class="flex-1 w-full hidden md:block"></div>
          </div>
          <!-- Step 4 -->
          <div class="flex flex-col md:flex-row-reverse items-center gap-10">
            <div class="flex-1 w-full">
              <div class="bg-white p-8 md:p-10 rounded-[2rem] border border-slate-100 shadow-xl hover:shadow-2xl transition-shadow md:text-right text-center reveal-right stagger-4">
                <div class="inline-block bg-blue-100 text-blue-800 font-bold tracking-wider uppercase text-xs px-4 py-1.5 rounded-full mb-4">Langkah 4</div>
                <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">Skor dan leaderboard diperbarui</h3>
                <p class="text-slate-600 text-lg md:text-xl leading-relaxed">Jawaban dinilai, skor dihitung, dan ranking staff tampil secara real-time.</p>
              </div>
            </div>
            <div class="w-16 h-16 bg-gradient-to-br from-blue-400 to-blue-700 rounded-full border-4 border-white shadow-xl flex items-center justify-center text-white text-xl font-bold shrink-0 z-10 hidden md:flex glow-step">4</div>
            <div class="flex-1 w-full hidden md:block"></div>
          </div>
        </div>
      </div>
      </div>
    </section>

    <!-- Benefit & Positioning -->
    <section class="py-24 bg-white border-t border-slate-100">
      <div class="mx-auto w-full max-w-7xl px-6 grid md:grid-cols-2 gap-8 md:gap-12">
        <div class="bg-gradient-to-br from-blue-50 via-teal-50 to-white p-10 md:p-12 rounded-2xl border border-blue-100/60 shadow-lg relative overflow-hidden group hover:border-blue-300 transition-colors reveal-left">
        <div class="absolute top-0 right-0 p-8 opacity-10 transform translate-x-4 -translate-y-4 group-hover:scale-110 transition-transform">
