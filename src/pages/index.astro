---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ValueLoop - Operationalize Your Core Values"
  description="SaaS platform to turn core values into daily work habits through challenges, leaderboards, and insights."
>
  <!-- Decorative background -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-100/50 via-slate-50 to-white"></div>
  <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 blur-3xl opacity-30 pointer-events-none">
    <div class="aspect-square w-[600px] rounded-full bg-gradient-to-tr from-emerald-400 to-teal-200"></div>
  </div>

  <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6 relative z-10">
    <a class="flex items-center gap-2 group" href="/">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-emerald-500/20 transition-transform group-hover:scale-105">
        V
      </div>
      <span class="text-xl font-bold tracking-tight text-slate-900">ValueLoop</span>
    </a>
    <nav class="flex items-center gap-6 text-sm font-medium">
      <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="#features">Features</a>
      <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="#how-it-works">How it works</a>
      <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="/login">Sign In</a>
      <a class="rounded-full bg-slate-900 px-5 py-2.5 text-white shadow-md shadow-slate-900/10 hover:bg-emerald-700 hover:shadow-emerald-700/20 transition-all active:scale-95" href="/dashboard">
        Go to Prototype &rarr;
      </a>
    </nav>
  </header>

  <main class="mx-auto w-full max-w-6xl px-6 relative z-10">
    <section class="py-24 md:py-32 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50/50 px-4 py-1.5 text-sm font-medium text-emerald-800 mb-8 shadow-sm backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        MVP UI Prototype is Live
      </div>
      
      <h1 class="max-w-4xl text-5xl font-extrabold tracking-tight text-slate-900 sm:text-7xl leading-[1.1]">
        Turn core values into <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">daily habits.</span>
      </h1>
      
      <p class="mt-8 max-w-2xl text-lg sm:text-xl leading-relaxed text-slate-600">
        Stop leaving company culture to chance. ValueLoop helps organizations operationalize core values through structured daily challenges, scoring, leaderboards, and insights.
      </p>
      
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a class="rounded-full bg-emerald-600 px-8 py-4 font-semibold text-white shadow-xl shadow-emerald-600/20 hover:bg-emerald-700 hover:-translate-y-0.5 transition-all active:translate-y-0" href="/dashboard">
          Explore Dashboard Prototype
        </a>
        <a class="rounded-full bg-white border border-slate-200 px-8 py-4 font-semibold text-slate-700 shadow-sm hover:border-emerald-300 hover:text-emerald-700 transition-all hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2" href="/challenge">
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Try a Daily Challenge
        </a>
      </div>
    </section>

    <!-- Glassmorphism Preview Card -->
    <section class="mt-8 pb-32">
      <div class="relative mx-auto max-w-5xl rounded-2xl border border-white/40 bg-white/60 p-2 shadow-2xl shadow-slate-200/50 backdrop-blur-xl">
        <div class="absolute inset-0 -z-10 rounded-2xl bg-gradient-to-b from-white/80 to-white/20"></div>
        <div class="rounded-xl border border-slate-200/60 bg-slate-50/50 p-8 shadow-inner overflow-hidden">
          
          <div class="flex items-center justify-between mb-8">
            <div>
              <h3 class="text-xl font-bold text-slate-900">Today's Challenge</h3>
              <p class="text-slate-500 text-sm mt-1">Randomly selected for Acme Corp</p>
            </div>
            <div class="flex items-center gap-2 text-sm font-medium px-3 py-1.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Open
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-5 rounded-xl bg-white border border-slate-100 shadow-sm flex flex-col items-center justify-center text-center group hover:border-emerald-200 transition-colors">
              <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              </div>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Member</p>
              <p class="font-bold text-slate-900 mt-1">Budi Santoso</p>
            </div>
            
            <div class="p-5 rounded-xl bg-white border border-slate-100 shadow-sm flex flex-col items-center justify-center text-center group hover:border-emerald-200 transition-colors">
              <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider">Core Value</p>
              <p class="font-bold text-slate-900 mt-1">Ownership</p>
            </div>

            <div class="p-5 rounded-xl bg-white border border-slate-100 shadow-sm flex flex-col justify-center group hover:border-emerald-200 transition-colors">
              <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-2">Question</p>
              <p class="font-medium text-slate-800 text-sm italic">"Ceritakan satu kejadian minggu ini di mana kamu mengambil inisiatif di luar tugas utamamu untuk menyelesaikan masalah tim."</p>
            </div>
          </div>

          <div class="mt-8 flex justify-end">
            <button class="bg-slate-900 text-white px-6 py-2.5 rounded-lg font-medium hover:bg-slate-800 transition-colors flex items-center gap-2">
              Record Answer
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </div>

        </div>
      </div>
    </section>

  </main>
</BaseLayout>
