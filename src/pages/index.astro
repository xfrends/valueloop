  <script>
    function initRevealAnimations() {
      const elements = document.querySelectorAll('.reveal, .reveal-scale, .reveal-left, .reveal-right');
      if (!elements.length) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        elements.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      elements.forEach((el) => observer.observe(el));
    }

    function initHeroTypewriter() {
      const input = document.querySelector<HTMLInputElement>('#hero-question');
      if (!input || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const prompts = [
        'Ceritakan momen kamu menolong customer tanpa diminta',
        'Kapan terakhir kamu mengambil ownership penuh?',
        'Apa satu hal yang kamu perbaiki minggu ini?',
      ];
      let promptIndex = 0;
      let charIndex = 0;
      let deleting = false;
      const tick = () => {
        const text = prompts[promptIndex];
        charIndex += deleting ? -1 : 1;
        input.placeholder = `${text.slice(0, charIndex)}|`;
        let delay = deleting ? 28 : 55;
        if (!deleting && charIndex === text.length) { deleting = true; delay = 1800; }
        if (deleting && charIndex === 0) { deleting = false; promptIndex = (promptIndex + 1) % prompts.length; delay = 400; }
        window.setTimeout(tick, delay);
      };
      tick();
    }

    // Generic tab switcher: buttons carry data-<name>-tab, panels carry data-<name>-panel.
    function initTabs(name: string, onChange?: (key: string) => void) {
      const tabs = document.querySelectorAll<HTMLElement>(`[data-${name}-tab]`);
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const key = tab.getAttribute(`data-${name}-tab`) ?? '';
        tabs.forEach((other) => other.setAttribute('aria-selected', String(other === tab)));
        document.querySelectorAll<HTMLElement>(`[data-${name}-panel]`).forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute(`data-${name}-panel`) !== key);
        });
        onChange?.(key);
      }));
    }

    function initCarousel() {
      const track = document.querySelector<HTMLElement>('[data-carousel]');
      const prev = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = document.querySelector<HTMLButtonElement>('[data-carousel-next]');
      if (!track || !prev || !next) return;
      const step = () => (track.querySelector('article')?.clientWidth ?? 400) + 10;
      const sync = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', sync, { passive: true });
      sync();
    }

    initRevealAnimations();
    initHeroTypewriter();
    initCarousel();
    initTabs('engine');
    initTabs('role');
    initTabs('chart', (key) => {
      document.querySelectorAll<SVGGElement>('[data-chart-line]').forEach((line) => {
        line.classList.toggle('hidden', line.dataset.chartLine !== key);
      });
      const withValueLoop = key === 'with';
      const participation = document.querySelector('[data-chart-stat="participation"]');
      const score = document.querySelector('[data-chart-stat="score"]');
      if (participation) participation.textContent = withValueLoop ? '86%' : '18%';
      if (score) score.textContent = withValueLoop ? '8,4' : '—';
    });
  </script>
