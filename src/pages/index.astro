---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;

const problems = [
  { title: 'Poster di dinding', body: 'Dibaca sekali saat dipasang, lalu jadi bagian dari interior kantor.' },
  { title: 'PDF onboarding', body: 'Rapi dan lengkap, tapi jarang dibuka lagi setelah minggu pertama.' },
  { title: 'Ritual ValueLoop', body: 'Satu pertanyaan, satu cerita nyata, satu skor. Diulang setiap hari.' },
];

const features = [
  { title: 'Pertanyaan harian.', body: 'Setiap value punya bank pertanyaan praktis. Randomizer memilih member, value, dan pertanyaan aktif.' },
  { title: 'Skor yang adil.', body: 'Facilitator menilai 0–10 berdasarkan kejelasan, relevansi, dan contoh nyata.' },
  { title: 'Leaderboard sehat.', body: 'Total poin, rata-rata, dan konsistensi partisipasi dalam satu papan.' },
  { title: 'Core values milik tim.', body: 'Tidak terpaku pada 5 value. Tambah, ubah warna, dan nonaktifkan sesuai budaya Anda.' },
  { title: 'History lengkap.', body: 'Setiap challenge tersimpan, lengkap dengan jawaban dan skornya.' },
  { title: 'Insights per value.', body: 'Lihat value yang sudah kuat dan area yang perlu lebih sering dibicarakan.' },
];

const engineTabs = [
  { key: 'siapkan', label: 'Siapkan', title: 'Definisikan value yang benar-benar dipakai', body: 'Tulis core values, perilaku yang diharapkan, dan pertanyaan refleksi. Mulai dari template opsional atau dari nol.', cta: 'Mulai setup', href: '/signup' },
  { key: 'challenge', label: 'Challenge', title: 'Satu pertanyaan, setiap hari', body: 'Randomizer memilih member, value, dan pertanyaan aktif. Hasilnya tersimpan, tidak berubah karena refresh.', cta: 'Lihat challenge', href: '/preview' },
  { key: 'nilai', label: 'Nilai', title: 'Skor berbasis contoh nyata', body: 'Facilitator memberi skor 0–10 setelah member menjawab. Sesi yang sudah dinilai terkunci dari reroll.', cta: 'Pelajari scoring', href: '/fitur' },
  { key: 'tumbuh', label: 'Tumbuh', title: 'Kebiasaan yang terlihat', body: 'Leaderboard, history, dan insights menunjukkan value mana yang hidup dan mana yang perlu didorong.', cta: 'Lihat insights', href: '/preview' },
];

const roles = [
  { name: 'Startup', body: 'Budaya terbentuk paling cepat di tahun-tahun awal. ValueLoop membantu founder menanamkan value sejak tim masih kecil, tanpa proses HR yang berat.' },
  { name: 'Tim HR & People', body: 'Ubah program culture dari acara tahunan menjadi ritual harian yang terukur, lengkap dengan history dan insights per value.' },
  { name: 'Agensi', body: 'Jaga standar kerja lintas klien dan tim proyek lewat pertanyaan yang relevan dengan cara kerja agensi Anda.' },
  { name: 'Tim Operasional', body: 'Bawa value seperti keselamatan, ketelitian, dan pelayanan ke briefing pagi, dalam lima menit saja.' },
  { name: 'Founder', body: 'Dengar langsung bagaimana tim menerjemahkan value Anda ke pekerjaan sehari-hari.' },
  { name: 'Perusahaan Retail', body: 'Satukan standar pelayanan di banyak cabang dengan challenge yang sama dan leaderboard per tim.' },
];

const faqs = [
  { q: 'Bagaimana cara kerja ValueLoop?', a: 'Organisasi membuat core values dan pertanyaan, lalu tim menjalankan challenge secara berkala. Jawaban diberi skor manual untuk membentuk leaderboard dan insight.' },
  { q: 'Berapa lama setup organisasi?', a: 'Setup awal dirancang singkat: masukkan profil organisasi, definisikan value, dan undang anggota. Setelah itu pertanyaan bisa terus disempurnakan sesuai ritme tim.' },
  { q: 'Apa peran member, facilitator, dan admin?', a: 'Member menjawab challenge, facilitator menjalankan sesi dan memberi skor, sedangkan admin mengelola anggota, value, pertanyaan, serta laporan organisasi.' },
  { q: 'Bagaimana scoring dilakukan?', a: 'Scoring dilakukan oleh facilitator atau admin menggunakan skala 0–10 berdasarkan kejelasan, relevansi, dan contoh nyata dalam jawaban.' },
  { q: 'Apakah data organisasi aman?', a: 'Setiap organisasi memiliki konteks dan data yang terisolasi. Akses juga dibatasi berdasarkan autentikasi dan role yang dimiliki pengguna.' },
  { q: 'Apakah ValueLoop cocok untuk tim kecil?', a: 'Ya. ValueLoop dapat dimulai dari ritual sederhana untuk beberapa orang dan berkembang ketika organisasi siap menambah value, pertanyaan, atau tim.' },
];

const heroIcons = [
  { title: 'Challenge', tone: 'text-[#111]', path: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'Skor', tone: 'text-emerald-600', path: 'M5 13l4 4L19 7' },
  { title: 'Leaderboard', tone: 'text-amber-500', path: 'M8 21h8m-4-4v4m-5-17h10v5a5 5 0 0 1-10 0V4Zm10 2h3a3 3 0 0 1-3 3M7 6H4a3 3 0 0 0 3 3' },
  { title: 'Insights', tone: 'text-sky-600', path: 'M4 19h16M7 15v-4m5 4V7m5 8v-6' },
];
---

<BaseLayout
  title="ValueLoop - Ubah Core Value Menjadi Kebiasaan Tim Setiap Hari"
  description="Platform SaaS untuk menghidupkan core value perusahaan lewat daily reflection challenge, scoring berbasis contoh nyata, leaderboard, dan insight."
>
  <script is:inline>document.documentElement.classList.add('js-ready');</script>

  <PublicHeader variant="dark" />

  <main class="bg-white">
    <!-- 1. Hero: hazy sky, centered display type, glass question bar, app rising out of the hills -->
    <section class="hero-sky relative overflow-hidden text-white">
      <div aria-hidden="true" class="hero-sky-clouds pointer-events-none absolute inset-0"></div>

      {!bootstrapReady && (
        <div class="relative mx-auto mt-24 w-full max-w-3xl px-6">
          <div class="flex items-center gap-3 rounded-full border border-white/30 bg-white/15 px-5 py-3 text-sm text-white backdrop-blur-md">
            <span class="flex h-2 w-2 shrink-0 rounded-full bg-amber-300"></span>
            <p>Instalasi baru terdeteksi. Jalankan <code class="rounded bg-white/20 px-1.5 py-0.5 font-mono">npm run setup</code> di terminal untuk inisialisasi user root & organisasi pertama.</p>
          </div>
        </div>
      )}

      <div class="relative mx-auto flex w-full max-w-7xl flex-col items-center px-6 pt-36 text-center sm:pt-40">
        <h1 class="hero-animate-delay-1 text-[3.25rem] font-normal leading-[0.9] tracking-[-0.05em] sm:text-[4.5rem] md:text-[6rem] lg:text-[7.5rem]">
          Value hidup.<br />Setiap hari.
        </h1>

        <form action="/signup" method="get" class="hero-animate-delay-2 mt-10 flex h-16 w-full max-w-[660px] items-center rounded-full border border-white/25 bg-white/15 pl-6 pr-2 backdrop-blur-md">
          <label for="hero-question" class="sr-only">Contoh pertanyaan challenge</label>
          <input id="hero-question" type="text" readonly tabindex="-1" class="min-w-0 flex-1 cursor-default bg-transparent text-left text-base text-white/85 outline-none placeholder:text-white/85" placeholder="Ceritakan momen kamu menolong customer|" />
          <button type="submit" aria-label="Mulai sekarang" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-black transition-transform hover:scale-105">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0-6 6m6-6 6 6"></path></svg>
          </button>
        </form>

        <p class="hero-animate-delay-3 mt-10 max-w-2xl text-xl leading-snug text-white/85 sm:text-2xl">
          Ubah core values jadi kebiasaan kerja nyata
          <span class="whitespace-nowrap">– lewat
            <span class="inline-flex translate-y-1 items-center -space-x-1 align-baseline">
              {heroIcons.map((icon) => (
                <span class={`flex h-8 w-8 items-center justify-center rounded-full bg-white ring-2 ring-white/40 ${icon.tone}`} title={icon.title}>
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon.path} /></svg>
                </span>
              ))}
            </span>
          </span>
        </p>

        <div class="hero-animate-delay-3 mt-10 flex flex-wrap justify-center gap-3">
          <a class="btn-interactive inline-flex h-11 items-center rounded-full bg-white px-6 text-sm font-medium text-black transition-colors hover:bg-white/90" href="/signup">Mulai Gratis</a>
          <a class="btn-interactive inline-flex h-11 items-center gap-2 rounded-full bg-white pl-5 pr-6 text-sm font-medium text-black transition-colors hover:bg-white/85" href="/preview">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
            Lihat preview
          </a>
        </div>

        <div class="hero-animate-delay-4 relative mt-16 w-full max-w-[1024px] sm:mt-20">
          <div class="overflow-hidden rounded-t-2xl border border-b-0 border-white/10 bg-[#0e0e0e] text-left shadow-[0_-10px_60px_rgb(0_0_0_/_0.2)]">
            <div class="flex items-center gap-3 border-b border-white/5 px-4 py-3">
              <div class="flex gap-1.5"><span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span><span class="h-3 w-3 rounded-full bg-[#febc2e]"></span><span class="h-3 w-3 rounded-full bg-[#28c840]"></span></div>
              <div class="mx-auto hidden w-1/2 rounded-md bg-white/5 py-1 text-center text-xs text-white/70 sm:block">app.valueloop.id</div>
            </div>
            <div class="grid h-[340px] grid-cols-1 sm:h-[420px] sm:grid-cols-[180px_1fr]">
              <aside class="hidden border-r border-white/5 bg-[#131314] p-3 sm:block">
                <div class="mb-3 flex items-center gap-2 rounded-md px-2 py-1.5 text-xs text-white/90"><span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500 text-[10px] font-semibold text-white">A</span>Acme Studio</div>
                <div class="space-y-0.5 text-xs text-white/50">
                  <div class="rounded-md bg-white/10 px-2 py-1.5 text-white">Dashboard</div>
                  <div class="px-2 py-1.5">Daily Challenge</div>
                  <div class="px-2 py-1.5">Leaderboard</div>
                  <div class="px-2 py-1.5">History</div>
                  <div class="px-2 py-1.5">Insights</div>
                </div>
                <p class="mt-5 px-2 text-[10px] uppercase tracking-wider text-white/30">Terbaru</p>
                <div class="mt-1 space-y-2 px-2 text-[11px] text-white/70">
                  <p>Rian · Ownership<br /><span class="text-emerald-400/80">● Dinilai 9/10</span></p>
                  <p>Sari · Customer Obsession<br /><span class="text-amber-300/80">● Menunggu skor</span></p>
                  <p>Dimas · Integritas<br /><span class="text-emerald-400/80">● Dinilai 8/10</span></p>
                </div>
              </aside>
              <div class="p-5 sm:p-8">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-sm font-semibold text-white">A</span>
                    <div><p class="text-sm font-medium text-white">Acme Studio</p><p class="text-xs text-white/50">Challenge hari ini siap dimulai</p></div>
                  </div>
                  <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-black">Mulai challenge</span>
                </div>
                <div class="mt-6 grid grid-cols-2 rounded-xl border border-white/5 sm:grid-cols-4 sm:divide-x sm:divide-white/5">
                  <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Member aktif</p><p class="mt-1 text-xl text-white">24</p><p class="text-[10px] text-white/40">5 tim</p></div>
                  <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Challenge</p><p class="mt-1 text-xl text-white">38</p><p class="text-[10px] text-white/40">Bulan ini</p></div>
                  <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Rata-rata</p><p class="mt-1 text-xl text-white">8,4</p><p class="text-[10px] text-white/40">Skor 0–10</p></div>
                  <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Partisipasi</p><p class="mt-1 text-xl text-white">86%</p><p class="text-[10px] text-white/40">Member menjawab</p></div>
                </div>
                <p class="mt-6 text-sm text-white">Core values</p>
                <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
                  {[['Ownership', '12 pertanyaan', 'bg-emerald-500', 'w-4/5'], ['Customer Obsession', '9 pertanyaan', 'bg-sky-500', 'w-3/5'], ['Integritas', '7 pertanyaan', 'bg-amber-400', 'w-2/5']].map(([name, count, color, width]) => (
                    <div class="rounded-lg bg-white/[0.04] p-3">
                      <p class="text-xs text-white">{name}</p>
                      <p class="text-[10px] text-white/40">{count}</p>
                      <div class="mt-6 h-1 rounded-full bg-white/10"><div class={`h-1 rounded-full ${color} ${width}`}></div></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Rolling hills + fog covering the bottom of the mockup -->
      <div aria-hidden="true" class="pointer-events-none relative -mt-40 h-64 sm:-mt-52 sm:h-80">
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
          <defs>
            <linearGradient id="hill-a" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9aae6c" /><stop offset="1" stop-color="#5f7a3e" /></linearGradient>
            <linearGradient id="hill-b" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7f9a52" /><stop offset="1" stop-color="#4e6a33" /></linearGradient>
            <linearGradient id="fog" x1="0" y1="0" x2="0" y2="1"><stop offset="0.35" stop-color="#F4F5F0" stop-opacity="0" /><stop offset="1" stop-color="#F4F5F0" /></linearGradient>
          </defs>
          <path d="M0 120 C 160 60 300 70 420 110 C 520 140 620 150 720 138 C 840 124 940 132 1060 110 C 1180 70 1300 50 1440 90 L1440 320 L0 320 Z" fill="url(#hill-a)" />
          <path d="M0 200 C 220 130 420 140 640 190 C 860 240 1080 170 1260 150 C 1350 140 1410 150 1440 160 L1440 320 L0 320 Z" fill="url(#hill-b)" />
          <rect width="1440" height="320" fill="url(#fog)" />
        </svg>
      </div>
    </section>

    <!-- 2. Problem: centered headline + three sky cards with floating UI -->
    <section class="bg-[#F4F5F0] px-6 pt-20 pb-16 sm:pt-24 lg:pt-28">
      <div class="mx-auto max-w-[1440px]">
        <div class="mx-auto max-w-3xl text-center reveal">
          <h2 class="text-4xl font-medium leading-[1.05] tracking-tighter text-[#111] sm:text-6xl md:text-7xl">Value di dinding.<br />Di mana di tim?</h2>
          <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-[#666] sm:text-lg">Core values sering hanya dibaca saat onboarding. Kebiasaan tumbuh dari apa yang dibicarakan dan dipraktikkan setiap hari.</p>
        </div>

        <div class="mt-14 grid gap-4 md:grid-cols-3">
          <div class="reveal stagger-1">
            <div class="sky-soft relative flex aspect-[4/3.4] items-center overflow-hidden rounded-xl p-6">
              <div class="w-[115%] rounded-2xl bg-white p-6 shadow-[0_7px_29px_0_rgb(100_100_111_/_0.15)]">
                <p class="font-mono text-[11px] uppercase tracking-wider text-[#999]">Lobby · Lantai 3</p>
                <p class="mt-3 text-2xl font-medium leading-tight tracking-tight text-[#111]">"Integrity. Ownership. Customer First."</p>
                <p class="mt-4 text-xs text-[#999]">Terakhir dibaca: saat dipasang</p>
              </div>
            </div>
            <h3 class="mt-4 font-medium text-[#111]">{problems[0].title}</h3>
            <p class="mt-1 max-w-sm text-[15px] text-[#999]">{problems[0].body}</p>
          </div>

          <div class="reveal stagger-2">
            <div class="sky-soft relative flex aspect-[4/3.4] items-center overflow-hidden rounded-xl p-6">
              <div class="w-full rounded-xl bg-white p-4 shadow-[0_7px_29px_0_rgb(100_100_111_/_0.15)]">
                <p class="mb-2 text-xs text-[#999]">Onboarding_Handbook_v7_FINAL.pdf · 48 halaman</p>
                {['Bab 1 · Sejarah perusahaan', 'Bab 2 · Visi & misi', 'Bab 3 · Core values', 'Bab 4 · Kebijakan cuti'].map((row, index) => (
                  <div class="flex items-center justify-between border-t border-[#F4F4F4] py-2 text-sm">
                    <span class="text-[#111]">{row}</span>
                    <span class={`text-xs ${index === 2 ? 'text-[#111]' : 'text-[#999]'}`}>{index === 2 ? 'dibuka 1×' : '—'}</span>
                  </div>
                ))}
              </div>
            </div>
            <h3 class="mt-4 font-medium text-[#111]">{problems[1].title}</h3>
            <p class="mt-1 max-w-sm text-[15px] text-[#999]">{problems[1].body}</p>
          </div>

          <div class="reveal stagger-3">
            <div class="sky-soft relative flex aspect-[4/3.4] items-center justify-end overflow-hidden rounded-xl py-6 pl-10">
              <div class="relative w-full rounded-l-2xl bg-white p-6 shadow-[0_7px_29px_0_rgb(100_100_111_/_0.15)]">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#F4F5F0] px-2.5 py-1 text-xs font-medium text-[#111]"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Ownership</span>
                <p class="mt-3 text-xl font-medium leading-snug tracking-tight text-[#111]">Kapan terakhir kamu menyelesaikan masalah yang bukan tugasmu?</p>
                <div class="absolute -bottom-3 right-6 rounded-xl bg-[#262626] px-4 py-2.5 text-sm text-white shadow-lg">Rian · <span class="text-emerald-400">9/10</span></div>
              </div>
            </div>
            <h3 class="mt-4 font-medium text-[#111]">{problems[2].title}</h3>
            <p class="mt-1 max-w-sm text-[15px] text-[#999]">{problems[2].body}</p>
          </div>
        </div>

        <p class="mt-16 text-center text-[15px] text-[#999] reveal">Kalau value tidak dipraktikkan, kebiasaan lain yang akan tumbuh.</p>
      </div>
    </section>

    <!-- 3. Features carousel -->
    <section id="features" class="bg-white pt-24 sm:pt-28">
      <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6">
        <h2 class="text-lg font-medium text-[#111]">Dibuat berbeda.</h2>
        <div class="flex gap-2">
          <button type="button" data-carousel-prev aria-label="Geser ke kiri" class="flex h-10 w-10 items-center justify-center rounded-full bg-[#F9F9F9] text-[#111] transition-colors hover:bg-[#E9E9E9] disabled:cursor-default disabled:opacity-30">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m0 0 6-6m-6 6 6 6"/></svg>
          </button>
          <button type="button" data-carousel-next aria-label="Geser ke kanan" class="flex h-10 w-10 items-center justify-center rounded-full bg-[#F9F9F9] text-[#111] transition-colors hover:bg-[#E9E9E9] disabled:cursor-default disabled:opacity-30">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>
          </button>
        </div>
      </div>

      <div data-carousel class="no-scrollbar mt-6 flex snap-x snap-mandatory scroll-px-6 gap-2.5 overflow-x-auto scroll-smooth px-6 pb-4">
        {features.map((feature, index) => (
          <article class="w-[min(430px,82vw)] shrink-0 snap-start">
            <div class="sky-soft relative flex aspect-[430/495] items-center overflow-hidden rounded-xl">
              {index === 0 && (
                <div class="mx-auto flex h-12 w-[85%] items-center rounded-full bg-white pl-5 pr-1.5 shadow-[0_0_0_6px_rgb(255_255_255_/_0.4)]">
                  <span class="flex-1 truncate text-sm text-[#111]">Kapan kamu mengambil ownership penuh?<span class="ml-0.5 animate-pulse">|</span></span>
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#111] text-white"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0-6 6m6-6 6 6"/></svg></span>
                </div>
              )}
              {index === 1 && (
                <div class="ml-auto w-[88%] rounded-l-2xl bg-white p-6 shadow-[0_0_0_6px_rgb(255_255_255_/_0.4)]">
                  <p class="text-xs text-[#999]">Rian · Support · Ownership</p>
                  <p class="mt-2 text-6xl font-normal tracking-tighter text-[#111]">9<span class="text-3xl text-[#999]">/10</span></p>
                  <p class="mt-1 text-sm font-medium text-emerald-600">Sangat baik</p>
                  <div class="mt-5 flex gap-1">{Array.from({ length: 10 }, (_, i) => <span class={`h-6 flex-1 rounded ${i < 9 ? 'bg-[#111]' : 'bg-[#E5E5E5]'}`}></span>)}</div>
                </div>
              )}
              {index === 2 && (
                <div class="mx-auto w-[85%] rounded-2xl bg-white p-5 shadow-[0_0_0_6px_rgb(255_255_255_/_0.4)]">
                  <p class="mb-3 text-sm font-medium text-[#111]">Leaderboard · Oktober</p>
                  {[['Rian Pratama', '86'], ['Sari Wulandari', '79'], ['Dimas Arya', '71'], ['Nadia Putri', '64']].map(([name, points], i) => (
                    <div class="flex items-center gap-3 border-t border-[#F4F4F4] py-2.5 text-sm">
                      <span class="w-4 font-mono text-xs text-[#999]">{i + 1}</span>
                      <span class="flex-1 text-[#111]">{name}</span>
                      <span class="font-medium text-[#111]">{points}</span>
                    </div>
                  ))}
                </div>
              )}
              {index === 3 && (
                <div class="mx-auto flex w-[85%] flex-wrap justify-center gap-2">
                  {[['Ownership', 'bg-emerald-500'], ['Customer Obsession', 'bg-sky-500'], ['Integritas', 'bg-amber-400'], ['Kolaborasi', 'bg-rose-400'], ['Craft', 'bg-violet-500'], ['+ Tambah value', 'bg-[#999]']].map(([name, dot]) => (
