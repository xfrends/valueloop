---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { hasAnyUsers } from '../lib/services/bootstrap';
import shots from '../data/preview-shots.json';

const runtime = getCloudflareRuntime(Astro);
const bootstrapReady = runtime?.env?.DB ? await hasAnyUsers(runtime.env.DB) : true;

const problems = [
  { title: 'Poster di dinding', body: 'Dibaca sekali saat dipasang, lalu jadi bagian dari interior kantor.' },
  { title: 'PDF onboarding', body: 'Rapi dan lengkap, tapi jarang dibuka lagi setelah minggu pertama.' },
  { title: 'Ritual ValueLoop', body: 'Satu pertanyaan, satu cerita nyata, satu skor. Diulang setiap hari.' },
];

const features = [
  { title: 'Pertanyaan harian.', body: 'Setiap value punya bank pertanyaan praktis. Randomizer memilih member, value, dan pertanyaan aktif.' },
  { title: 'Skor yang adil.', body: 'Facilitator menilai 0–10 berdasarkan kejelasan, relevansi, dan contoh nyata.' },
  { title: 'Leaderboard sehat.', body: 'Total poin, rata-rata, dan konsistensi partisipasi dalam satu papan.' },
  { title: 'Core values milik tim.', body: 'Tidak terpaku pada 5 value. Tambah, ubah warna, dan nonaktifkan sesuai budaya Anda.' },
  { title: 'History lengkap.', body: 'Setiap challenge tersimpan, lengkap dengan jawaban dan skornya.' },
  { title: 'Insights per value.', body: 'Lihat value yang sudah kuat dan area yang perlu lebih sering dibicarakan.' },
];

// `shot` adalah screenshot asli app (lihat scripts/capture-preview.mjs).
const engineTabs = [
  { key: 'siapkan', shot: shots.values.desktop, path: 'settings/values', alt: 'Halaman Core Values di aplikasi ValueLoop', label: 'Siapkan', title: 'Definisikan value yang benar-benar dipakai', body: 'Tulis core values, perilaku yang diharapkan, dan pertanyaan refleksi. Mulai dari template opsional atau dari nol.', cta: 'Mulai setup', href: '/signup' },
  { key: 'challenge', shot: shots.challenge.desktop, path: 'challenge', alt: 'Halaman Daily Challenge di aplikasi ValueLoop', label: 'Challenge', title: 'Satu pertanyaan, setiap hari', body: 'Randomizer memilih member, value, dan pertanyaan aktif. Hasilnya tersimpan, tidak berubah karena refresh.', cta: 'Lihat challenge', href: '/preview' },
  { key: 'nilai', shot: shots.scoring.desktop, path: 'challenge', alt: 'Form penilaian jawaban di aplikasi ValueLoop', label: 'Nilai', title: 'Skor berbasis contoh nyata', body: 'Facilitator memberi skor 0–10 setelah member menjawab. Sesi yang sudah dinilai terkunci dari reroll.', cta: 'Pelajari scoring', href: '/fitur' },
  { key: 'tumbuh', shot: shots.insights.desktop, path: 'insights', alt: 'Halaman Insights di aplikasi ValueLoop', label: 'Tumbuh', title: 'Kebiasaan yang terlihat', body: 'Leaderboard, history, dan insights menunjukkan value mana yang hidup dan mana yang perlu didorong.', cta: 'Lihat insights', href: '/preview' },
];

const roles = [
  { name: 'Startup', body: 'Budaya terbentuk paling cepat di tahun-tahun awal. ValueLoop membantu founder menanamkan value sejak tim masih kecil, tanpa proses HR yang berat.' },
  { name: 'Tim HR & People', body: 'Ubah program culture dari acara tahunan menjadi ritual harian yang terukur, lengkap dengan history dan insights per value.' },
  { name: 'Agensi', body: 'Jaga standar kerja lintas klien dan tim proyek lewat pertanyaan yang relevan dengan cara kerja agensi Anda.' },
  { name: 'Tim Operasional', body: 'Bawa value seperti keselamatan, ketelitian, dan pelayanan ke briefing pagi, dalam lima menit saja.' },
  { name: 'Founder', body: 'Dengar langsung bagaimana tim menerjemahkan value Anda ke pekerjaan sehari-hari.' },
  { name: 'Perusahaan Retail', body: 'Satukan standar pelayanan di banyak cabang dengan challenge yang sama dan leaderboard per tim.' },
];

const faqs = [
  { q: 'Bagaimana cara kerja ValueLoop?', a: 'Organisasi membuat core values dan pertanyaan, lalu tim menjalankan challenge secara berkala. Jawaban diberi skor manual untuk membentuk leaderboard dan insight.' },
  { q: 'Berapa lama setup organisasi?', a: 'Setup awal dirancang singkat: masukkan profil organisasi, definisikan value, dan undang anggota. Setelah itu pertanyaan bisa terus disempurnakan sesuai ritme tim.' },
  { q: 'Apa peran member, facilitator, dan admin?', a: 'Member menjawab challenge, facilitator menjalankan sesi dan memberi skor, sedangkan admin mengelola anggota, value, pertanyaan, serta laporan organisasi.' },
  { q: 'Bagaimana scoring dilakukan?', a: 'Scoring dilakukan oleh facilitator atau admin menggunakan skala 0–10 berdasarkan kejelasan, relevansi, dan contoh nyata dalam jawaban.' },
  { q: 'Apakah data organisasi aman?', a: 'Setiap organisasi memiliki konteks dan data yang terisolasi. Akses juga dibatasi berdasarkan autentikasi dan role yang dimiliki pengguna.' },
  { q: 'Apakah ValueLoop cocok untuk tim kecil?', a: 'Ya. ValueLoop dapat dimulai dari ritual sederhana untuk beberapa orang dan berkembang ketika organisasi siap menambah value, pertanyaan, atau tim.' },
];

// Hero motion video (file in public/, e.g. '/videos/hero.mp4'). null keeps the static app mockup.
// Served from R2 via /api/assets (supports Range requests, which Safari needs for video).
const heroVideoSrc: string | null = '/api/assets/media/hero-motion.mp4';
const heroVideoWebm: string | null = '/api/assets/media/hero-motion.webm';
const heroVideoPoster: string | null = '/media/hero-motion-poster.jpg';

const heroIcons = [
  { title: 'Challenge', tone: 'text-[#352015]', path: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { title: 'Skor', tone: 'text-emerald-600', path: 'M5 13l4 4L19 7' },
  { title: 'Leaderboard', tone: 'text-amber-500', path: 'M8 21h8m-4-4v4m-5-17h10v5a5 5 0 0 1-10 0V4Zm10 2h3a3 3 0 0 1-3 3M7 6H4a3 3 0 0 0 3 3' },
  { title: 'Insights', tone: 'text-sky-600', path: 'M4 19h16M7 15v-4m5 4V7m5 8v-6' },
];

const siteOrigin = Astro.url.origin;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ValueLoop',
    url: siteOrigin,
    logo: `${siteOrigin}/icon-512.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'ValueLoop',
    url: siteOrigin,
    inLanguage: 'id-ID',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ValueLoop',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: siteOrigin,
    description: 'Ubah core value perusahaan menjadi kebiasaan tim lewat challenge harian, scoring, leaderboard, dan insight.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  },
];
---

<BaseLayout
  title="ValueLoop - Ubah Core Value Menjadi Kebiasaan Tim Setiap Hari"
  description="Platform SaaS untuk menghidupkan core value perusahaan lewat daily reflection challenge, scoring berbasis contoh nyata, leaderboard, dan insight."
  jsonLd={structuredData}
>
  <script is:inline>document.documentElement.classList.add('js-ready');</script>

  <PublicHeader variant="wall" />

  <main class="bg-white">
    <!-- 1. Hero: fullscreen office wall + floor. On scroll the framed values poster falls off its nail
         and the ValueLoop motion grows out of the spot where it hung (see initHeroSequence). -->
    <section data-hero-scroll class="hero-sequence relative">
      <div data-hero-stage class="hero-stage hero-wall overflow-hidden text-[#352015]">
        <div aria-hidden="true" class="hero-floor"></div>

        {!bootstrapReady && (
          <div class="absolute inset-x-0 top-20 z-30 mx-auto w-full max-w-3xl px-6">
            <div class="flex items-center gap-3 rounded-full border border-black/10 bg-white/60 px-5 py-3 text-sm text-[#352015] backdrop-blur-md">
              <span class="flex h-2 w-2 shrink-0 rounded-full bg-amber-400"></span>
              <p>Instalasi baru terdeteksi. Jalankan <code class="rounded bg-black/5 px-1.5 py-0.5 font-mono">npm run setup</code> di terminal untuk inisialisasi user root & organisasi pertama.</p>
            </div>
          </div>
        )}

        <div class="hero-content relative z-10 mx-auto flex w-full max-w-7xl items-center px-6 text-center">
          <div class="grid w-full items-center gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
            <div data-hero-copy class="flex flex-col items-center lg:items-start lg:text-left">
              <h1 class="hero-animate-delay-1 text-[3.25rem] font-normal leading-[0.9] tracking-[-0.05em] sm:text-[4.5rem] md:text-[6rem] lg:text-[4.75rem] xl:text-[5.5rem]">
                Dari bingkai<br />ke kebiasaan.
              </h1>

              <form action="/signup" method="get" class="hero-animate-delay-2 mt-8 flex h-14 w-full max-w-[560px] items-center rounded-full border border-black/10 bg-white/70 pl-6 pr-2 shadow-sm backdrop-blur-md sm:mt-10 sm:h-16">
                <label for="hero-question" class="sr-only">Contoh pertanyaan challenge</label>
                <input id="hero-question" type="text" readonly tabindex="-1" class="min-w-0 flex-1 cursor-default bg-transparent text-left text-base text-[#352015]/70 outline-none placeholder:text-[#352015]/70" placeholder="Ceritakan momen kamu menolong customer|" />
                <button type="submit" aria-label="Mulai sekarang" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#352015] text-white transition-transform hover:scale-105">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0-6 6m6-6 6 6"></path></svg>
                </button>
              </form>

              <p class="hero-animate-delay-3 mt-8 hidden max-w-xl text-xl leading-snug text-[#352015]/75 sm:block sm:text-2xl">
                Ubah core values jadi kebiasaan kerja nyata
                <span class="whitespace-nowrap">– lewat
                  <span class="inline-flex translate-y-1 items-center -space-x-1 align-baseline">
                    {heroIcons.map((icon) => (
                      <span class={`flex h-8 w-8 items-center justify-center rounded-full bg-white ring-2 ring-[#EBE2D5] ${icon.tone}`} title={icon.title}>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icon.path} /></svg>
                      </span>
                    ))}
                  </span>
                </span>
              </p>

              <div class="hero-animate-delay-3 mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
                <a class="btn-interactive inline-flex h-11 items-center rounded-full bg-[#352015] px-6 text-sm font-medium text-white transition-colors hover:bg-[#352015]/85" href="/signup">Mulai Gratis</a>
                <a class="btn-interactive inline-flex h-11 items-center gap-2 rounded-full border border-black/10 bg-white pl-5 pr-6 text-sm font-medium text-[#352015] transition-colors hover:bg-white/80" href="/preview">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
                  Lihat preview
                </a>
              </div>
            </div>

            <!-- Frame only on desktop, where it drives the scroll sequence; mobile goes straight from copy to video. -->
            <figure class="hero-animate-delay-2 hidden flex-col items-center lg:flex">
              <div class="relative">
                <span aria-hidden="true" data-hero-nail class="wall-nail"></span>
                <div data-hero-fall class="hero-fall">
                  <div class="wall-frame wall-frame--loose w-[200px] p-3 sm:w-[300px] sm:p-4 lg:w-[360px] lg:p-5">
                    <div class="border border-[#E6DCCD] px-4 py-5 saturate-50 sm:px-6 sm:py-6">
                      <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#8a8177]">Our Core Values</p>
                      <div class="mt-3 space-y-1 font-serif text-base leading-tight text-[#3d3832] sm:text-xl lg:text-2xl">
                        <p>Integrity</p>
                        <p>Ownership</p>
                        <p>Customer First</p>
                      </div>
                      <div class="mx-auto mt-4 h-px w-10 bg-[#cfc6b6]"></div>
                    </div>
                  </div>
                </div>
              </div>
              <figcaption data-hero-plaque class="mt-5 rounded-sm bg-[#D6CEBF] px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-[#6f665b] shadow-[inset_0_1px_0_rgb(255_255_255_/_0.5)]">Dipasang 2019 · Terakhir dibaca: saat dipasang</figcaption>
            </figure>
          </div>
        </div>

        <!-- Product motion: set heroVideoSrc to swap the static app mockup for a video -->
        <div data-hero-media class="hero-media z-20">
          {heroVideoSrc ? (
            <div class="relative h-full w-full">
              <video data-hero-video class="h-full w-full rounded-2xl bg-[#EBE2D5] object-cover shadow-[0_40px_80px_-30px_rgba(40,30,20,0.45)] ring-1 ring-black/5" poster={heroVideoPoster ?? undefined} muted loop playsinline preload="metadata" aria-label="Motion ValueLoop: dari bingkai ke kebiasaan">
                {heroVideoWebm && <source src={heroVideoWebm} type="video/webm" />}
                <source src={heroVideoSrc} type="video/mp4" />
              </video>
              <!-- Browsers only autoplay muted video, so sound is opt-in via this toggle. -->
              <button type="button" data-hero-sound aria-pressed="false" aria-label="Nyalakan suara" class="absolute bottom-2 right-2 z-10 inline-flex items-center gap-2 rounded-full bg-[#352015]/85 p-2 sm:bottom-4 sm:right-4 sm:px-3.5 sm:py-2 text-xs font-medium text-white shadow-lg transition hover:bg-[#352015] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#352015]">
                <svg data-icon-muted class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path d="m22 9-6 6m0-6 6 6"/></svg>
                <svg data-icon-sound class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
                <span data-sound-label class="hidden sm:inline">Suara</span>
              </button>
            </div>
          ) : (
            <div class="flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#24140C] text-left">
              <div class="flex items-center gap-3 border-b border-white/5 px-4 py-3">
                <div class="flex gap-1.5"><span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span><span class="h-3 w-3 rounded-full bg-[#febc2e]"></span><span class="h-3 w-3 rounded-full bg-[#28c840]"></span></div>
                <div class="mx-auto hidden w-1/2 rounded-md bg-white/5 py-1 text-center text-xs text-white/70 sm:block">app.valueloop.id</div>
              </div>
              <div class="grid min-h-0 flex-1 grid-cols-1 sm:grid-cols-[180px_1fr]">
                <aside class="hidden border-r border-white/5 bg-[#2B1A10] p-3 sm:block">
                  <div class="mb-3 flex items-center gap-2 rounded-md px-2 py-1.5 text-xs text-white/90"><span class="flex h-5 w-5 items-center justify-center rounded bg-emerald-500 text-[10px] font-semibold text-white">A</span>Acme Studio</div>
                  <div class="space-y-0.5 text-xs text-white/50">
                    <div class="rounded-md bg-white/10 px-2 py-1.5 text-white">Dashboard</div>
                    <div class="px-2 py-1.5">Daily Challenge</div>
                    <div class="px-2 py-1.5">Leaderboard</div>
                    <div class="px-2 py-1.5">History</div>
                    <div class="px-2 py-1.5">Insights</div>
                  </div>
                  <p class="mt-5 px-2 text-[10px] uppercase tracking-wider text-white/30">Terbaru</p>
                  <div class="mt-1 space-y-2 px-2 text-[11px] text-white/70">
                    <p>Rian · Ownership<br /><span class="text-emerald-400/80">● Dinilai 9/10</span></p>
                    <p>Sari · Customer Obsession<br /><span class="text-amber-300/80">● Menunggu skor</span></p>
                    <p>Dimas · Integritas<br /><span class="text-emerald-400/80">● Dinilai 8/10</span></p>
                  </div>
                </aside>
                <div class="p-5 sm:p-8">
                  <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500 text-sm font-semibold text-white">A</span>
                      <div><p class="text-sm font-medium text-white">Acme Studio</p><p class="text-xs text-white/50">Challenge hari ini siap dimulai</p></div>
                    </div>
                    <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-black">Mulai challenge</span>
                  </div>
                  <div class="mt-6 grid grid-cols-2 rounded-xl border border-white/5 sm:grid-cols-4 sm:divide-x sm:divide-white/5">
                    <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Member aktif</p><p class="mt-1 text-xl text-white">24</p><p class="text-[10px] text-white/40">5 tim</p></div>
                    <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Challenge</p><p class="mt-1 text-xl text-white">38</p><p class="text-[10px] text-white/40">Bulan ini</p></div>
                    <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Rata-rata</p><p class="mt-1 text-xl text-white">8,4</p><p class="text-[10px] text-white/40">Skor 0–10</p></div>
                    <div class="p-4 text-center"><p class="text-[10px] uppercase tracking-wider text-white/40">Partisipasi</p><p class="mt-1 text-xl text-white">86%</p><p class="text-[10px] text-white/40">Member menjawab</p></div>
                  </div>
                  <p class="mt-6 text-sm text-white">Core values</p>
                  <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
                    {[['Ownership', '12 pertanyaan', 'bg-emerald-500', 'w-4/5'], ['Customer Obsession', '9 pertanyaan', 'bg-sky-500', 'w-3/5'], ['Integritas', '7 pertanyaan', 'bg-amber-400', 'w-2/5']].map(([name, count, color, width]) => (
                      <div class="rounded-lg bg-white/[0.04] p-3">
                        <p class="text-xs text-white">{name}</p>
                        <p class="text-[10px] text-white/40">{count}</p>
                        <div class="mt-6 h-1 rounded-full bg-white/10"><div class={`h-1 rounded-full ${color} ${width}`}></div></div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        <div aria-hidden="true" data-hero-hint class="hero-hint absolute inset-x-0 bottom-6 z-10 flex flex-col items-center gap-1 text-xs font-medium text-[#5c5348]">
          <span>Scroll</span>
          <svg class="h-4 w-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6"/></svg>
        </div>
      </div>
    </section>

    <!-- 2. Problem: centered headline + three wall cards (framed poster, PDF, ValueLoop ritual) -->
    <section class="bg-[#EBE2D5] px-6 pt-24 pb-16 sm:pt-32">
      <div class="mx-auto max-w-[1440px]">
        <div class="mx-auto max-w-3xl text-center reveal">
          <h2 class="text-4xl font-medium leading-[1.05] tracking-tighter text-[#352015] sm:text-6xl md:text-7xl">Terpajang di dinding.<br />Terlupa saat bekerja.</h2>
          <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-[#7A685B] sm:text-lg">Di banyak perusahaan, core values hanya dibaca sekali saat onboarding. Padahal budaya kerja terbentuk dari apa yang dibahas dan dilakukan tim setiap hari.</p>
        </div>

        <div class="mt-14 grid gap-4 md:grid-cols-3">
          <div class="reveal stagger-1">
            <div class="wall-soft flex aspect-[4/3.4] flex-col items-center justify-center overflow-hidden rounded-xl p-6 pt-14">
              <div class="wall-frame w-[72%] p-3 opacity-90 saturate-50">
                <div class="border border-[#E6DCCD] px-4 py-5 text-center">
                  <p class="font-mono text-[9px] uppercase tracking-[0.3em] text-[#8a8177]">Our Values</p>
                  <p class="mt-2 font-serif text-lg leading-snug text-[#3d3832]">Integrity.<br />Ownership.<br />Customer First.</p>
                </div>
              </div>
              <p class="mt-5 rounded-sm bg-[#D6CEBF] px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-[#6f665b]">Lobby · Lantai 3 · Terakhir dibaca: saat dipasang</p>
            </div>
            <h3 class="mt-4 font-medium text-[#352015]">{problems[0].title}</h3>
            <p class="mt-1 max-w-sm text-[15px] text-[#A39384]">{problems[0].body}</p>
          </div>

          <div class="reveal stagger-2">
            <div class="wall-soft flex aspect-[4/3.4] items-center overflow-hidden rounded-xl p-6">
              <div class="w-full rounded-xl bg-white p-4 shadow-[0_7px_29px_0_rgb(100_100_111_/_0.15)]">
                <p class="mb-2 text-xs text-[#A39384]">Onboarding_Handbook_v7_FINAL.pdf · 48 halaman</p>
                {['Bab 1 · Sejarah perusahaan', 'Bab 2 · Visi & misi', 'Bab 3 · Core values', 'Bab 4 · Kebijakan cuti'].map((row, index) => (
                  <div class="flex items-center justify-between border-t border-[#F3ECE1] py-2 text-sm">
                    <span class="text-[#352015]">{row}</span>
                    <span class={`text-xs ${index === 2 ? 'text-[#352015]' : 'text-[#A39384]'}`}>{index === 2 ? 'dibuka 1×' : '—'}</span>
                  </div>
                ))}
              </div>
            </div>
            <h3 class="mt-4 font-medium text-[#352015]">{problems[1].title}</h3>
            <p class="mt-1 max-w-sm text-[15px] text-[#A39384]">{problems[1].body}</p>
          </div>

          <div class="reveal stagger-3">
            <div class="wall-soft flex aspect-[4/3.4] items-center justify-end overflow-hidden rounded-xl py-6 pl-10">
              <div class="relative w-full rounded-l-2xl bg-white p-6 shadow-[0_7px_29px_0_rgb(100_100_111_/_0.15)]">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#EBE2D5] px-2.5 py-1 text-xs font-medium text-[#352015]"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Ownership</span>
                <p class="mt-3 text-xl font-medium leading-snug tracking-tight text-[#352015]">Kapan terakhir kamu menyelesaikan masalah yang bukan tugasmu?</p>
