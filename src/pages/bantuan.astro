---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<BaseLayout
  title="Bantuan - ValueLoop"
  description="Pusat bantuan dan dukungan untuk pengguna ValueLoop."
>
    <PublicHeader />
  
  <main class="public-main public-hero public-container relative z-10 flex min-h-[60vh] flex-col items-center justify-center text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50/50 px-4 py-1.5 text-sm font-medium text-indigo-900 mb-8 shadow-sm backdrop-blur-sm">
      Pusat Bantuan
    </div>
    <h1 class="public-title text-4xl md:text-6xl font-bold mb-6">Butuh Bantuan?</h1>
    <p class="public-lead max-w-2xl mx-auto text-lg leading-relaxed">
      Halaman dokumentasi bantuan sedang kami siapkan. Jika Anda memiliki pertanyaan atau kendala, silakan hubungi tim dukungan kami melalui email.
    </p>
    <a href="mailto:demo@valueloop.com" class="mt-10 rounded-full bg-indigo-700 px-8 py-3 font-semibold text-white shadow-xl shadow-indigo-700/20 hover:bg-indigo-800 transition-all hover:-translate-y-0.5">
      Hubungi Support
    </a>
    <a href="/" class="mt-4 text-slate-500 hover:text-slate-800 font-medium transition-colors">
      Kembali ke Beranda
    </a>
  </main>

  <PublicFooter />
</BaseLayout>
