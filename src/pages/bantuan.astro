---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
---

<BaseLayout
  title="Bantuan - ValueLoop"
  description="Pusat bantuan dan dukungan untuk pengguna ValueLoop."
>
    <PublicHeader />
  
  <main class="mx-auto w-full max-w-7xl px-6 py-24 text-center relative z-10 min-h-[60vh] flex flex-col justify-center items-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50/50 px-4 py-1.5 text-sm font-medium text-blue-900 mb-8 shadow-sm backdrop-blur-sm">
      Pusat Bantuan
    </div>
    <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">Butuh Bantuan?</h1>
    <p class="text-xl text-slate-600 max-w-2xl mx-auto">
      Halaman dokumentasi bantuan sedang kami siapkan. Jika Anda memiliki pertanyaan atau kendala, silakan hubungi tim dukungan kami melalui email.
    </p>
    <a href="mailto:demo@valueloop.com" class="mt-10 rounded-full bg-blue-700 px-8 py-3 font-semibold text-white shadow-xl shadow-blue-700/20 hover:bg-blue-800 transition-all hover:-translate-y-0.5">
      Hubungi Support
    </a>
    <a href="/" class="mt-4 text-slate-500 hover:text-slate-800 font-medium transition-colors">
      Kembali ke Beranda
    </a>
  </main>

  <PublicFooter />
</BaseLayout>
