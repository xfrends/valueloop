---
import AppLayout from '../layouts/AppLayout.astro';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { listChallengeSessions } from '../lib/services/challenge';
import { listOrganizationMembers } from '../lib/services/members';
import { listCoreValues } from '../lib/services/values';
import { formatOrgDateTime } from '../lib/utils/date';
import DataTable from '../components/DataTable.astro';
import TableToolbar from '../components/TableToolbar.astro';
import TableFilterDialog from '../components/TableFilterDialog.astro';

const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);

const memberId = Astro.url.searchParams.get('memberId') || '';
const valueId = Astro.url.searchParams.get('valueId') || '';
const status = Astro.url.searchParams.get('status') || '';
const fromDate = Astro.url.searchParams.get('fromDate') || '';
const toDate = Astro.url.searchParams.get('toDate') || '';
const query = Astro.url.searchParams.get('query') || '';

const members = organization && runtime?.env?.DB ? await listOrganizationMembers(runtime.env.DB, organization.id) : [];
const values = organization && runtime?.env?.DB ? await listCoreValues(runtime.env.DB, organization.id) : [];

const historyData = organization && runtime?.env?.DB ? await listChallengeSessions(runtime.env.DB, organization.id, { 
  limit: 25,
  memberId: memberId || undefined,
  valueId: valueId || undefined,
  status: status || undefined,
  fromDate: fromDate || undefined,
  toDate: toDate || undefined,
}) : [];
---

<AppLayout title="Challenge History - ValueLoop" currentPath="/history">
  
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-200/60 pb-6">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-indigo-600 mb-1">Organization</p>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Challenge History</h1>
        <p class="text-slate-500 mt-1 text-sm leading-relaxed">Review past challenges, answers, and scores.</p>
      </div>
      
      <div class="flex items-center gap-3">
        <TableToolbar action="/history" searchValue={query} searchPlaceholder="Search member or value..." submitLabel="Cari">
          <Fragment slot="filters">
            <input type="hidden" name="memberId" value={memberId} /><input type="hidden" name="valueId" value={valueId} /><input type="hidden" name="status" value={status} /><input type="hidden" name="fromDate" value={fromDate} /><input type="hidden" name="toDate" value={toDate} />
          </Fragment>
        </TableToolbar>
        <button onclick="document.getElementById('filterModal').showModal()" class="btn-interactive flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-xl text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition-colors">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
          Filters
        </button>
      </div>
    </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <DataTable class="rounded-none border-0 shadow-none" tableClass="">
      <table class="w-full text-left">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-sm">
          <tr>
            <th class="px-6 py-4 font-medium">Date & ID</th>
            <th class="px-6 py-4 font-medium">Member</th>
            <th class="px-6 py-4 font-medium">Core Value</th>
            <th class="px-6 py-4 font-medium">Status</th>
            <th class="px-6 py-4 font-medium text-right">Score</th>
            <th class="px-6 py-4 font-medium text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          {historyData.length === 0 ? (
            <tr>
              <td colspan="6" class="px-6 py-12 text-center text-sm text-slate-500">
                Belum ada data history yang ditemukan. Coba ubah filter yang dipilih.
              </td>
            </tr>
          ) : historyData.map((row) => (
            <tr class="hover:bg-slate-50 transition-colors group cursor-pointer">
              <td class="px-6 py-4">
                <div class="font-medium text-slate-900">{formatOrgDateTime(new Date(row.created_at), organization?.timezone || 'Asia/Jakarta')}</div>
                <div class="text-slate-400 text-xs mt-0.5">#{row.sequence_no}</div>
              </td>
              <td class="px-6 py-4">
                <div class="font-medium text-slate-900">{row.member_name}</div>
                <div class="text-slate-500 text-xs mt-0.5">{row.member_team || '-'}</div>
              </td>
              <td class="px-6 py-4">
                <span class="inline-flex px-2.5 py-1 bg-indigo-50 text-indigo-800 text-xs font-medium rounded-md border border-indigo-100">
                  {row.value_name}
                </span>
              </td>
              <td class="px-6 py-4">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full ${
                  row.status === 'scored' ? 'bg-green-100 text-green-800' :
                  row.status === 'answered' ? 'bg-amber-100 text-amber-800' :
                  'bg-slate-100 text-slate-600'
                }`}>
                  {row.status === 'scored' && <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>}
                  {row.status === 'answered' && <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>}
                  {row.status === 'cancelled' && <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>}
                  {row.status}
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                {row.score !== null ? (
                  <span class="font-bold text-slate-900 text-base">{row.score}<span class="text-slate-400 text-xs font-normal">/10</span></span>
                ) : (
                  <span class="text-slate-400">-</span>
                )}
              </td>
              <td class="px-6 py-4 flex justify-end">
                <a href={`/history/${row.id}`} title="View Detail" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-100 hover:text-indigo-800 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      </DataTable>
    </div>
    
    <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
      <p class="text-sm text-slate-500">Showing {historyData.length} results</p>
      <div class="flex gap-2">
        <button class="px-3 py-1 rounded bg-white border border-slate-300 text-slate-500 text-sm font-medium shadow-sm hover:bg-slate-50 disabled:opacity-50" disabled>Prev</button>
        <button class="px-3 py-1 rounded bg-white border border-slate-300 text-slate-700 text-sm font-medium shadow-sm hover:bg-slate-50 disabled:opacity-50" disabled>Next</button>
      </div>
    </div>
  </div>

  </div>

  <TableFilterDialog id="filterModal" title="Filter History">
    <form method="get" class="bg-white p-6">
      <input type="hidden" name="query" value={query} />
      <div class="flex items-center justify-between mb-5 border-b border-slate-100 pb-4">
        <h2 class="sr-only">Filter History</h2>
        <div class="flex items-center gap-2">
          <a href="/history" title="Reset Filters" class="px-3 py-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">Reset</a>
          <button type="submit" title="Terapkan Filter" class="btn-interactive px-3 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors shadow-sm">Filter</button>
        </div>
      </div>
      
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700">Dari Tanggal</label>
            <input type="date" name="fromDate" value={fromDate} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-sm font-semibold text-slate-700">Sampai Tanggal</label>
            <input type="date" name="toDate" value={toDate} class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors" />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700">Member</label>
          <select name="memberId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
            <option value="">Semua Member</option>
            {members.map((m) => (
              <option value={m.id} selected={m.id === memberId}>{m.full_name}</option>
            ))}
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700">Core Value</label>
          <select name="valueId" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
            <option value="">Semua Value</option>
            {values.map((v) => (
              <option value={v.id} selected={v.id === valueId}>{v.name}</option>
            ))}
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sm font-semibold text-slate-700">Status</label>
          <select name="status" class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 bg-white cursor-pointer transition-colors">
            <option value="">Semua Status</option>
            <option value="open" selected={status === 'open'}>Open</option>
            <option value="answered" selected={status === 'answered'}>Answered</option>
            <option value="scored" selected={status === 'scored'}>Scored</option>
            <option value="cancelled" selected={status === 'cancelled'}>Cancelled</option>
          </select>
        </div>
      </div>
    </form>
  </TableFilterDialog>

</AppLayout>
