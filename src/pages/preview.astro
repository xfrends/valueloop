---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';
import shots from '../data/preview-shots.json';

// Screenshot asli dari app (workspace demo). Perbarui dengan:
//   node scripts/seed-preview-demo.mjs && node scripts/capture-preview.mjs
const views = [
  { id: 'dashboard', label: 'Dashboard', path: 'dashboard', caption: 'Ringkasan harian: challenge hari ini, member aktif, skor rata-rata, dan value yang paling sering dibahas.' },
  { id: 'challenge', label: 'Daily Challenge', path: 'challenge', caption: 'Randomizer memilih member, value, dan pertanyaan. Fasilitator mencatat jawaban langsung di halaman ini.' },
  { id: 'scoring', label: 'Scoring', path: 'challenge', caption: 'Setelah jawaban terkirim, fasilitator memberi skor 0–10 beserta catatan penilaian.' },
  { id: 'leaderboard', label: 'Leaderboard', path: 'leaderboard', caption: 'Peringkat member berdasarkan total poin, skor rata-rata, dan jumlah challenge yang dijawab.' },
  { id: 'history', label: 'History', path: 'history', caption: 'Semua challenge tersimpan: siapa yang terpilih, value, jawaban, skor, dan penilainya.' },
  { id: 'insights', label: 'Insights', path: 'insights', caption: 'Tren skor mingguan, sebaran skor, cakupan tiap value, dan perbandingan antar tim.' },
  { id: 'values', label: 'Core Values', path: 'settings/values', caption: 'Kelola core values organisasi beserta perilaku yang diharapkan dan bank pertanyaannya.' },
].map((view) => ({ ...view, shot: shots[view.id as keyof typeof shots].desktop }));
---

<BaseLayout title="Preview ValueLoop - Lihat Cara Kerjanya" description="Lihat screenshot asli aplikasi ValueLoop dengan data contoh: dashboard, daily challenge, scoring, leaderboard, history, insights, dan core values.">
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  <PublicHeader />
  <main class="public-main relative z-10 overflow-hidden">
    <section class="public-hero px-6 pb-14 pt-20 md:pb-20 md:pt-28"><div class="mx-auto max-w-7xl text-center"><div class="hero-animate inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-4 py-1.5 text-sm font-semibold text-indigo-800 shadow-sm"><span class="h-2 w-2 rounded-full bg-indigo-600"></span>Preview</div><h1 class="public-title hero-animate-delay-1 mx-auto mt-7 max-w-3xl text-4xl font-extrabold sm:text-6xl">Lihat ValueLoop bekerja <span class="text-indigo-600">sebelum mulai.</span></h1><p class="public-lead hero-animate-delay-2 mx-auto mt-5 max-w-2xl text-lg leading-relaxed">Ini screenshot asli dari aplikasi ValueLoop, diambil dari workspace demo berisi data contoh. Pilih tampilan, lalu gulir di dalam bingkai untuk melihat halaman selengkapnya.</p></div></section>
    <section class="border-y border-slate-200 bg-slate-50 py-10 md:py-14"><div class="mx-auto max-w-7xl px-6">
      <div class="overflow-x-auto pb-2"><div role="tablist" aria-label="Tampilan preview" class="mx-auto flex w-max gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
        {views.map((view, index) => (
          <button type="button" id={`preview-tab-${view.id}`} data-tab={view.id} role="tab" aria-controls={`preview-panel-${view.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} class="preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50 aria-selected:bg-slate-900 aria-selected:text-white">{view.label}</button>
        ))}
      </div></div>
      <div class="mx-auto mt-8 max-w-6xl overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl">
        <div class="flex items-center justify-between gap-4 border-b border-slate-100 px-4 py-3 sm:px-5">
          <div class="flex min-w-0 items-center gap-3"><div class="flex shrink-0 gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span></div><span id="preview-url" class="truncate font-mono text-xs text-slate-400">app.valueloop / {views[0].path}</span></div>
          <span class="shrink-0 rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">Demo data</span>
        </div>
        {views.map((view, index) => (
          <div id={`preview-panel-${view.id}`} data-panel={view.id} data-path={view.path} role="tabpanel" tabindex="0" aria-labelledby={`preview-tab-${view.id}`} hidden={index !== 0} class="preview-panel max-h-[min(78vh,860px)] overflow-auto overscroll-contain focus:outline-none">
            <img src={view.shot.src} width={view.shot.width} height={view.shot.height} alt={`Screenshot halaman ${view.label} di aplikasi ValueLoop. ${view.caption}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" class="block h-auto w-full min-w-[760px] md:min-w-0" />
          </div>
        ))}
      </div>
      {views.map((view, index) => (
        <p data-caption={view.id} hidden={index !== 0} class="mx-auto mt-5 max-w-2xl text-center text-sm text-slate-600">{view.caption} <a href={view.shot.src} target="_blank" rel="noopener" class="font-semibold text-indigo-700 underline-offset-2 hover:underline">Buka ukuran penuh</a></p>
      ))}
      <p class="mt-3 text-center text-xs text-slate-500">Semua nama, angka, dan jawaban di halaman ini hanya contoh untuk membantu Anda memahami alurnya.</p>
    </div></section>
    <section class="bg-white py-20"><div class="mx-auto flex max-w-4xl flex-col items-center px-6 text-center"><h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Rasakan alurnya bersama tim Anda.</h2><p class="mt-4 max-w-xl text-lg text-slate-600">Bangun ritual yang sederhana, terukur, dan relevan dengan organisasi Anda.</p><div class="mt-8 flex flex-wrap justify-center gap-4"><a href="/signup" class="btn-shimmer btn-interactive rounded-full bg-indigo-600 px-7 py-3.5 font-semibold text-white shadow-lg shadow-indigo-600/20 hover:bg-indigo-700">Mulai sekarang</a><a href="/fitur" class="btn-interactive rounded-full border border-slate-200 px-7 py-3.5 font-semibold text-slate-700 hover:border-indigo-200 hover:text-indigo-700">Kembali ke fitur</a></div></div></section>
  </main>
  <PublicFooter />
  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.preview-tab'));
    const panels = document.querySelectorAll<HTMLElement>('.preview-panel');
    const captions = document.querySelectorAll<HTMLElement>('[data-caption]');
    const url = document.querySelector<HTMLElement>('#preview-url');
    function selectTab(id: string, focus = false) {
      tabs.forEach((tab) => { const active = tab.dataset.tab === id; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; if (active && focus) tab.focus(); if (active) tab.scrollIntoView({ block: 'nearest', inline: 'nearest' }); });
      panels.forEach((panel) => { const active = panel.dataset.panel === id; panel.hidden = !active; if (active) { panel.scrollTo(0, 0); if (url) url.textContent = `app.valueloop / ${panel.dataset.path}`; } });
      captions.forEach((caption) => { caption.hidden = caption.dataset.caption !== id; });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab.dataset.tab || 'dashboard'));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        selectTab(tabs[(index + step + tabs.length) % tabs.length].dataset.tab || 'dashboard', true);
      });
    });
  </script>
</BaseLayout>
