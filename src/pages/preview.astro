---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHeader from '../components/PublicHeader.astro';
import PublicFooter from '../components/PublicFooter.astro';

---

<BaseLayout title="Preview ValueLoop - Lihat Cara Kerjanya" description="Jelajahi demo interaktif ValueLoop dengan data contoh untuk dashboard, challenge, scoring, leaderboard, dan insights.">
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  <PublicHeader />
  <main class="public-main relative z-10 overflow-hidden">
    <section class="public-hero px-6 pb-14 pt-20 md:pb-20 md:pt-28"><div class="mx-auto max-w-7xl text-center"><div class="hero-animate inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-4 py-1.5 text-sm font-semibold text-indigo-800 shadow-sm"><span class="h-2 w-2 rounded-full bg-indigo-600"></span>Preview</div><h1 class="public-title hero-animate-delay-1 mx-auto mt-7 max-w-3xl text-4xl font-extrabold sm:text-6xl">Lihat ValueLoop bekerja <span class="text-indigo-600">sebelum mulai.</span></h1><p class="public-lead hero-animate-delay-2 mx-auto mt-5 max-w-2xl text-lg leading-relaxed">Ini adalah workspace demo dengan data contoh. Pilih tampilan untuk melihat bagaimana tiap langkah terhubung.</p></div></section>
    <section class="border-y border-slate-200 bg-slate-50 py-10 md:py-14"><div class="mx-auto max-w-7xl px-6"><div class="overflow-x-auto pb-2"><div role="tablist" aria-label="Tampilan preview" class="mx-auto flex min-w-max justify-center gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm"><button data-tab="dashboard" role="tab" aria-selected="true" class="preview-tab rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white">Dashboard</button><button data-tab="challenge" role="tab" aria-selected="false" class="preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50">Daily Challenge</button><button data-tab="scoring" role="tab" aria-selected="false" class="preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50">Scoring</button><button data-tab="leaderboard" role="tab" aria-selected="false" class="preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50">Leaderboard</button><button data-tab="insights" role="tab" aria-selected="false" class="preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-500 hover:bg-slate-50">Insights</button></div></div>
      <div class="mx-auto mt-8 max-w-6xl rounded-3xl border border-slate-200 bg-white p-3 shadow-2xl sm:p-5"><div class="rounded-2xl border border-slate-100 bg-white p-5 sm:p-8"><div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-5"><div class="flex items-center gap-3"><div class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span></div><span class="hidden text-xs font-mono text-slate-400 sm:inline">demo.valueloop / workspace</span></div><span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">Demo data</span></div>
        <div id="preview-content" class="pt-7" aria-live="polite"></div>
      </div></div>
      <p class="mt-5 text-center text-xs text-slate-500">Semua nama, angka, dan jawaban di halaman ini hanya contoh untuk membantu Anda memahami alurnya.</p>
    </div></section>
    <section class="bg-white py-20"><div class="mx-auto flex max-w-4xl flex-col items-center px-6 text-center"><h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Rasakan alurnya bersama tim Anda.</h2><p class="mt-4 max-w-xl text-lg text-slate-600">Bangun ritual yang sederhana, terukur, dan relevan dengan organisasi Anda.</p><div class="mt-8 flex flex-wrap justify-center gap-4"><a href="/signup" class="btn-shimmer btn-interactive rounded-full bg-indigo-600 px-7 py-3.5 font-semibold text-white shadow-lg shadow-indigo-600/20 hover:bg-indigo-700">Mulai sekarang</a><a href="/fitur" class="btn-interactive rounded-full border border-slate-200 px-7 py-3.5 font-semibold text-slate-700 hover:border-indigo-200 hover:text-indigo-700">Kembali ke fitur</a></div></div></section>
  </main>
  <PublicFooter />
  <script>
    const previewData = {
      dashboard: `<div class="grid gap-6 lg:grid-cols-[1fr_0.75fr]"><div><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Senin, 18 Maret 2024</p><h2 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">Selamat pagi, Rian.</h2><p class="mt-2 text-slate-600">Satu percakapan kecil hari ini bisa memperkuat cara kerja tim.</p><div class="mt-7 rounded-2xl bg-indigo-600 p-5 text-white sm:p-6"><div class="flex items-start justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-wider text-indigo-200">Challenge hari ini</p><h3 class="mt-2 text-xl font-bold">Customer Obsession</h3></div><span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">Belum mulai</span></div><p class="mt-5 text-sm leading-relaxed text-indigo-100">Ceritakan satu momen ketika Anda membuat pengalaman customer menjadi lebih baik.</p><button class="mt-5 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-indigo-700">Mulai challenge →</button></div></div><div class="grid grid-cols-2 gap-3 self-start lg:grid-cols-1"><div class="rounded-2xl border border-slate-200 p-5"><p class="text-sm text-slate-500">Partisipasi tim</p><p class="mt-2 text-3xl font-bold text-slate-900">86%</p><div class="mt-3 h-2 rounded-full bg-slate-100"><div class="h-2 w-[86%] rounded-full bg-emerald-500"></div></div></div><div class="rounded-2xl border border-slate-200 p-5"><p class="text-sm text-slate-500">Skor rata-rata</p><p class="mt-2 text-3xl font-bold text-slate-900">8,4</p><p class="mt-2 text-sm font-semibold text-emerald-600">↑ 12% dari bulan lalu</p></div></div></div>`,
      challenge: `<div class="mx-auto max-w-3xl"><div class="flex items-center justify-between"><div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Daily Challenge · 03:42</p><h2 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">Customer Obsession</h2></div><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700">Pertanyaan 1/3</span></div><div class="mt-8 rounded-3xl bg-slate-50 p-6 sm:p-9"><p class="text-xs font-bold uppercase tracking-wider text-slate-400">Pertanyaan untuk Rian · Support</p><p class="mt-4 text-xl font-bold leading-relaxed text-slate-900 sm:text-2xl">Ceritakan satu momen minggu ini ketika Anda mengambil inisiatif ekstra untuk membantu customer.</p><div class="mt-7 rounded-2xl border border-slate-200 bg-white p-4 text-slate-400">Tulis jawaban Anda di sini…</div><div class="mt-5 flex flex-wrap items-center justify-between gap-3"><span class="text-xs text-slate-400">Jawaban idealnya 2–4 kalimat</span><button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white">Kirim jawaban</button></div></div></div>`,
      scoring: `<div><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Scoring session</p><h2 class="mt-2 text-2xl font-bold text-slate-900">Nilai jawaban tim</h2></div><span class="text-sm text-slate-500">3 jawaban menunggu review</span></div><div class="mt-7 grid gap-4 lg:grid-cols-[1fr_230px]"><div class="rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between"><span class="font-bold text-slate-900">Rian · Support</span><span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">Ownership</span></div><p class="mt-5 leading-relaxed text-slate-600">“Saat integrasi API customer bermasalah menjelang launch, saya membuat video walkthrough dan contoh konfigurasi agar tim mereka bisa menyelesaikan kendala malam itu.”</p><div class="mt-6 flex flex-wrap gap-2"><button class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600">Perlu konteks</button><button class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600">Beri feedback</button></div></div><div class="rounded-2xl bg-indigo-50 p-5"><p class="text-sm font-bold text-indigo-900">Skor Anda</p><div class="mt-3 flex items-end gap-2"><span class="text-5xl font-extrabold text-indigo-700">9</span><span class="mb-2 text-slate-500">/ 10</span></div><p class="mt-2 text-sm text-indigo-800">Sangat baik</p><button class="mt-5 w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-bold text-white">Simpan skor</button></div></div></div>`,
      leaderboard: `<div><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Leaderboard · Maret</p><h2 class="mt-2 text-2xl font-bold text-slate-900">Konsistensi yang terlihat</h2></div><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">12 peserta aktif</span></div><div class="mt-7 overflow-hidden rounded-2xl border border-slate-200"><div class="grid grid-cols-[48px_1fr_auto] gap-3 bg-slate-50 px-5 py-3 text-xs font-bold uppercase tracking-wider text-slate-400"><span>#</span><span>Member</span><span>Skor</span></div>${['Sari · Product|9,4|#4F46E5','Rian · Support|9,0|#10B981','Dimas · Operations|8,7|#F59E0B','Nadia · Design|8,5|#0EA5E9'].map((row, i) => { const [name, score, color] = row.split('|'); return `<div class="grid grid-cols-[48px_1fr_auto] items-center gap-3 border-t border-slate-100 px-5 py-4"><span class="font-bold text-slate-400">0${i + 1}</span><div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-full text-xs font-bold text-white" style="background:${color}">${name[0]}</span><span class="text-sm font-semibold text-slate-700">${name}</span></div><span class="font-bold text-slate-900">${score}</span></div>`; }).join('')}</div></div>`,
      insights: `<div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Team insights · 30 hari terakhir</p><h2 class="mt-2 text-2xl font-bold text-slate-900">Arah percakapan tim Anda</h2><div class="mt-7 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-emerald-50 p-5"><p class="text-sm text-emerald-700">Value terkuat</p><p class="mt-2 text-xl font-bold text-emerald-950">Ownership</p><p class="mt-2 text-sm text-emerald-700">Skor rata-rata 8,9</p></div><div class="rounded-2xl bg-amber-50 p-5"><p class="text-sm text-amber-700">Perlu perhatian</p><p class="mt-2 text-xl font-bold text-amber-950">Collaboration</p><p class="mt-2 text-sm text-amber-700">Partisipasi 64%</p></div><div class="rounded-2xl bg-indigo-50 p-5"><p class="text-sm text-indigo-700">Tren skor</p><p class="mt-2 text-xl font-bold text-indigo-950">+12%</p><p class="mt-2 text-sm text-indigo-700">dibanding periode lalu</p></div></div><div class="mt-5 rounded-2xl border border-slate-200 p-5"><div class="flex items-center justify-between"><span class="font-bold text-slate-800">Rata-rata skor mingguan</span><span class="text-xs text-slate-400">4 minggu</span></div><div class="mt-6 flex h-28 items-end justify-around gap-3"><div class="h-[48%] w-1/5 rounded-t-lg bg-indigo-200"></div><div class="h-[64%] w-1/5 rounded-t-lg bg-indigo-300"></div><div class="h-[72%] w-1/5 rounded-t-lg bg-indigo-400"></div><div class="h-[88%] w-1/5 rounded-t-lg bg-indigo-600"></div></div></div></div>`,
    };
    type PreviewId = keyof typeof previewData;
    const content = document.querySelector<HTMLElement>('#preview-content');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.preview-tab');
    function selectTab(id: PreviewId) { if (!content) return; content.innerHTML = previewData[id]; buttons.forEach((button) => { const active = button.dataset.tab === id; button.setAttribute('aria-selected', String(active)); button.className = `preview-tab rounded-xl px-4 py-2.5 text-sm font-semibold ${active ? 'bg-slate-900 text-white' : 'text-slate-500 hover:bg-slate-50'}`; }); }
    buttons.forEach((button) => button.addEventListener('click', () => selectTab((button.dataset.tab || 'dashboard') as PreviewId)));
    selectTab('dashboard');
  </script>
</BaseLayout>
