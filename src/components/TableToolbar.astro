---
interface Props {
  action?: string;
  searchName?: string;
  searchValue?: string;
  searchPlaceholder?: string;
  searchId?: string;
  submitLabel?: string | null;
  compact?: boolean;
}

const {
  action = '',
  searchName = 'query',
  searchValue = '',
  searchPlaceholder = 'Cari...',
  searchId,
  submitLabel = 'Terapkan',
  compact = false,
} = Astro.props;
---

<form method="get" action={action || undefined} class={compact ? 'relative' : 'flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:flex-row md:items-end'}>
  <label class="min-w-0 flex-1">
    <span class="sr-only">{searchPlaceholder}</span>
    <span class="relative block">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
      <input id={searchId} type="search" name={searchName} value={searchValue} placeholder={searchPlaceholder} class={compact ? 'w-64 rounded-xl border border-slate-300 bg-white py-2 pl-10 pr-4 text-sm outline-none shadow-sm transition-shadow focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500' : 'w-full rounded-xl border border-slate-300 bg-white py-2.5 pl-9 pr-3 text-sm outline-none transition-shadow focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100'} />
    </span>
  </label>
  <div class={compact ? 'hidden' : 'flex flex-wrap items-center gap-2'}>
    <slot name="filters" />
    {submitLabel && <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800">{submitLabel}</button>}
  </div>
</form>
