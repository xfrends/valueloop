---
type Props = {
  variant?: 'light' | 'wall';
};

const { variant = 'light' } = Astro.props;
const isLoggedIn = !!Astro.locals.user;
const navItems = [
  { label: 'Cara Kerja', href: '/#how-it-works' },
  { label: 'Fitur', href: '/fitur' },
  { label: 'Preview', href: '/preview' },
  { label: 'Blog', href: '/blog' },
];
---
<header class="site-header" data-tone={variant === 'wall' ? 'wall' : 'light'}>
  <div class="mx-auto grid w-full max-w-[1440px] grid-cols-[1fr_auto] items-center px-6 py-3 md:grid-cols-[1fr_auto_1fr]">
    <a class="flex items-center gap-2 transition-opacity hover:opacity-70" href="/">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
        <path d="M7.5 8.5 12 16l4.5-7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="text-lg font-medium tracking-tight">ValueLoop</span>
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium md:flex">
      {navItems.map((item) => (
        <a class="transition-opacity duration-300 hover:opacity-70" href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center justify-end gap-2">
      {isLoggedIn ? (
        <a class="hdr-btn hdr-btn-solid btn-interactive" href="/dashboard">Dashboard</a>
      ) : (
        <>
          <a class="hdr-btn hdr-btn-ghost btn-interactive hidden sm:inline-flex" href="/login">Masuk</a>
          <a class="hdr-btn hdr-btn-solid btn-interactive" href="/signup">Coba Sekarang</a>
        </>
      )}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header[data-tone="wall"]');
  if (header) {
    const sync = () => { header.dataset.scrolled = String(window.scrollY > 40); };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
