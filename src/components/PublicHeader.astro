---
const isLoggedIn = !!Astro.locals.user;
---
<header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-6 relative z-10">
  <a class="flex items-center gap-2 group" href="/">
    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-emerald-500/20 transition-transform group-hover:scale-105">
      V
    </div>
    <span class="text-xl font-bold tracking-tight text-slate-900">ValueLoop</span>
  </a>
  <nav class="flex items-center gap-6 text-sm font-medium">
    <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="/#features">Fitur</a>
    <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="/#how-it-works">Cara Kerja</a>
    <a class="text-slate-600 hover:text-emerald-700 transition-colors" href="/blog">Blog</a>
    {isLoggedIn ? (
      <a class="rounded-full bg-emerald-600 px-5 py-2.5 text-white shadow-md shadow-emerald-600/10 hover:bg-emerald-700 hover:shadow-emerald-700/20 transition-all active:scale-95" href="/dashboard">
        Dashboard
      </a>
    ) : (
      <a class="rounded-full bg-slate-900 px-5 py-2.5 text-white shadow-md shadow-slate-900/10 hover:bg-emerald-700 hover:shadow-emerald-700/20 transition-all active:scale-95" href="/signup">
        Coba Sekarang
      </a>
    )}
  </nav>
</header>
