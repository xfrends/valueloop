---
const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Produk',
    links: [
      { label: 'Fitur', href: '/fitur' },
      { label: 'Preview', href: '/preview' },
      { label: 'Cara Kerja', href: '/#how-it-works' },
      { label: 'Masuk', href: '/login' },
      { label: 'Daftar', href: '/signup' },
    ],
  },
  {
    title: 'Sumber Daya',
    links: [
      { label: 'Blog & Artikel', href: '/blog' },
      { label: 'Panduan Budaya Kerja', href: '/panduan' },
      { label: 'Studi Kasus', href: '/studi-kasus' },
      { label: 'Bantuan', href: '/bantuan' },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Kebijakan Privasi', href: '/privacy' },
      { label: 'Syarat & Ketentuan', href: '/terms' },
    ],
  },
];
---
<footer class="grain relative overflow-hidden bg-[#0e0e0e] text-white">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_60%_at_20%_110%,#3a3a35_0%,transparent_60%),radial-gradient(ellipse_60%_50%_at_90%_100%,#2a2a28_0%,transparent_55%)]"></div>
  <div class="mx-auto max-w-7xl px-6 pt-20 pb-10">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <p class="max-w-xs text-2xl font-medium leading-tight tracking-tight sm:text-3xl">
          Core values yang hidup setiap hari.
        </p>
        <a href="/signup" class="btn-interactive mt-6 inline-flex h-11 items-center rounded-full bg-white px-6 text-sm font-medium text-black transition-colors hover:bg-white/90">
          Mulai gratis
        </a>
      </div>
      {columns.map((column) => (
        <div>
          <h3 class="mb-4 text-sm font-medium text-white/50">{column.title}</h3>
          <ul class="space-y-3">
            {column.links.map((link) => (
              <li><a href={link.href} class="text-sm font-medium text-white transition-colors hover:text-white/70">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p aria-hidden="true" class="mt-20 select-none text-[22vw] font-medium leading-[0.8] tracking-[-0.06em] text-white/[0.06] md:text-[15rem]">
      ValueLoop
    </p>

    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-6 text-sm text-white/50 md:flex-row md:items-center">
      <p>&copy; {currentYear} ValueLoop. Hak cipta dilindungi undang-undang.</p>
      <p>Dibuat untuk tim yang serius soal budaya kerja.</p>
    </div>
  </div>
</footer>
