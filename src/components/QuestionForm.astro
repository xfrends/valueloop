---
type Props = {
  action: string;
  coreValueId: string;
  questionText?: string;
  difficulty?: 'easy' | 'medium' | 'hard';
  suggestedRubricNote?: string;
  isActive?: number;
  submitLabel?: string;
  fieldErrors?: Record<string, string>;
};

const {
  action,
  coreValueId,
  questionText = '',
  difficulty = 'easy',
  suggestedRubricNote = '',
  isActive = 1,
  submitLabel = 'Save Question',
  fieldErrors = {},
} = Astro.props;
const inputClass = (field: string) =>
  `w-full rounded-xl border px-4 py-2.5 outline-none focus:ring-1 ${fieldErrors[field] ? 'border-red-300 focus:border-red-500 focus:ring-red-500' : 'border-slate-300 focus:border-indigo-500 focus:ring-indigo-500'}`;
---

<form method="post" action={action} class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <input type="hidden" name="coreValueId" value={coreValueId} />
  <div class="space-y-6 p-6 md:p-8">
    <div class="space-y-2">
      <label for="questionText" class="block text-sm font-bold text-slate-900">Question <span class="text-red-500">*</span></label>
      <textarea id="questionText" name="questionText" rows="5" class={inputClass('questionText')} aria-invalid={fieldErrors.questionText ? 'true' : 'false'} placeholder="Contoh: Ceritakan situasi ketika Anda menerapkan core value ini." required>{questionText}</textarea>
      {fieldErrors.questionText && <p class="text-sm text-red-600">{fieldErrors.questionText}</p>}
      <p class="text-xs text-slate-500">Gunakan pertanyaan terbuka yang meminta contoh perilaku atau situasi nyata.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="space-y-2">
        <label for="difficulty" class="block text-sm font-bold text-slate-900">Difficulty</label>
        <select id="difficulty" name="difficulty" class={inputClass('difficulty')}>
          <option value="easy" selected={difficulty === 'easy'}>Easy</option>
          <option value="medium" selected={difficulty === 'medium'}>Medium</option>
          <option value="hard" selected={difficulty === 'hard'}>Hard</option>
        </select>
        {fieldErrors.difficulty && <p class="text-sm text-red-600">{fieldErrors.difficulty}</p>}
      </div>
      <div class="space-y-2">
        <label for="isActive" class="block text-sm font-bold text-slate-900">Status</label>
        <select id="isActive" name="isActive" class={inputClass('isActive')}>
          <option value="1" selected={isActive === 1}>Active</option>
          <option value="0" selected={isActive === 0}>Inactive</option>
        </select>
        {fieldErrors.isActive && <p class="text-sm text-red-600">{fieldErrors.isActive}</p>}
      </div>
    </div>

    <div class="space-y-2">
      <label for="suggestedRubricNote" class="block text-sm font-bold text-slate-900">Suggested Rubric / Note</label>
      <textarea id="suggestedRubricNote" name="suggestedRubricNote" rows="4" class={inputClass('suggestedRubricNote')} placeholder="Panduan singkat bagi fasilitator ketika menilai jawaban.">{suggestedRubricNote}</textarea>
      {fieldErrors.suggestedRubricNote && <p class="text-sm text-red-600">{fieldErrors.suggestedRubricNote}</p>}
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-slate-200 bg-slate-50 p-6 sm:flex-row sm:justify-end">
    <a href={`/settings/values/${coreValueId}/questions`} class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
    <button type="submit" class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800">{submitLabel}</button>
  </div>
</form>
