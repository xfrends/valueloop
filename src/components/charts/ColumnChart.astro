---
// Vertical column chart; several series stack bottom-up with a 2px surface gap between segments.
type Series = { name: string; color: string; values: number[] };

type Props = {
  labels: string[];
  series: Series[];
  tips: string[];
  height?: string;
  thinLabels?: boolean;
};

const { labels, series, tips, height = 'h-48', thinLabels = false } = Astro.props;

function niceCeil(value: number): number {
  if (value <= 0) return 4;
  const power = 10 ** Math.floor(Math.log10(value));
  const step = [1, 2, 4, 5, 10].map((m) => m * power).find((candidate) => candidate >= value) ?? value;
  return Math.max(step, 4);
}

const totals = labels.map((_, index) => series.reduce((sum, item) => sum + (item.values[index] ?? 0), 0));
const yMax = niceCeil(Math.max(0, ...totals));
const ticks = [yMax, yMax / 2, 0];
---
<div>
  {series.length > 1 && (
    <div class="mb-4 flex flex-wrap gap-4 text-xs text-slate-600">
      {series.map((item) => (
        <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm" style={`background:${item.color}`}></span>{item.name}</span>
      ))}
    </div>
  )}
  <div class="flex gap-2">
    <div class={`relative w-6 shrink-0 ${height}`}>
      {ticks.map((tick, index) => (
        <span class="absolute right-0 -translate-y-1/2 text-[10px] tabular-nums text-slate-400" style={`top:${index * 50}%`}>{Number.isInteger(tick) ? tick : tick.toFixed(1)}</span>
      ))}
    </div>
    <div class="min-w-0 flex-1">
      <div class={`relative ${height}`}>
        {ticks.map((_, index) => (
          <div class={`absolute inset-x-0 border-t ${index === 2 ? 'border-slate-300' : 'border-slate-100'}`} style={`top:${index * 50}%`}></div>
        ))}
        <div class="absolute inset-0 flex items-stretch gap-1 sm:gap-1.5">
          {labels.map((_, index) => {
            const parts = series.map((item) => ({ color: item.color, value: item.values[index] ?? 0 })).filter((part) => part.value > 0);
            return (
              <div tabindex="0" data-tip={tips[index]} class="flex h-full flex-1 flex-col-reverse gap-[2px] rounded-t-md outline-none hover:bg-slate-50 focus-visible:ring-2 focus-visible:ring-indigo-500">
                {parts.map((part, partIndex) => (
                  <div
                    class={partIndex === parts.length - 1 ? 'rounded-t-[4px]' : ''}
                    style={`height:${(part.value / yMax) * 100}%;background:${part.color}`}
                  ></div>
                ))}
              </div>
            );
          })}
        </div>
      </div>
      <div class="mt-2 flex gap-1 sm:gap-1.5">
        {labels.map((label, index) => (
          <span class={`min-w-0 flex-1 overflow-visible whitespace-nowrap text-center text-[10px] text-slate-500 ${thinLabels && index % 2 === 1 ? 'invisible' : ''}`}>{label}</span>
        ))}
      </div>
    </div>
  </div>
</div>
