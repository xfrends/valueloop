---
import '../styles/global.css';
import Seo from '../components/Seo.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string | null;
  modifiedTime?: string | null;
  jsonLd?: Record<string, unknown>[];
};

const {
  title = 'ValueLoop',
  description = 'Ubah core value perusahaan menjadi kebiasaan tim setiap hari lewat challenge harian, scoring, leaderboard, dan insight.',
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Seo title={title} description={description} {...seo} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-paper text-slate-900 font-sans antialiased overflow-x-hidden selection:bg-indigo-100 selection:text-indigo-900">
    <slot />
  </body>
</html>
