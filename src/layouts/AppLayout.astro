---
import '../styles/global.css';
import { getCloudflareRuntime } from '../lib/cloudflare/bindings';
import { getOrganizationSettings } from '../lib/services/shared';

type Props = {
  title?: string;
  description?: string;
  currentPath?: string;
};

const {
  title = 'ValueLoop Dashboard',
  description = 'Manage and activate your core values.',
  currentPath = '/dashboard',
} = Astro.props;

const user = Astro.locals.user;
const organization = Astro.locals.organization;
const runtime = getCloudflareRuntime(Astro);
const settings = organization && runtime?.env?.DB ? await getOrganizationSettings(runtime.env.DB, organization.id) : null;

const menuItems = [
  { name: 'Dashboard', path: '/dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { name: 'Daily Challenge', path: '/challenge', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { name: 'Leaderboard', path: '/leaderboard', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { name: 'History', path: '/history', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Insights', path: '/insights', icon: 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055zM20.488 9H15V3.512A9.025 9.025 0 0120.488 9z' },
  { name: 'Members', path: '/settings/members', icon: 'M17 20h5v-2a4 4 0 00-5-3.87M9 20H2v-2a4 4 0 014-4h3m0-4a4 4 0 100-8 4 4 0 000 8zm8 4a4 4 0 100-8 4 4 0 000 8z' },
  { name: 'Teams', path: '/settings/teams', icon: 'M4 6h16M4 12h16M4 18h7' },
  { name: 'Core Values', path: '/settings/values', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { name: 'Questions', path: '/settings/questions', icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Settings', path: '/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z' },
  { name: 'Plan', path: '/billing', icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z' },
  { name: 'Audit Log', path: '/settings/audit', icon: 'M9 12h6m-6 4h6M10 2h4l6 6v14a2 2 0 01-2 2H6a2 2 0 01-2-2V4a2 2 0 012-2z' },
];

const platformItems = user?.platform_role === 'platform_admin'
  ? [
      { name: 'Platform Orgs', path: '/platform/organizations', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
      { name: 'Platform Plans', path: '/platform/plans', icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
      { name: 'Articles', path: '/platform/articles', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v8a2 2 0 01-2 2zM14 4v6h6M8 13h8M8 17h6' },
    ]
  : [];

const isActivePath = (path: string) => currentPath === path || (path !== '/settings' && currentPath.startsWith(path + '/'));
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 flex antialiased">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col fixed inset-y-0 z-10 transition-transform">
      <div class="h-16 flex items-center px-6 border-b border-slate-200">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white font-bold text-lg shadow-sm">
            V
          </div>
          <span class="font-bold text-lg tracking-tight text-slate-900">ValueLoop</span>
        </a>
      </div>

      <div class="flex-1 overflow-y-auto py-6 px-4 flex flex-col gap-1">
        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 px-2">Menu</div>
        {menuItems.map((item) => {
          const isActive = isActivePath(item.path);
          return (
            <a 
              href={item.path}
              class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                isActive 
                  ? 'bg-emerald-50 text-emerald-700' 
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class={`w-5 h-5 ${isActive ? 'text-emerald-600' : 'text-slate-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
              </svg>
              {item.name}
            </a>
          )
        })}
        {platformItems.length > 0 && (
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-6 mb-2 px-2">Platform</div>
        )}
        {platformItems.map((item) => {
          const isActive = isActivePath(item.path);
          return (
            <a
              href={item.path}
              class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'
              }`}
            >
              <svg class={`w-5 h-5 ${isActive ? 'text-emerald-600' : 'text-slate-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
              </svg>
              {item.name}
            </a>
          )
        })}
      </div>

      <div class="p-4 border-t border-slate-200">
        <div class="flex items-center gap-3 px-2 py-2">
          <div class="w-9 h-9 rounded-full bg-slate-200 flex flex-shrink-0 items-center justify-center text-slate-600 font-medium">
            {(user?.full_name || 'U').slice(0, 2).toUpperCase()}
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-sm font-medium text-slate-900 truncate">{user?.full_name ?? 'Pengguna'}</span>
            <span class="text-xs text-slate-500 truncate">{user?.email ?? '-'}</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 flex flex-col min-h-screen">
      <!-- Top Header -->
      <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200 sticky top-0 z-20 flex items-center justify-between px-8">
        <div class="flex items-center gap-4">
          <!-- Org Switcher Mock -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-md border border-slate-200 bg-white shadow-sm cursor-pointer hover:border-emerald-300 transition-colors">
            <div class="w-5 h-5 rounded bg-blue-600 flex items-center justify-center text-[10px] font-bold text-white">
              {(organization?.name || 'O').slice(0, 1).toUpperCase()}
            </div>
            <span class="text-sm font-medium text-slate-700">{organization?.name ?? 'Belum ada organisasi'}</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-medium border border-emerald-200">
            {settings ? 'Plan Aktif' : 'Plan Default'}
          </span>
        </div>
        
        <div class="flex items-center gap-4">
          <button class="p-2 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-red-500 border-2 border-white"></span>
          </button>
        </div>
      </header>

      <!-- Page Content -->
      <div class="flex-1 p-8">
        <div class="max-w-5xl mx-auto">
          <slot />
        </div>
      </div>
    </main>
    
  </body>
</html>
